#!/usr/bin/env python3
"""Record local speech, transcribe it locally, and paste into an RTIDE pane."""
import os
import importlib.util
import select
import shutil
import subprocess
import sys
import tempfile
import termios
import tty


def fail(message):
    print(f"dictation: {message}", file=sys.stderr)
    raise SystemExit(1)


def wait_for_stop():
    """Return submit, insert, or cancel for the recording completion key."""
    if not sys.stdin.isatty():
        input()
        return "submit"
    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)
    sequence = b""
    try:
        tty.setraw(fd)
        while True:
            key = os.read(fd, 1)
            if not key:
                return "submit"
            if key == b"\x03":
                return "cancel"
            sequence += key
            if sequence in (b"\r", b"\n"):
                return "submit"
            if sequence == b"\x1b":
                ready, _, _ = select.select([fd], [], [], 0.08)
                if not ready:
                    return "cancel"
                continue
            if sequence.startswith(b"\x1b[") and sequence[-1:] in (b"u", b"~"):
                # tmux extended-keys-format=csi-u reports Shift+Enter as
                # CSI 13;2u (some terminals use CSI 27;2;13~).
                if sequence in (b"\x1b[13;2u", b"\x1b[27;2;13~"):
                    return "insert"
                if sequence == b"\x1b[13u":
                    return "submit"
                sequence = b""
                continue
            if len(sequence) > 24 or not b"\x1b[".startswith(sequence):
                sequence = b""
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, previous)


pane = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("TMUX_PANE", "")
if not pane:
    fail("no target prompt pane")
# The shortcut works from every RTIDE pane, but speech always belongs in the
# session's prompt pane.
role = subprocess.run(["tmux", "display-message", "-p", "-t", pane,
                       "#{@rtide-role}"], capture_output=True, text=True)
if role.stdout.strip() != "agent":
    session = subprocess.run(["tmux", "display-message", "-p", "-t", pane,
                              "#{session_name}"], capture_output=True, text=True)
    panes = subprocess.run(["tmux", "list-panes", "-t", session.stdout.strip(),
                            "-F", "#{pane_id} #{@rtide-role}"],
                           capture_output=True, text=True)
    pane = next((line.split()[0] for line in panes.stdout.splitlines()
                 if line.split()[1:] == ["agent"]), "")
    if not pane:
        fail("this session has no RTIDE prompt pane")

# Keep speech dependencies isolated from the system Python. The first shortcut
# use prepares this environment before recording, so captured audio is never
# discarded by a setup/re-exec cycle.
if importlib.util.find_spec("faster_whisper") is None:
    env_dir = os.path.expanduser("~/.rtide/speech-env")
    env_python = os.path.join(env_dir, "bin", "python")
    # A venv's interpreter is normally a symlink to the system Python, so
    # realpath() makes both executables look identical. Compare their invoked
    # paths instead or the bootstrap falsely assumes it is already in the venv.
    if os.path.abspath(sys.executable) != os.path.abspath(env_python):
        print("◌ Preparing speech engine…")
        if not os.path.exists(env_python):
            subprocess.run([sys.executable, "-m", "venv", env_dir], check=True)
        subprocess.run([env_python, "-m", "pip", "install", "-q",
                        "faster-whisper"], check=True)
        os.execv(env_python, [env_python, os.path.realpath(__file__), pane])
    fail("could not load the local speech engine")
recorder = shutil.which("pw-record") or shutil.which("arecord")
if not recorder:
    fail("pw-record or arecord is required")

with tempfile.TemporaryDirectory(prefix="rtide-dictate-") as tmp:
    audio = os.path.join(tmp, "speech.wav")
    if os.path.basename(recorder) == "pw-record":
        cmd = [recorder, "--rate", "16000", "--channels", "1", audio]
    else:
        cmd = [recorder, "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", audio]
    print("● Listening · Enter sends · Shift+Enter inserts · Esc cancels")
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                            start_new_session=True)
    try:
        action = wait_for_stop()
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
    if action == "cancel":
        print("○ Dictation discarded")
        raise SystemExit(0)
    if not os.path.exists(audio) or os.path.getsize(audio) < 1024:
        detail = (proc.stderr.read().decode(errors="replace").strip()
                  if proc.stderr else "")
        fail(detail or "no microphone audio was captured")

    print("◌ Transcribing locally…")
    from faster_whisper import WhisperModel
    model = WhisperModel(os.environ.get("RTIDE_WHISPER_MODEL", "base.en"),
                         device="cpu", compute_type="int8")
    segments, _ = model.transcribe(audio, beam_size=5, vad_filter=True)
    text = " ".join(segment.text.strip() for segment in segments).strip()
    if not text:
        fail("no speech recognized")
    subprocess.run(["tmux", "set-buffer", "--", text], check=True)
    subprocess.run(["tmux", "paste-buffer", "-t", pane], check=True)
    subprocess.run(["tmux", "send-keys", "-t", pane, "End"], check=True)
    if action == "submit":
        subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
    subprocess.run(["tmux", "select-pane", "-t", pane], check=True)
    result = "submitted" if action == "submit" else "inserted"
    print(f"✓ {result} {len(text.split())} words")
