#!/usr/bin/env python3
"""One canonical dependency matrix for RTIDE installation and diagnostics.

Every requirement RTIDE knows about is defined once here with its level,
category, accepted commands, host packages per supported manager, and an
actionable remediation. Installation and `rtide doctor` both consume this data
so they cannot disagree about what is required, optional, or unsupported.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


