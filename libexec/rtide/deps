PACKAGE_MANAGERS = ("apt-get", "dnf", "brew", "pacman", "zypper")


def _lazyvim_ready() -> bool:
    config = Path(os.environ.get("RTIDE_NVIM_CONFIG_DIR", Path.home() / ".config" / "nvim"))
    if not (config / "lua" / "config" / "lazy.lua").is_file():
        return False
    for path in config.rglob("*.lua"):
        try:
            if "LazyVim/LazyVim" in path.read_text(encoding="utf-8", errors="ignore"):
                return True
        except OSError:
            continue
    return False


def _speech_ready() -> bool:
    python = Path.home() / ".rtide" / "speech-env" / "bin" / "python"
    if not python.is_file() or not os.access(python, os.X_OK):
        return False
    result = subprocess.run([str(python), "-c", "import faster_whisper"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def _pkgconfig_ready(capabilities) -> bool:
    if not shutil.which("pkg-config"):
        return False
    return all(subprocess.run(["pkg-config", "--exists", item],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
               for item in capabilities)


def _version_ok(spec) -> bool:
    import re
    result = subprocess.run(spec["command"], capture_output=True, text=True)
    return bool(re.search(spec["pattern"], result.stdout + result.stderr))


def evaluate(requirement: dict) -> dict:
    """Return the observed state for one requirement."""
    kind = requirement.get("kind", "command")
    present = False
    detail = ""
    if kind == "command":
        found = next((c for c in requirement["commands"] if shutil.which(c)), "")
        present = bool(found)
        detail = found
        if present and "version" in requirement:
            present = _version_ok(requirement["version"])
            detail = f"{found} ({'ok' if present else 'too old'})"
    elif kind == "pkgconfig":
        present = _pkgconfig_ready(requirement["pkgconfig"])
        detail = "pkg-config capabilities present" if present else "development libraries missing"
    elif kind == "lazyvim":
        present = _lazyvim_ready()
        detail = "LazyVim" if present else "no LazyVim config"
    elif kind == "speech":
        present = _speech_ready()
        detail = "faster-whisper ready" if present else "speech engine missing"
    return {**{k: requirement[k] for k in ("name", "level", "category")},
            "present": present, "detail": detail,
            "remedy": "" if present else requirement.get("remedy", ""),
            "provisioned": requirement.get("provisioned", "")}


def report() -> list[dict]:
    return [evaluate(r) for r in REQUIREMENTS]


def missing_for_install() -> list[str]:
    """Requirement names that installation can provision from host packages."""
    result = []
    for item in report():
        if item["present"] or item["level"] not in ("required", "build"):
            continue
        requirement = next(r for r in REQUIREMENTS if r["name"] == item["name"])
        if "packages" in requirement:
            result.append(item["name"])
    return result


def missing_packages(manager: str) -> list[str]:
    packages: list[str] = []
    for item in report():
        if item["present"]:
            continue
        requirement = next(r for r in REQUIREMENTS if r["name"] == item["name"])
        packages.extend(requirement.get("packages", {}).get(manager, []))
    # de-duplicate while preserving order
    seen: set[str] = set()
    return [p for p in packages if not (p in seen or seen.add(p))]


def detect_manager() -> str:
    for candidate in PACKAGE_MANAGERS:
        if shutil.which(candidate):
            return candidate
    return ""


def main() -> int:
    parser = argparse.ArgumentParser(prog="rtide deps")
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check")
    check.add_argument("--json", action="store_true")
    check.add_argument("--level", choices=("required", "build", "optional"))
    sub.add_parser("missing-for-install")
    packages = sub.add_parser("missing-packages")
    packages.add_argument("manager", nargs="?", default="")
    sub.add_parser("manager")
    args = parser.parse_args()

    if args.command == "check":
        items = report()
        if args.level:
            items = [i for i in items if i["level"] == args.level]
        if args.json:
            print(json.dumps(items, indent=2))
        else:
            for item in items:
                mark = "ok" if item["present"] else ("MISSING" if item["level"] != "optional" else "warn")
                line = f"{mark}\t{item['level']}\t{item['category']}\t{item['name']}"
                if item["detail"]:
                    line += f"\t{item['detail']}"
                print(line)
        return 0
    if args.command == "missing-for-install":
        print("\n".join(missing_for_install()))
        return 0
    if args.command == "missing-packages":
        manager = args.manager or detect_manager()
        if not manager:
            print("no supported package manager found", file=sys.stderr)
            return 1
        print("\n".join(missing_packages(manager)))
        return 0
    if args.command == "manager":
        print(detect_manager())
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
