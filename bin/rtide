#!/usr/bin/env bash
# rtide — Rich Terminal IDE workspace launcher.
#   rtide            → pick an active workspace to resume, or start a new one
#   rtide <dir>      → launch/attach the workspace for <dir>
#   rtide new        → guided new workspace
#   rtide switch     → same picker as bare rtide (resume / new)
#   rtide ls         → list workspaces
#   rtide sweep      → capture pending MEM: memories from every live session
#   rtide quit [dir] → sweep that session's memories, then kill it (from inside or out)
#   rtide kill [dir] → alias for quit
#   rtide agent      → re-pick provider/harness/model for the current workspace
#   rtide config     → view/edit/reset the global config (set key=value, reset [layout|agent|all])
#   rtide refresh    → apply the global config's layout to a running workspace (prefix+R)
#   rtide nvim       → hide/show the editor pane while keeping tweb + prompt visible
#   rtide layout-reset → restore the default 40/60 panes and three-line prompt
#   rtide menu       → quick-switcher menu (prefix+A)
#   rtide history    → open the current workspace's output history
#   rtide slash-menu → contextual slash-command picker for the prompt pane
#   rtide pdf        → export the current output/artifact to PDF
#   rtide fork       → branch into an isolated worktree in a new tmux window
#   rtide auth       → check auth for the configured provider
#   rtide matrix     → print the provider×harness compatibility matrix
#   rtide setup      → re-run the wizard
#   rtide doctor     → verify deps
#   rtide --no-ask   → skip the provider/harness prompt (use stored config)
set -euo pipefail

SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0")
RTIDE_ROOT="${RTIDE_ROOT:-$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)}"
RTIDE_BIN_DIR="$RTIDE_ROOT/bin"
RTIDE_LIBEXEC_DIR="$RTIDE_ROOT/libexec/rtide"
RTIDE_SHARE_DIR="$RTIDE_ROOT/share"
export RTIDE_ROOT RTIDE_BIN_DIR RTIDE_LIBEXEC_DIR RTIDE_SHARE_DIR
source "$RTIDE_LIBEXEC_DIR/picker.sh"
source "$RTIDE_LIBEXEC_DIR/ui.sh"
source "$RTIDE_LIBEXEC_DIR/tweb-common.sh"
source "$RTIDE_LIBEXEC_DIR/runtime-paths.sh"
PROVIDER_BIN="$RTIDE_LIBEXEC_DIR/provider"
SETTINGS_BIN="$RTIDE_LIBEXEC_DIR/settings"
DEPS_BIN="$RTIDE_LIBEXEC_DIR/deps"
TWEB_DIR="$RTIDE_ROOT/share"
RTIDE_MARK="$TWEB_DIR/assets/rtide-mark.png"
[[ -f "$RTIDE_MARK" ]] || RTIDE_MARK="$RTIDE_ROOT/docs/assets/rtide-mark.png"
CONFIG_DIR="${RTIDE_CONFIG_DIR:-$HOME/.rtide}"
CONFIG="$CONFIG_DIR/config"
WS_AGENT_FILE=".rtide/agent"   # per-workspace override, relative to the workspace dir
SESSION_PREFIX="${RTIDE_SESSION_PREFIX:-rtide-}"
DEV_MODE="${RTIDE_DEV_MODE:-0}"
DEV_LABEL="${RTIDE_DEV_LABEL:-DEVELOPMENT}"

# Config files are data, not shell programs. Unknown keys remain available for
# future versions but are never evaluated by the current process.
load_config_file() {
  local file="$1" line key value
  [[ -r "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
    key=${line%%=*}; value=${line#*=}
    case "$key" in
      provider|harness|agent|model|permission_policy|default_dir|agent_lines|tweb_pct|nvim_pct|shell|auto_float|worktree_root)
        printf -v "$key" '%s' "$value" ;;
    esac
  done < "$file"
}

# `RTIDE_CONFIG_DIR` is the authoritative override used by development and
# isolated tests. Keep the global config path stable when invoking the source
# entry point directly; development still opts into its separate directory.
printf -v RTIDE_CMD '%q' "$SCRIPT_PATH"
printf -v RTIDE_AGENT_CMD '%q' "$RTIDE_LIBEXEC_DIR/agent"
RTIDE_REVIEW_LUA="$RTIDE_SHARE_DIR/rtide-review.lua"

# Build the shell command that starts the editor pane.
#
# Review-first (issue 001): a fresh workspace opens a project review view with
# no real file buffer, by sourcing the RTIDE review module once Snacks is
# loaded. Explicit file arguments are honored directly, and they take
# precedence over the review view.
rtide_nvim_command() {
  local dir="$1" shell="$2" file="${3:-}"
  local socket
  # Control sockets belong under the runtime root: a workspace may live on a
  # filesystem that cannot host a Unix domain socket (exFAT/FAT32/network).
  socket=$(rtide_resolve_nvim_socket "$dir") || socket="$dir/.rtide/nvim.sock"
  rtide_write_nvim_pointer "$dir" "$socket"
  local cmd="SHELL=$shell nvim --listen '$socket'"
  if [[ -n "$file" ]]; then
    printf '%s %q\n' "$cmd" "$file"
    return 0
  fi
  # A resumed workspace keeps its editor session; review-first only governs a
  # fresh editor. RTIDE_REVIEW_FIRST=0 restores plain editor startup.
  if [[ "${RTIDE_REVIEW_FIRST:-1}" == 1 && -r "$RTIDE_REVIEW_LUA" ]]; then
    # -c runs after startup files, so Snacks and LazyVim are registered.
    printf '%s -c %q\n' "$cmd" \
      "lua pcall(function() local m=dofile('$RTIDE_REVIEW_LUA') m.setup(vim.fn.getcwd()) end)"
    return 0
  fi
  printf '%s\n' "$cmd"
}
printf -v RTIDE_MEM_CMD '%q' "$RTIDE_LIBEXEC_DIR/memory"
printf -v RTIDE_FORKS_CMD '%q' "$RTIDE_LIBEXEC_DIR/forks"
printf -v RTIDE_STATUS_CMD '%q' "$RTIDE_LIBEXEC_DIR/workspace-status"

cmd_version() {
  local verbose="${1:-}" version revision digest
  version=$(tr -d '[:space:]' < "$RTIDE_ROOT/VERSION" 2>/dev/null || printf 'unknown')
  printf 'rtide %s\n' "$version"
  [[ "$verbose" == --verbose ]] || return 0
  revision=$(sed -n 's/^source_revision=//p' "$RTIDE_ROOT/BUILD-INFO" 2>/dev/null | head -1)
  if [[ -z "$revision" ]] && git -C "$RTIDE_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    revision=$(git -C "$RTIDE_ROOT" rev-parse --short HEAD 2>/dev/null || true)
  fi
  digest=$(sha256sum "$RTIDE_ROOT/MANIFEST.sha256" 2>/dev/null | awk '{print $1}' || true)
  printf 'root: %s\n' "$RTIDE_ROOT"
  [[ -z "$revision" ]] || printf 'source: %s\n' "$revision"
  [[ -z "$digest" ]] || printf 'digest: %s\n' "$digest"
}

cmd_help() {
  cat <<'EOF'
Usage: rtide [command] [arguments]

Workspace:  new, switch, ls, quit, fork, zoom, agent, config, settings, refresh
Utilities:  open, progress, memory, mcp, render, run, uninstall
System:     setup, doctor, auth, matrix, versions, use, version

Run `rtide <command> --help` for command-specific help.
EOF
}

run_helper() {
  local helper="${1:?missing private helper}"
  shift
  exec "$RTIDE_LIBEXEC_DIR/$helper" "$@"
}

if [[ "${1:-}" == "--no-ask" ]]; then RTIDE_ASK=0; shift; fi

# --- provider/harness selection -------------------------------------------

installed_harnesses() {
  local out=()
  for a in claude codex hermes opencode; do
    command -v "$a" >/dev/null 2>&1 && out+=("$a")
  done
  echo "${out[*]}"
}

# providers that have at least one installed compatible harness
providers_for_installed() {
  local installed out
  installed=$(installed_harnesses)
  out=()
  for p in anthropic openai ollama; do
    for h in $("$PROVIDER_BIN" compat "$p"); do
      [[ " $installed " == *" $h "* ]] && { out+=("$p"); break; }
    done
  done
  echo "${out[*]}"
}

# pick <prompt> <default> <choices...> is selection-only. pick_freeform keeps
# unmatched input for fields such as model names.
RTIDE_CANCELLED=0

# Decode fzf --print-query output using RTIDE's searchable-create contract:
# selected existing row wins; otherwise a non-empty query is a create name;
# empty query with the explicit create row requests automatic naming.
cancellable_input() {
  local prompt="$1" def="${2:-}" result
  RTIDE_CANCELLED=0
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    rtide_picker_options freeform compact
    result=$(printf '\n' | fzf "${RTIDE_PICKER_ARGS[@]}" --print-query --query='' \
      --no-info --prompt="$prompt › " \
      --bind='enter:accept-or-print-query' \
      --header="Enter = accept${def:+ · default: $def}   Esc = cancel") \
      || { RTIDE_CANCELLED=1; return 130; }
    result=$(printf '%s\n' "$result" | head -1)
    printf '%s\n' "${result:-$def}"
    return 0
  fi
  read -rp "$prompt${def:+ [$def]}: " result \
    || { RTIDE_CANCELLED=1; return 130; }
  [[ "$result" == $'\e' ]] && { RTIDE_CANCELLED=1; return 130; }
  printf '%s\n' "${result:-$def}"
}

pick_with_policy() {
  local policy="$1" prompt="$2" def="$3"; shift 3
  local choices=("$@")
  if [[ ${#choices[@]} -eq 0 ]]; then
    cancellable_input "$prompt" "$def"
    return $?
  fi
  if [[ ${#choices[@]} -eq 1 && "$policy" == select ]]; then
    echo "${choices[0]}"
    return
  fi
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    local out decision mode value
    local items=("${choices[@]}")
    # put the default first so it's highlighted — Enter accepts it, typing filters normally
    if printf '%s\n' "${choices[@]}" | grep -Fxq "$def"; then
      items=("$def")
      for c in "${choices[@]}"; do [[ "$c" != "$def" ]] && items+=("$c"); done
    fi
    rtide_picker_options "$policy" compact
    local -a bindings=()
    [[ "$policy" == freeform ]] && bindings=(--bind='enter:accept-or-print-query')
    out=$(printf '%s\n' "${items[@]}" | fzf "${RTIDE_PICKER_ARGS[@]}" \
      --prompt="$prompt › " --print-query "${bindings[@]}") \
      || { RTIDE_CANCELLED=1; return 130; }
    decision=$(rtide_picker_decode "$out" "$policy")
    mode=${decision%%$'\t'*}; value=${decision#*$'\t'}
    [[ "$mode" == open || "$mode" == value ]] \
      || { RTIDE_CANCELLED=1; return 130; }
    printf '%s\n' "${value%%$'\t'*}"
    return
  fi
  # fallback: numbered list, type number/name/Enter
  local i=0
  for c in "${choices[@]}"; do
    i=$((i+1))
    echo "  $i) $c" >&2
  done
  local ans
  read -rp "$prompt [$def]: " ans
  ans="${ans:-$def}"
  if [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#choices[@]} )); then
    ans="${choices[$((ans-1))]}"
  fi
  echo "$ans"
}

pick() { pick_with_policy select "$@"; }
pick_freeform() { pick_with_policy freeform "$@"; }

# prompt_selection <cur_provider> <cur_harness> <cur_model> — sets PROVIDER/HARNESS/MODEL
PROVIDER=""; HARNESS=""; MODEL=""; PERMISSION_POLICY="workspace"
prompt_selection() {
  local installed providers avail models current_permission="${4:-workspace}"
  installed=$(installed_harnesses)
  providers=$(providers_for_installed)
  [[ -n "$providers" ]] || { echo "no agents found — install one first"; exit 1; }
  # provider — default to the current one if it's still available
  [[ " $providers " == *" $1 "* ]] && PROVIDER="$1" || PROVIDER=""
  PROVIDER=$(pick "AI provider" "${PROVIDER:-$(echo "$providers" | awk '{print $1}')}" $providers) || return $?
  # harness (installed + compatible with the chosen provider)
  avail=()
  for h in $("$PROVIDER_BIN" compat "$PROVIDER"); do
    [[ " $installed " == *" $h "* ]] && avail+=("$h")
  done
  [[ " ${avail[*]} " == *" $2 "* ]] && HARNESS="$2" || HARNESS=""
  HARNESS=$(pick "Harness" "${HARNESS:-${avail[0]}}" "${avail[@]}") || return $?
  # model — default to the current one (free text allowed, so no availability check)
  models=$("$PROVIDER_BIN" models "$PROVIDER")
  MODEL=$(pick_freeform "Model" "${3:-$(echo "$models" | awk '{print $1}')}" $models) || return $?
  local policies
  policies=$("$PROVIDER_BIN" permissions "$HARNESS")
  [[ " $policies " == *" $current_permission "* ]] || current_permission=$(printf '%s' "$policies" | awk '{print $1}')
  PERMISSION_POLICY=$(pick "Agent permissions" "$current_permission" $policies) || return $?
  if [[ "$PERMISSION_POLICY" == unrestricted \
      && "${RTIDE_DEV_PERMISSION_CONFIRMED:-0}" != 1 ]]; then
    printf 'WARNING: unrestricted agents can read and modify files outside this workspace and access tmux.\n' >&2
    local confirm
    confirm=$(cancellable_input "Type UNRESTRICTED to confirm" "") || return 130
    [[ "$confirm" == UNRESTRICTED ]] || { echo "unrestricted permission was not enabled" >&2; return 130; }
  fi
}

# --- commands --------------------------------------------------------------

setup_wizard() {
  echo "==> RTIDE setup"
  local installed; installed=$(installed_harnesses)
  [[ -n "$installed" ]] || { echo "no agents found — install one first"; exit 1; }
  echo "Installed agents: $installed"
  prompt_selection "${provider:-}" "${harness:-${agent:-}}" "${model:-}" "${permission_policy:-workspace}" || return 130
  default_dir=$(cancellable_input "Default directory (empty = current dir)" "") || return 130
  agent_lines=$(cancellable_input "Agent strip lines" "3") || return 130
  tweb_pct=$(cancellable_input "tweb width %" "60") || return 130
  local shells=()
  for s in fish zsh nushell bash; do
    command -v "$s" >/dev/null 2>&1 && shells+=("$s")
  done
  local def_shell=fish
  command -v fish >/dev/null 2>&1 || def_shell=zsh
  shell=$(pick "Shell for running programs" "$def_shell" "${shells[@]}") || return 130
  command -v "$shell" >/dev/null 2>&1 || echo "note: $shell not on PATH — install it (e.g. sudo apt install $shell)"
  af=$(pick "Auto-float dense content?" "N" "N" "y") || return 130
  local auto_float=false
  [[ "$af" =~ ^[yY] ]] && auto_float=true
  mkdir -p "$CONFIG_DIR"
  "$SETTINGS_BIN" --config "$CONFIG" set --scope global "$(pwd)" \
    "provider=$PROVIDER" "harness=$HARNESS" "model=$MODEL" \
    "permission_policy=$PERMISSION_POLICY" "default_dir=$default_dir" \
    "agent_lines=$agent_lines" "tweb_pct=$tweb_pct" "shell=$shell" \
    "auto_float=$auto_float" "worktree_root=" >/dev/null
  echo "Saved to $CONFIG"
}

cmd_setup() {
  setup_wizard || { echo "setup cancelled"; return 0; }
  "$RTIDE_LIBEXEC_DIR/mcp"
}

cmd_doctor() {
  local ok=1 repo outer manager
  manager=$("$DEPS_BIN" manager 2>/dev/null || true)
  echo "host: ${manager:-no supported package manager}"
  # One canonical matrix drives both this report and installation provisioning.
  # Required + build level entries are blockers; optional entries are warnings.
  command -v python3 >/dev/null 2>&1 || { echo 'MISSING: python3 (required to inspect dependencies)'; return 1; }
  local tweb_present=0
  command -v tweb >/dev/null 2>&1 && tweb_present=1
  local mark level category name detail remedy
  while IFS=$'\t' read -r mark level category name detail; do
    case "$mark" in
      ok)
        [[ "$level" == optional ]] && echo "optional: $name — $detail"
        ;;
      warn)
        echo "WARN (optional): $name — $detail (non-blocking)"
        ;;
      MISSING)
        remedy=$("$DEPS_BIN" check --json \
          | python3 -c 'import json,sys; rows=json.load(sys.stdin); print(next((r["remedy"] for r in rows if r["name"]==sys.argv[1]), ""))' "$name")
        if [[ "$level" == build && $tweb_present -eq 1 ]]; then
          # Build tools are only needed to build tweb from source; tweb exists.
          echo "note: $name missing — only needed to build tweb from source"
        elif [[ "$level" == optional ]]; then
          echo "WARN (optional): $name — ${remedy:-unavailable}"
        elif [[ "$level" == build ]]; then
          echo "MISSING: $name — ${remedy:-required to build tweb}"
          ok=0
        else
          echo "MISSING: $name${detail:+ — $detail}"
          printf '  remedy: %s\n' "${remedy:-install it}"
          ok=0
        fi
        ;;
    esac
  done < <("$DEPS_BIN" check 2>/dev/null)

  if command -v tweb >/dev/null 2>&1; then
    echo 'core:'
    tweb doctor || ok=0
  fi
  if [[ -f "$CONFIG" ]]; then
    load_config_file "$CONFIG"
    local p="${provider:-}"
    if [[ -n "$p" ]]; then
      echo "provider: $p"
      "$PROVIDER_BIN" check "$p" || ok=0
    fi
  fi
  repo=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n "$repo" ]]; then
    echo "worktree root: $(fork_worktree_parent "$repo")"
    if outer=$(enclosing_repository_root "$repo"); then
      echo "WARN: independent Git checkout is nested inside $outer"
    fi
  fi
  if [[ $ok -eq 1 ]]; then echo "doctor: all good"; fi
  return $((1 - ok))
}

cmd_new() {
  ndir=$(cancellable_input "Directory for new workspace" "$(pwd)") \
    || { echo "new workspace cancelled"; return 0; }
  exec "$0" "$ndir"
}

fork_primary_root() {
  local root="$1"
  git -C "$root" worktree list --porcelain \
    | awk '$1=="worktree"{print $2; exit}'
}

fork_worktree_parent() {
  local root="$1" primary storage base identity configured=""
  primary=$(fork_primary_root "$root")
  [[ -n "$primary" ]] || { echo "fork: repository has no primary worktree" >&2; return 1; }
  primary=$(realpath -m "$primary")
  if [[ -f "$CONFIG" ]]; then
    configured=$(sed -n 's/^worktree_root=//p' "$CONFIG" | tail -1)
  fi
  storage="${RTIDE_WORKTREE_ROOT:-${configured:-${XDG_DATA_HOME:-$HOME/.local/share}/rtide/worktrees}}"
  storage=$(realpath -m "$storage")
  base=$(basename "$primary" | tr -cs 'A-Za-z0-9._-' '-')
  identity=$(printf '%s' "$primary" | git hash-object --stdin | cut -c1-12)
  printf '%s/%s-%s\n' "$storage" "$base" "$identity"
}

prepare_fork_worktree_parent() {
  local root="$1" parent="$2" enclosing
  mkdir -p "$parent"
  enclosing=$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n "$enclosing" ]]; then
    echo "fork: managed worktree root is inside a Git repository: $(realpath -m "$enclosing")" >&2
    echo "fork: set RTIDE_WORKTREE_ROOT to a directory outside every repository" >&2
    return 2
  fi
}

enclosing_repository_root() {
  local root="$1" parent enclosing
  root=$(realpath -m "$root")
  parent=$(dirname "$root")
  enclosing=$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null || true)
  [[ -n "$enclosing" ]] || return 1
  enclosing=$(realpath -m "$enclosing")
  [[ "$enclosing" != "$root" ]] || return 1
  printf '%s\n' "$enclosing"
}

fork_running_window() {
  local sess="$1" workspace="$2"
  tmux list-windows -t "$sess" -F '#{window_id} #{@rtide-workspace}' 2>/dev/null \
    | awk -v d="$(realpath -m "$workspace")" '$2==d{print $1; exit}'
}

validate_fork_snapshot() {
  local root="$1" required_file
  local -a runtime_files=(
    bin/rtide
    libexec/rtide/agent libexec/rtide/dictate libexec/rtide/fork-status
    libexec/rtide/forks libexec/rtide/mcp libexec/rtide/memory
    libexec/rtide/memory-index libexec/rtide/open libexec/rtide/pane-popup
    libexec/rtide/picker.sh libexec/rtide/progress libexec/rtide/provider
    libexec/rtide/render libexec/rtide/run libexec/rtide/tweb-common.sh
    libexec/rtide/workspace-status
    libexec/rtide/guard-bin/tweb share/AGENTS.md share/template.html
  )
  while IFS= read -r required_file; do
    [[ -z "$required_file" || ! -e "$root/$required_file" ]] && continue
    git -C "$root" ls-files --error-unmatch -- "$required_file" >/dev/null 2>&1 \
      || { echo "fork: runtime dependency is untracked: $required_file; add or commit it before creating a fork" >&2; return 2; }
  done < <(printf '%s\n' "${runtime_files[@]}")
}

write_fork_launch_status() {
  local path="$1" state="$2" stage="$3" nvim="$4" tweb="$5" agent="$6" message="${7:-}"
  "$RTIDE_LIBEXEC_DIR/fork-status" "$path" "$state" "$stage" "$nvim" "$tweb" "$agent" "$message"
}

fork_launch_notice() {
  local pane="$1" message="$2"
  tmux display-message -d 8000 -t "$pane" "$message" 2>/dev/null || true
}

launch_fork_window() {
  local sess="$1" fork_dir="$2" label="$3" initial_prompt="${4:-}" target_client="${5:-}"
  tmux set-option -t "$sess" allow-passthrough all
  local provider harness model permission_policy agent_lines tweb_pct shell fork_window nvim_pane agent_pane tweb_pane tweb_w width first_page ready marker
  local ready_nvim=0 ready_tweb=0 ready_agent=0 deadline status_file log_file failed
  local running
  running=$(fork_running_window "$sess" "$fork_dir")
  if [[ -n "$running" ]]; then
    if [[ -n "$target_client" ]]; then
      tmux switch-client -c "$target_client" -t "$running"
    else
      tmux select-window -t "$running"
    fi
    echo "fork: switched to $label"
    return 0
  fi
  status_file="$fork_dir/.rtide/fork-launch.json"
  log_file="$fork_dir/.rtide/fork-launch.log"
  mkdir -p "$fork_dir/.rtide"
  : > "$log_file"
  write_fork_launch_status "$status_file" starting configure 0 0 0 "Preparing fork runtime"
  load_config_file "$CONFIG"
  load_config_file "$fork_dir/.rtide/agent"
  harness="${harness:-${agent:-}}"; agent_lines="${agent_lines:-3}"
  permission_policy="${permission_policy:-workspace}"
  tweb_pct="${tweb_pct:-60}"; shell="${shell:-bash}"
  fork_window=$(tmux new-window -d -P -F '#{window_id}' -t "$sess:" -n "$label" -c "$fork_dir")
  printf 'window=%s\n' "$fork_window" >> "$log_file"
  tmux set-option -w -t "$fork_window" @rtide-workspace "$fork_dir"
  tmux set-option -w -t "$fork_window" @rtide-window-name "$label"
  tmux set-option -w -t "$fork_window" automatic-rename off
  rtide_tmux_chrome "$sess" "$fork_window" "${DEV_MODE:-0}" \
    "$(tr -d '[:space:]' < "$RTIDE_ROOT/VERSION")" "${DEV_LABEL:-DEVELOPMENT}"
  nvim_pane=$(tmux list-panes -t "$fork_window" -F '#{pane_id}' | head -1)
  tmux set-option -p -t "$nvim_pane" @rtide-role nvim
  tmux select-pane -t "$nvim_pane" -T editor
  tmux send-keys -t "$nvim_pane" "$(rtide_nvim_command "$fork_dir" "$shell")" Enter
  agent_pane=$(tmux split-window -d -v -P -F '#{pane_id}' -t "$nvim_pane" -l "$agent_lines" -c "$fork_dir")
  tmux set-option -p -t "$agent_pane" @rtide-role agent
  tmux select-pane -t "$agent_pane" -T composer
  tweb_pane=$(tmux split-window -d -h -P -F '#{pane_id}' -t "$nvim_pane" -p "$tweb_pct" -c "$fork_dir")
  tmux set-option -p -t "$tweb_pane" @rtide-role tweb
  tmux select-pane -t "$tweb_pane" -T output
  printf '%s\n' "$tweb_pane" > "$fork_dir/.rtide/tweb-pane"
  # No cache match is the normal case for a brand-new fork.  With pipefail,
  # xargs translates grep's no-match status into 123, which would otherwise
  # abort this set -e launcher before tweb and the agent are started.
  marker=$(find "$HOME/.cache/rtide" -type f -name last-render -print 2>/dev/null \
    | xargs -r grep -l "file://$fork_dir/" 2>/dev/null | head -1 || true)
  if [[ -n "$marker" ]]; then
    read -r first_page < "$marker"
  elif [[ -f "$fork_dir/.tweb/history.html" ]]; then
    first_page="file://$fork_dir/.tweb/history.html"
  else
    first_page="file://$fork_dir/.tweb/welcome.html"
  fi
  tmux send-keys -t "$tweb_pane" "tweb open '$first_page'" Enter
  find "$fork_dir/.rtide/agent-ready" -maxdepth 0 -type f -delete 2>/dev/null || true
  tmux send-keys -t "$agent_pane" "$RTIDE_AGENT_CMD $harness $provider $model $fork_dir $permission_policy" Enter
  printf 'nvim_pane=%s\nagent_pane=%s\ntweb_pane=%s\npage=%s\n' \
    "$nvim_pane" "$agent_pane" "$tweb_pane" "$first_page" >> "$log_file"
  write_fork_launch_status "$status_file" waiting readiness 0 0 0 "Waiting for nvim, tweb, and agent"
  apply_window_layout "$fork_window" auto >/dev/null
  tmux set-option -w -t "$fork_window" window-size latest 2>/dev/null || true
  tmux set-hook -w -t "$fork_window" after-resize-window \
    "run-shell '$RTIDE_CMD refresh-window $fork_window >/dev/null 2>&1'" 2>/dev/null || true
  # Treat fork creation as one atomic launch. Do not return to the popup until
  # editor, browser, and prompt are all usable; select the new window last so
  # popup teardown cannot restore the originating window over it.
  deadline=$((SECONDS + 15))
  while (( SECONDS < deadline )); do
    if (( ! ready_nvim )) && [[ -n "$(rtide_locate_nvim_socket "$fork_dir" 2>/dev/null || true)" ]]; then
      ready_nvim=1; printf 'ready=nvim\n' >> "$log_file"
      write_fork_launch_status "$status_file" waiting readiness "$ready_nvim" "$ready_tweb" "$ready_agent" "nvim ready"
    fi
    tweb status --pane "$tweb_pane" 2>/dev/null \
      | grep -Fq "$first_page" && {
          if (( ! ready_tweb )); then
            ready_tweb=1; printf 'ready=tweb\n' >> "$log_file"
            write_fork_launch_status "$status_file" waiting readiness "$ready_nvim" "$ready_tweb" "$ready_agent" "tweb ready"
          fi
        } || true
    if [[ -f "$fork_dir/.rtide/agent-ready" ]]; then
      if (( ! ready_agent )); then
        ready_agent=1; printf 'ready=agent marker\n' >> "$log_file"
        write_fork_launch_status "$status_file" waiting readiness "$ready_nvim" "$ready_tweb" "$ready_agent" "agent ready"
      fi
    else
      tmux capture-pane -p -t "$agent_pane" -S -10 2>/dev/null \
        | grep -Fq '● ready' && {
            if (( ! ready_agent )); then
              ready_agent=1; printf 'ready=agent pane\n' >> "$log_file"
              write_fork_launch_status "$status_file" waiting readiness "$ready_nvim" "$ready_tweb" "$ready_agent" "agent ready"
            fi
          } || true
    fi
    (( ready_nvim && ready_tweb && ready_agent )) && break
    sleep 0.1
  done
  (( ready_tweb )) && rtide_tweb_controls "$tweb_pane"
  if ! (( ready_nvim && ready_tweb && ready_agent )); then
    failed=""
    (( ready_nvim )) || failed="${failed} nvim"
    (( ready_tweb )) || failed="${failed} tweb"
    (( ready_agent )) || failed="${failed} agent"
    tmux capture-pane -p -t "$nvim_pane" -S -40 > "$fork_dir/.rtide/fork-launch-nvim.log" 2>&1 || true
    tmux capture-pane -p -t "$tweb_pane" -S -40 > "$fork_dir/.rtide/fork-launch-tweb.log" 2>&1 || true
    tmux capture-pane -p -t "$agent_pane" -S -80 > "$fork_dir/.rtide/fork-launch-agent.log" 2>&1 || true
    printf 'failed=%s\n' "${failed# }" >> "$log_file"
    write_fork_launch_status "$status_file" failed readiness "$ready_nvim" "$ready_tweb" "$ready_agent" "Timed out waiting for:${failed}"
    fork_launch_notice "$fork_window" "RTIDE fork '$label' failed:${failed} · $status_file"
    printf 'fork: launch incomplete; failed:%s (status: %s)\n' "$failed" "$status_file" >&2
    return 1
  fi
  if [[ -n "$initial_prompt" ]]; then
    ready=0
    for _ in $(seq 1 150); do
      if tmux capture-pane -p -t "$agent_pane" -S -6 2>/dev/null | grep -q '╰─❯'; then ready=1; break; fi
      sleep 0.1
    done
    if (( ! ready )); then
      write_fork_launch_status "$status_file" failed prompt 1 1 1 "Agent prompt did not become interactive"
      tmux capture-pane -p -t "$agent_pane" -S -80 > "$fork_dir/.rtide/fork-launch-agent.log" 2>&1 || true
      fork_launch_notice "$fork_window" "RTIDE fork '$label' failed: agent prompt · $status_file"
      echo "fork: new prompt pane did not become ready (status: $status_file)" >&2
      return 1
    fi
    tmux send-keys -t "$agent_pane" -l "$initial_prompt"
    tmux send-keys -t "$agent_pane" Enter
  fi
  if [[ -n "$target_client" ]]; then
    tmux switch-client -c "$target_client" -t "$fork_window"
  else
    tmux select-window -t "$fork_window"
  fi
  tmux select-pane -t "$agent_pane"
  write_fork_launch_status "$status_file" ready complete 1 1 1 "Fork runtime is ready"
  printf 'ready=complete\n' >> "$log_file"
  fork_launch_notice "$fork_window" "RTIDE fork '$label' is ready"
  echo "fork: resumed $label"
}

fork_root_from_context() {
  local pane="${1:-${TMUX_PANE:-}}" workspace
  workspace=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || pwd)
  git -C "$workspace" rev-parse --show-toplevel 2>/dev/null
}

cmd_fork_manager() {
  local action="${2:-list}" selector="${3:-}" context_pane="${4:-${TMUX_PANE:-}}" target_client="${5:-}" sess root item path window parent destination
  sess=$(tmux display-message -p -t "$context_pane" '#{session_name}' 2>/dev/null || true)
  root=$(fork_root_from_context "$context_pane") || { echo "fork: not in a Git repository" >&2; return 1; }
  case "$action" in
    list|status)
      [[ "$action" == list ]] && "$RTIDE_LIBEXEC_DIR/forks" --root "$root" list \
        || "$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "${selector:?usage: rtide fork status <name>}"
      ;;
    resume)
      item=$("$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "${selector:?usage: rtide fork resume <name>}" --json) || return
      path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<< "$item")
      [[ -d "$path/.rtide/memory" ]] && "$RTIDE_LIBEXEC_DIR/memory-index" "$path/.rtide/memory" --scope fork >/dev/null
      launch_fork_window "$sess" "$path" "$(basename "$path")" "" "$target_client"
      ;;
    stop)
      item=$("$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "${selector:?usage: rtide fork stop <name>}" --json) || return
      path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<< "$item")
      window=$(fork_running_window "$sess" "$path")
      [[ -n "$window" ]] || { echo "fork: already stopped: $selector"; return 0; }
      "$RTIDE_LIBEXEC_DIR/memory" sweep "$sess" 2>/dev/null || true
      tmux kill-window -t "$window"
      echo "fork: stopped $selector; worktree preserved"
      ;;
    finish)
      "$RTIDE_LIBEXEC_DIR/forks" --root "$root" check-finish "${selector:?usage: rtide fork finish <name>}" || return
      echo "fork: finish is safe; removal requires confirmation in the Fork Manager"
      ;;
    memories)
      item=$("$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "${selector:?usage: rtide fork memories <name>}" --json) || return
      path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<< "$item")
      mkdir -p "$path/.rtide/memory"
      "$RTIDE_LIBEXEC_DIR/memory-index" "$path/.rtide/memory" --scope fork
      echo "fork: memory review data is in $path/.rtide/memory/.index-v2/index.json"
      ;;
    remove)
      item=$("$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "${selector:?usage: rtide fork remove <name>}" --json) || return
      path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<< "$item")
      "$RTIDE_LIBEXEC_DIR/forks" --root "$root" check-finish "$selector" || return
      window=$(fork_running_window "$sess" "$path")
      [[ -z "$window" ]] || { echo "fork: stop the runtime before finishing: $selector" >&2; return 2; }
      git -C "$root" worktree remove "$path"
      echo "fork: finished and removed $selector"
      ;;
    repair)
      item=$("$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "${selector:?usage: rtide fork repair <name>}" --json) || return
      path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<< "$item")
      window=$(fork_running_window "$sess" "$path")
      [[ -z "$window" ]] || { echo "fork: stop the runtime before repair: $selector" >&2; return 2; }
      find "$path/.rtide/tweb-pane" "$path/.rtide/agent-ready" \
        "$path/.rtide/render-request" -maxdepth 0 -type f -delete 2>/dev/null || true
      rtide_cleanup_nvim_socket "$path"
      echo "fork: repaired runtime state for $selector; source and history preserved"
      ;;
    migrate)
      item=$("$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "${selector:?usage: rtide fork migrate <name>}" --json) || return
      path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<< "$item")
      window=$(fork_running_window "$sess" "$path")
      [[ -z "$window" ]] || { echo "fork: stop the runtime before migrating: $selector" >&2; return 2; }
      parent=$(fork_worktree_parent "$root") || return
      prepare_fork_worktree_parent "$root" "$parent" || return
      destination="$parent/$(basename "$path")"
      [[ "$(realpath -m "$path")" != "$(realpath -m "$destination")" ]] \
        || { echo "fork: already in managed storage: $selector"; return 0; }
      [[ ! -e "$destination" ]] || { echo "fork: migration destination exists: $destination" >&2; return 2; }
      git -C "$root" worktree move "$path" "$destination"
      python3 - "$path" "$destination" <<'PY'
from pathlib import Path
import sys

old, new = sys.argv[1:]
root = Path(new)
files = [root / ".rtide" / "output-history.json", root / ".rtide" / "fork-context.md"]
if (root / ".tweb").is_dir():
    files.extend((root / ".tweb").rglob("*.html"))
for file in files:
    try:
        text = file.read_text(encoding="utf-8")
    except OSError:
        continue
    updated = text.replace("file://" + old, "file://" + new).replace(old, new)
    if updated != text:
        file.write_text(updated, encoding="utf-8")
PY
      echo "fork: migrated $selector to $destination"
      ;;
    *) echo "usage: rtide fork list|resume|stop|status|memories|finish|remove|repair|migrate [name]" >&2; return 2 ;;
  esac
}

cmd_fork_menu_action() {
  local action="${2:-}" name="${3:-}" pane="${4:-}" client="${5:-}" root item path sess window
  [[ -n "$action" && -n "$pane" ]] || return 2
  case "$action" in
    create)
      sess=$(tmux display-message -p -t "$pane" '#{session_name}') || return
      window=$(tmux display-message -p -t "$pane" '#{window_id}') || return
      "$0" fork "$sess" "$window" "$name" "" "$client"
      ;;
    resume) "$0" fork resume "$name" "$pane" "$client" ;;
    status) "$0" fork status "$name" "$pane" | less -R ;;
    stop) "$0" fork stop "$name" "$pane" ;;
    memories)
      "$0" fork memories "$name" "$pane" >/dev/null || return
      root=$(fork_root_from_context "$pane") || return
      item=$("$RTIDE_LIBEXEC_DIR/forks" --root "$root" status "$name" --json) || return
      path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<< "$item")
      ${EDITOR:-nvim} "$path/.rtide/memory/.index-v2/index.json"
      ;;
    repair) "$0" fork repair "$name" "$pane" ;;
    migrate) "$0" fork migrate "$name" "$pane" ;;
    remove) "$0" fork remove "$name" "$pane" ;;
    *) return 2 ;;
  esac
}

dispatch_fork_menu_action() {
  local action="$1" name="$2" pane="$3" client="${4:-}" command log
  log="${TMPDIR:-/tmp}/rtide-fork-dispatch-$(printf '%s' "$pane-$action-$name" | tr -cs 'A-Za-z0-9._-' '-').log"
  printf -v command '%q fork-menu-action %q %q %q %q >%q 2>&1; rc=$?; if (( rc )); then msg=$(tail -1 %q); printf -v notice "RTIDE fork action failed: %%s · log: %%s" "$msg" %q; tmux display-message -d 10000 -t %q "$notice"; fi' \
    "$SCRIPT_PATH" "$action" "$name" "$pane" "$client" "$log" "$log" "$log" "$pane"
  # The picker lives inside a popup. Hand the operation to tmux before closing
  # that popup so create/resume cannot be killed with its owning shell.
  tmux run-shell -b "$command"
  tmux display-popup -C 2>/dev/null || true
}

cmd_fork_menu() {
  local pane="${2:-${TMUX_PANE:-}}" sess window client root output decision mode selected name branch state ahead path memories action running label lifecycle status_inventory
  [[ -n "$pane" ]] || return 1
  sess=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null || true)
  window=$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)
  client=$(tmux display-message -p -t "$pane" '#{client_name}' 2>/dev/null || true)
  root=$(fork_root_from_context "$pane") || { echo "fork: not in a Git repository" >&2; return 1; }
  command -v fzf >/dev/null 2>&1 || { echo "fork: fzf is required for the visual manager" >&2; return 1; }
  status_inventory=$("$RTIDE_LIBEXEC_DIR/workspace-status" list --tsv 2>/dev/null || true)
  rtide_picker_options create full
  output=$({
      printf '＋ Create new fork\tnew\t\t\t\t\n'
      while IFS=$'\t' read -r name branch state ahead path memories; do
        running=$(fork_running_window "$sess" "$path")
        label=$([[ -n "$running" ]] && printf '● running' || printf '○ stopped')
        lifecycle=$(awk -F '\t' -v workspace="$path" '$2==workspace{print $4; exit}' <<< "$status_inventory")
        [[ -z "$lifecycle" ]] || label="$label · $lifecycle"
        printf '%s\t%s\t%s · %s\t%s\t%s\t%s\n' "$name" "$branch" "$label" "$state" "$ahead" "$path" "$memories"
      done < <("$RTIDE_LIBEXEC_DIR/forks" --root "$root" list)
    } \
    | fzf "${RTIDE_PICKER_ARGS[@]}" --ansi --print-query --height=100% \
      --bind='enter:accept-or-print-query' \
      --header="Fork Manager · create, resume, inspect, or stop\n$(rtide_picker_header create)" \
      --prompt='forks ❯ ' --delimiter=$'\t' --with-nth=1,3,4,6) || true
  # accept-or-print-query may return nonzero while still printing an unmatched
  # query. Empty output is cancellation; non-empty output must be decoded.
  [[ -n "$output" ]] || return 0
  decision=$(rtide_picker_decode "$output" create new)
  mode=${decision%%$'\t'*}
  selected=${decision#*$'\t'}
  if [[ "$mode" == create ]]; then
    dispatch_fork_menu_action create "$selected" "$pane" "$client"
    return
  fi
  [[ "$mode" == open ]] || return 0
  IFS=$'\t' read -r name branch state ahead path memories <<< "$selected"
  rtide_picker_options select full
  action=$(printf '%s\n' \
    $'resume\tResume or switch' $'status\tView status' $'stop\tStop runtime' \
    $'memories\tReview memories' $'repair\tRepair runtime state' \
    $'migrate\tMove to managed storage' $'remove\tFinish and remove' \
    | fzf "${RTIDE_PICKER_ARGS[@]}" --height=100% \
      --delimiter=$'\t' --with-nth=2 \
      --header=$'Fork actions\n'"$name · $state · $ahead" \
      --prompt='action ❯ ') || return 0
  action=${action%%$'\t'*}
  if [[ "$action" == remove ]]; then
    rtide_picker_options select full
    action=$(printf '%s\n' \
      $'remove\tYes — finish and remove worktree' $'cancel\tCancel — keep fork' \
      | fzf "${RTIDE_PICKER_ARGS[@]}" --height=100% --no-sort \
        --delimiter=$'\t' --with-nth=2 \
        --header=$'Permanent removal\nThis deletes the worktree after safety checks' \
        --prompt='confirm ❯ ') || return 0
    action=${action%%$'\t'*}
    [[ "$action" == remove ]] || return 0
  fi
  dispatch_fork_menu_action "$action" "$name" "$pane" "$client"
}

cmd_fork_new_popup() {
  local sess="${2:-}" window="${3:-}" result name
  [[ -n "$sess" && -n "$window" ]] || { echo "fork: missing workspace context" >&2; return 2; }
  command -v fzf >/dev/null 2>&1 || { echo "fork: fzf is required for naming" >&2; return 1; }
  # Native fzf cancellation is reliable whether this function is called as a
  # command or nested inside Fork Manager. Enter submits the query; Escape
  # returns non-zero and creates nothing.
  rtide_picker_options freeform full
  result=$(printf '\n' | fzf "${RTIDE_PICKER_ARGS[@]}" --print-query --query='' \
    --height=100% --no-info --prompt='name › ' \
    --bind='enter:accept-or-print-query' \
    --header=$'Name this fork\nEnter = create automatically or use typed name   Esc = cancel') || true
  [[ -n "$result" ]] || return 0
  name=$(printf '%s\n' "$result" | head -1)
  "$0" fork "$sess" "$window" "$name"
}

cmd_fork() {
  local sess="${2:-}" source_window="${3:-}" requested_name="${4:-}" initial_prompt="${5:-}" target_client="${6:-}" source_target nvim source root primary parent base number name branch fork_dir patch_file untracked
  local provider harness model agent_lines tweb_pct shell fork_window nvim_pane agent_pane tweb_pane tweb_w width first_page ready
  [[ -n "$sess" ]] || sess=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  [[ -n "$sess" ]] && tmux has-session -t "$sess" 2>/dev/null \
    || { echo "fork: no RTIDE workspace session" >&2; exit 1; }
  [[ -n "$source_window" ]] || source_window=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
  source_target="${source_window:-$sess:work}"
  nvim=$(tmux list-panes -t "$source_target" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
    | awk '$2=="nvim"{print $1; exit}')
  [[ -n "$nvim" ]] || { echo "fork: source workspace has no editor pane" >&2; exit 1; }
  source=$(tmux display-message -p -t "$nvim" '#{pane_current_path}')
  root=$(git -C "$source" rev-parse --show-toplevel 2>/dev/null) \
    || { echo "fork: $source is not inside a Git repository" >&2; exit 1; }
  # A development checkout may have tracked code that already refers to a new,
  # untracked runtime helper. Git worktrees cannot contain that helper, so stop
  # before creating a deceptively valid but unrunnable fork.
  validate_fork_snapshot "$root" || exit $?
  primary=$(fork_primary_root "$root")
  parent=$(fork_worktree_parent "$root") || exit
  base=$(basename "$primary")
  prepare_fork_worktree_parent "$root" "$parent" || exit
  number=1
  while git -C "$root" show-ref --verify --quiet "refs/heads/rtide/fork-$number" \
      || [[ -e "$parent/$base-fork-$number" ]]; do
    number=$((number + 1))
  done
  name="${requested_name:-$base-fork-$number}"
  name=$(printf '%s' "$name" | tr -cs 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//')
  [[ -n "$name" ]] || name="$base-fork-$number"
  branch="rtide/fork-$number"
  fork_dir="$parent/$name"
  [[ ! -e "$fork_dir" ]] || { echo "fork: destination already exists: $fork_dir" >&2; exit 1; }

  git -C "$root" worktree add -b "$branch" "$fork_dir" HEAD >/dev/null
  patch_file=$(mktemp "${TMPDIR:-/tmp}/rtide-fork.XXXXXX.patch")
  git -C "$root" diff --binary HEAD > "$patch_file"
  if [[ -s "$patch_file" ]]; then
    if ! git -C "$fork_dir" apply "$patch_file"; then
      find "$patch_file" -type f -delete
      git -C "$root" worktree remove --force "$fork_dir" >/dev/null 2>&1 || true
      git -C "$root" branch -D "$branch" >/dev/null 2>&1 || true
      echo "fork: could not replay the source working changes" >&2
      exit 1
    fi
  fi
  find "$patch_file" -type f -delete

  mkdir -p "$fork_dir/.rtide" "$fork_dir/.tweb"
  [[ -f "$source/.rtide/agent" ]] && cp "$source/.rtide/agent" "$fork_dir/.rtide/agent"
  if [[ -d "$source/.tweb" ]]; then
    cp -a "$source/.tweb/." "$fork_dir/.tweb/"
    # A fork inherits authored outputs, never live runtime routing. Rewrite
    # copied local-file references so fork-of-fork history stays self-contained.
    while IFS= read -r page; do
      sed -i "s|file://$source|file://$fork_dir|g" "$page"
    done < <(find "$fork_dir/.tweb" -type f -name '*.html' -print)
  fi
  if [[ -f "$source/.rtide/output-history.json" ]]; then
    python3 - "$source" "$fork_dir" "$branch" <<'PY'
import datetime, html, json, os, re, sys
source, fork = map(os.path.realpath, sys.argv[1:3])
branch = sys.argv[3]
src = os.path.join(source, ".rtide", "output-history.json")
dst = os.path.join(fork, ".rtide", "output-history.json")
entries = json.load(open(src, encoding="utf-8"))
for entry in entries:
    url = entry.get("url", "")
    entry["url"] = url.replace("file://" + source, "file://" + fork, 1)
with open(dst, "w", encoding="utf-8") as out:
    json.dump(entries, out, indent=2, ensure_ascii=False)
    out.write("\n")

def result_text(url):
    if not url.startswith("file://"):
        return ""
    path = url[7:]
    try:
        raw = open(path, encoding="utf-8").read()
    except OSError:
        return ""
    match = re.search(r"<main[^>]*>(.*?)</main>", raw, re.I | re.S)
    if not match:
        return ""
    text = re.sub(r"<style.*?</style>|<script.*?</script>", " ", match.group(1), flags=re.I | re.S)
    text = re.sub(r"<[^>]+>", " ", text)
    return " ".join(html.unescape(text).split())[:1800]

lines = [
    "# RTIDE conversation fork context", "",
    f"Forked from `{source}` on {datetime.datetime.now().isoformat(timespec='minutes')}.",
    f"Worktree branch: `{branch}`.", "",
    "Continue from this prior conversation state. The copied artifacts and output history are available locally.", "",
]
for i, entry in enumerate(entries[-20:], 1):
    lines += [f"## Prior turn {i}: {entry.get('title') or entry.get('kind') or 'output'}",
              f"- Request: {entry.get('request', '')}",
              f"- Type: {entry.get('kind', 'output')}",
              f"- Artifact: {entry.get('url', '')}"]
    summary = result_text(entry.get("url", ""))
    if summary:
        lines.append(f"- Result summary: {summary}")
    lines.append("")
with open(os.path.join(fork, ".rtide", "fork-context.md"), "w", encoding="utf-8") as out:
    out.write("\n".join(lines))
PY
  fi
  printf 'source=%s\nbranch=%s\ncreated=%s\n' "$source" "$branch" "$(date -Iseconds)" \
    > "$fork_dir/.rtide/fork-origin"
  # Never inherit live process identity from the source fork. These files are
  # valid only for the source tmux window and can make fork 2 appear ready or
  # route its output into fork 1.
  find "$fork_dir/.rtide/tweb-pane" "$fork_dir/.rtide/agent-ready" \
    "$fork_dir/.rtide/render-request" -maxdepth 0 -type f -delete 2>/dev/null || true
  rtide_cleanup_nvim_socket "$fork_dir"

  untracked=$(git -C "$root" ls-files --others --exclude-standard | head -20 || true)
  [[ -z "$untracked" ]] || printf 'fork note: untracked source files were not copied:\n%s\n' "$untracked" >&2
  printf 'fork: %s\nworktree: %s\nbranch: %s\n' "$name" "$fork_dir" "$branch"
  [[ "${RTIDE_FORK_NO_LAUNCH:-0}" == 1 ]] && return 0

  launch_fork_window "$sess" "$fork_dir" "$name" "$initial_prompt" "$target_client"
  exit 0
}

install_session_hooks() {
  local sess="$1" quoted tweb workspace
  printf -v quoted '%q' "$sess"
  # Creating the detached workspace at an explicit startup size leaves tmux in
  # `window-size manual`. Return it to client-driven sizing before attach so a
  # maximize, restore, or terminal resize changes the actual window canvas.
  tmux set-option -w -t "$sess:work" window-size latest 2>/dev/null || true
  tweb=$(tmux list-panes -t "$sess:work" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
    | awk '$2=="tweb"{print $1; exit}')
  if [[ -n "$tweb" ]]; then
    workspace=$(tmux display-message -p -t "$tweb" '#{pane_current_path}' 2>/dev/null || true)
    if [[ -d "$workspace/.rtide" ]]; then
      printf '%s\n' "$tweb" > "$workspace/.rtide/tweb-pane"
    fi
  fi
  # Terminal maximize/restore changes the tmux window size proportionally.
  # Reapply RTIDE's exact strip height and column split after each client resize.
  tmux set-hook -t "$sess" client-resized \
    "run-shell '$RTIDE_CMD refresh $quoted >/dev/null 2>&1'" 2>/dev/null || true
  # after-resize-window is the authoritative geometry event on tmux 3.6 and
  # also covers programmatic/terminal-driven window changes.
  tmux set-hook -t "$sess" after-resize-window \
    "run-shell '$RTIDE_CMD refresh-window #{window_id} >/dev/null 2>&1'" 2>/dev/null || true
  # Focus acknowledges done-unseen for the selected window. Input-needed is
  # intentionally not cleared by focus and waits for the next submitted answer.
  tmux set-hook -t "$sess" after-select-window \
    "run-shell '$RTIDE_STATUS_CMD acknowledge --window #{window_id} --action focus >/dev/null 2>&1'" 2>/dev/null || true
  tmux set-option -t "$sess" window-status-format '#I:#W #{@rtide-status-icon}'
  tmux set-option -t "$sess" window-status-current-format '#[bold]#I:#W #{@rtide-status-icon}'
}

# Resume a workspace on its editor pane. tmux remembers the last active pane
# per session, which is often the agent input strip; selecting the workspace
# should consistently return the user to the main editing surface instead.
resume_session() {
  local sess="$1" target="${2:-}" pane tweb
  tmux set-option -t "$sess" allow-passthrough all
  # RTIDE relies on mouse events for pane focus, border resizing, and tweb.
  # Re-enable it in case the global prefix+m toggle disabled it at runtime.
  tmux set-option -g mouse on 2>/dev/null || true
  install_session_hooks "$sess"
  tweb=$(tmux list-panes -s -t "$sess" -F '#{pane_id} #{@rtide-role}' 2>/dev/null | awk '$2=="tweb"{print $1; exit}')
  [[ -z "$tweb" ]] || rtide_tweb_controls "$tweb"
  if [[ -n "$target" ]]; then
    pane=$(tmux list-panes -t "$target" -F '#{pane_id}' \
      -f '#{==:#{@rtide-role},nvim}' 2>/dev/null | head -1)
  else
    pane=$(tmux list-panes -s -t "$sess" -F '#{pane_id}' \
      -f '#{==:#{@rtide-role},nvim}' 2>/dev/null | head -1)
  fi
  if [[ -n "$pane" ]]; then
    # The editor may live in a non-current window if the user added windows.
    tmux select-window -t "$pane" 2>/dev/null || true
    tmux select-pane -t "$pane" 2>/dev/null || true
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$sess"
  else
    tmux attach-session -t "$sess"
  fi
}

# Pick a workspace to resume (or start a new one). Used by bare `rtide` and
# `rtide switch`. Sessions are listed with their directory (`#{session_path}` —
# every workspace is created with `-c "$DIR"`); the one matching the current
# working directory is sorted first and marked, so Enter resumes it directly.
# Enter opens an existing match or creates a workspace for an unknown query.
cmd_pick() {
  local sessions cur s dir label lifecycle attention branch sdir disp
  local -a items=()
  sessions=$("$RTIDE_LIBEXEC_DIR/workspace-status" list --tsv 2>/dev/null || true)
  if [[ -z "$sessions" ]]; then
    echo "no workspaces — start a new one"
    exec "$0" new
  fi
  cur=$(realpath -m "$PWD")
  local DIM=$'\033[2m' YEL=$'\033[33m' CYAN=$'\033[36m' RESET=$'\033[0m'
  if rtide_ui_plain; then DIM= YEL= CYAN= RESET=; fi
  while IFS=$'\t' read -r s dir label lifecycle attention branch; do
    sdir=$(realpath -m "$dir")
    disp="${DIM}${sdir/#$HOME/~}${RESET} · ${lifecycle}"
    if [[ "$sdir" == "$cur" ]]; then
      # current dir first (fzf preselects line 1 → Enter resumes it)
      items=("$s"$'\t'"$disp"$'\t'"${YEL}current${RESET}"$'\t'"$sdir"$'\t'"$label"$'\t'"$lifecycle"$'\t'"$attention"$'\t'"$branch" "${items[@]}")
    else
      items+=("$s"$'\t'"$disp"$'\t\t'"$sdir"$'\t'"$label"$'\t'"$lifecycle"$'\t'"$attention"$'\t'"$branch")
    fi
  done <<< "$sessions"
  items+=("${CYAN}+${RESET} new workspace"$'\tworkspace\t\t\t\t\t\t')

  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    local out decision mode qry sel sess rc target
    while true; do
      # `if` so `set -e` doesn't kill us on fzf's non-zero exits; rc tells
      # abort (130 = Esc/Ctrl-C) apart from no-match (1 = Enter on a query
      # that filtered everything out).
      rtide_picker_options create full
      if out=$(printf '%s\n' "${items[@]}" | fzf "${RTIDE_PICKER_ARGS[@]}" --ansi --print-query \
            --no-sort --header-first --delimiter=$'\t' --with-nth=1,2,3 \
            --bind='enter:accept-or-print-query' \
            --header="RTIDE — open or create a workspace\n$(rtide_picker_header create)" \
            --preview-window='right,45%,border-left,<90(up,35%,border-bottom)' \
            --preview 'if [ -n {4} ]; then printf "directory\n  %s\n\nworkspace\n  window: %s · state: %s\n  branch: %s\n\nagent\n  attention: %s\n" {4} {5} {6} {8} {7}; [ -f {4}/.rtide/agent ] && { echo; echo "config"; sed "s/^/  /" {4}/.rtide/agent; }; else printf "Create this exact workspace query with Enter.\n"; fi' ); then
        rc=0
      else
        rc=$?
      fi
      (( rc == 130 )) && exit 0      # Esc / Ctrl-C → quit
      decision=$(rtide_picker_decode "$out" create workspace)
      mode=${decision%%$'\t'*}
      sel=${decision#*$'\t'}
      if [[ "$mode" == create ]]; then
        [[ -n "$sel" ]] && exec "$0" "$sel"
        exec "$0" new
      elif [[ "$mode" == open ]]; then
        target=$(printf '%s' "$sel" | cut -f1)
        sess=${target%%:*}
        if tmux has-session -t "$sess" 2>/dev/null; then
          resume_session "$sess" "$target" \
            || echo "could not open $sess — attach with: tmux attach -t $sess" >&2
          exit 0
        fi
      else
        exit 0
      fi
    done
  elif [[ -t 0 ]]; then
    # fallback: numbered list (accept number or session name), Enter = first
    local i=0 line ans
    for line in "${items[@]}"; do
      i=$((i+1))
      printf '  %d) %s\n' "$i" "$(printf '%s' "$line" | sed -e 's/\x1b\[[0-9;]*m//g' | tr '\t' '  ')"
    done
    read -rp "Pick a workspace [1]: " ans
    ans="${ans:-1}"
    if [[ "$ans" == "new" ]]; then
      exec "$0" new
    elif [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#items[@]} )); then
      sel="${items[$((ans-1))]}"
    else
      sel=$(printf '%s\n' "${items[@]}" | awk -F '\t' -v n="$ans" '$1==n{print; exit}')
    fi
    if [[ "$sel" == *"new workspace"* ]]; then
      exec "$0" new
    fi
    if [[ -n "$sel" ]]; then
      target=$(printf '%s' "$sel" | cut -f1)
      sess=${target%%:*}
      resume_session "$sess" "$target" \
        || echo "could not open $sess — attach with: tmux attach -t $sess" >&2
    else
      printf "no workspace matches '%s' — type 'new' to create one\n" "$ans" >&2
      exit 1
    fi
    exit 0
  else
    # non-interactive (e.g. `prefix+r` → run-shell): show the list, take no action
    local line
    for line in "${items[@]}"; do
      printf '%s\n' "$(printf '%s' "$line" | sed -e 's/\x1b\[[0-9;]*m//g' | tr '\t' '  ')"
    done
    exit 0
  fi
}

cmd_ls() {
  tmux list-sessions -F '#{session_name}  #{session_windows}w  #{session_attached}attached' 2>/dev/null \
    | grep "^${SESSION_PREFIX}" || echo "no workspaces"
  exit 0
}

cmd_sweep() {
  local s
  for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${SESSION_PREFIX}"); do
    "$RTIDE_LIBEXEC_DIR/memory" sweep "$s"
  done
  exit 0
}

# quit [dir|session] — sweep the workspace's memories, then kill it.
# No arg: the current tmux session (or the dir we're in). Only kills rtide workspaces.
cmd_quit() {
  local arg="${2:-}" target
  if [[ -n "$arg" ]]; then
    # A session name wins; anything else is a directory (whose basename may
    # itself start with "rtide-", e.g. a project called rtide-proj).
    if tmux has-session -t "$arg" 2>/dev/null; then
      target="$arg"
    else
      target="${SESSION_PREFIX}$(basename "$arg")"
    fi
  else
    target=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    [[ "$target" == "$SESSION_PREFIX"* ]] || target="${SESSION_PREFIX}$(basename "$(pwd)")"
  fi
  if ! tmux has-session -t "$target" 2>/dev/null; then
    echo "no workspace: $target" >&2
    exit 1
  fi
  if ! tmux list-windows -t "$target" -F '#{window_name}' 2>/dev/null | grep -qx work; then
    echo "not an rtide workspace: $target" >&2
    exit 1
  fi
  "$RTIDE_LIBEXEC_DIR/memory" sweep "$target" 2>/dev/null || true   # capture pending memories first
  # Remove every window's runtime control socket and pointer before teardown.
  local ws_window ws_dir
  while read -r ws_window; do
    [[ -n "$ws_window" ]] || continue
    ws_dir=$(tmux show-options -w -v -t "$ws_window" @rtide-workspace 2>/dev/null || true)
    [[ -n "$ws_dir" ]] && rtide_cleanup_nvim_socket "$ws_dir"
  done < <(tmux list-windows -t "$target" -F '#{window_id}' 2>/dev/null || true)
  tmux kill-session -t "$target"
  echo "quit: $target"
  exit 0
}

cmd_zoom() {
  local role="${2:?usage: rtide zoom <nvim|agent|tweb>}"
  local window pane active
  window=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
  [[ -n "$window" ]] || { echo "not in a tmux window"; exit 1; }
  if [[ "$role" == "current" ]]; then
    pane=$(tmux display-message -p -t "$window" '#{pane_id}')
  else
    pane=$(tmux list-panes -t "$window" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
      | awk -v r="$role" '$2==r{print $1; exit}')
  fi
  [[ -n "$pane" ]] || { echo "no '$role' pane in $window"; exit 1; }
  active=$(tmux display-message -p -t "$window" '#{pane_id}')
  # resize-pane -Z toggles: if another pane is zoomed, unzoom it first, then zoom the target
  if [[ "$(tmux display-message -p -t "$window" '#{window_zoomed_flag}')" == "1" ]]; then
    tmux resize-pane -Z -t "$active"
    # Reapply the configured split after unzooming; this repairs any stale
    # prompt height or tweb width left by prior popup-style pane moves.
    "$0" refresh-window "$window" >/dev/null 2>&1 || true
    [[ "$active" == "$pane" ]] && exit 0   # was toggling the target off
  fi
  tmux resize-pane -Z -t "$pane"
  exit 0
}

# Re-pick provider/harness/model for a workspace and restart its agent pane.
find_agent_pane() {
  local dir="$1" pane path
  dir=$(realpath -m "$dir")
  while IFS= read -r pane; do
    [[ -n "$pane" ]] || continue
    path=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)
    [[ "$(realpath -m "$path")" == "$dir" ]] && { printf '%s\n' "$pane"; return 0; }
  done < <(tmux list-panes -a -F '#{pane_id}' -f '#{==:#{@rtide-role},agent}' 2>/dev/null || true)
  return 1
}

apply_agent_settings() {
  local dir="$1" ws="$dir/$WS_AGENT_FILE" pane old_pid="" provider harness model permission_policy
  load_config_file "$CONFIG"
  load_config_file "$ws"
  harness="${harness:-${agent:-}}"; permission_policy="${permission_policy:-workspace}"
  "$SETTINGS_BIN" capability "$harness" "$permission_policy" >/dev/null || return
  pane=$(find_agent_pane "$dir" || true)
  if [[ -z "$pane" ]]; then
    echo "settings: desired agent state saved; apply pending until workspace startup"
    return 0
  fi
  old_pid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("agent_pid", ""))' \
    "$dir/.rtide/effective-settings.json" 2>/dev/null || true)
  tmux send-keys -t "$pane" C-c
  tmux send-keys -t "$pane" "$RTIDE_AGENT_CMD $harness $provider $model $dir $permission_policy" Enter
  for _ in $(seq 1 50); do
    if "$SETTINGS_BIN" verify "$dir" "provider=$provider" "harness=$harness" "model=$model" \
        "permission_policy=$permission_policy" ${old_pid:+--not-pid "$old_pid"}; then
      echo "settings: verified running agent in $pane ($harness/$provider, $permission_policy)"
      return 0
    fi
    sleep 0.1
  done
  echo "settings: transition failed verification; restoring previous effective agent state" >&2
  "$SETTINGS_BIN" restore-agent "$dir" || return 1
  unset provider harness agent model permission_policy
  load_config_file "$CONFIG"; load_config_file "$ws"
  harness="${harness:-${agent:-}}"; permission_policy="${permission_policy:-workspace}"
  tmux send-keys -t "$pane" C-c
  tmux send-keys -t "$pane" "$RTIDE_AGENT_CMD $harness $provider $model $dir $permission_policy" Enter
  return 1
}

cmd_agent() {
  local dir="${2:-$(pwd)}"
  load_config_file "$CONFIG"
  local ws="$dir/$WS_AGENT_FILE"
  load_config_file "$ws"
  prompt_selection "${provider:-}" "${harness:-${agent:-}}" "${model:-}" "${permission_policy:-workspace}"
  provider="$PROVIDER"; harness="$HARNESS"; model="$MODEL"; permission_policy="$PERMISSION_POLICY"
  "$SETTINGS_BIN" --config "$CONFIG" set --scope workspace "$dir" \
    "provider=$provider" "harness=$harness" "model=$model" "permission_policy=$permission_policy" >/dev/null
  echo "agent: desired $harness + $provider ($model), permissions=$permission_policy for $dir"
  apply_agent_settings "$(realpath -m "$dir")"
  exit 0
}

cmd_permissions() {
  local policy="${2:-}" dir="${3:-$(pwd)}" ws harness
  [[ "$policy" =~ ^(workspace|observe|native|unrestricted)$ ]] \
    || { echo "usage: rtide permissions workspace|observe|native|unrestricted [directory]" >&2; exit 2; }
  dir=$(realpath -m "$dir")
  ws="$dir/$WS_AGENT_FILE"
  [[ -f "$ws" ]] || { echo "permissions: no workspace agent config at $ws" >&2; exit 1; }
  load_config_file "$ws"
  harness="${harness:-${agent:-}}"
  "$SETTINGS_BIN" capability "$harness" "$policy" >/dev/null || exit $?
  if [[ "$policy" == unrestricted ]]; then
    printf 'WARNING: unrestricted agents can access tmux and read or modify files outside %s.\n' "$dir" >&2
    [[ "${RTIDE_CONFIRM_UNRESTRICTED:-}" == UNRESTRICTED ]] \
      || { echo "permissions: rerun with RTIDE_CONFIRM_UNRESTRICTED=UNRESTRICTED" >&2; exit 2; }
  fi
  "$SETTINGS_BIN" --config "$CONFIG" set --scope workspace "$dir" "permission_policy=$policy" >/dev/null
  printf 'permissions: desired %s for %s\n' "$policy" "$dir"
  apply_agent_settings "$dir"
  exit 0
}

# One interactive, in-session surface for every startup-configurable setting.
# It shows desired/effective/pending state, persists desired state safely, and
# applies or explicitly defers each change according to its apply class.
settings_field() { # $1=key $2=field  (from the schema JSON)
  "$SETTINGS_BIN" --config "$CONFIG" schema --json \
    | python3 -c 'import json,sys; s=json.load(sys.stdin)["settings"].get(sys.argv[1],{}); v=s.get(sys.argv[2],""); print(" ".join(map(str,v)) if isinstance(v,list) else v)' \
      "$1" "$2"
}

settings_edit() {
  local dir="$1" key spec_scope spec_apply current choice value confirm scope desired effective state
  dir=$(realpath -m "$dir")
  while :; do
    "$SETTINGS_BIN" --config "$CONFIG" status "$dir"
    key=$(pick "Setting to change (Esc to finish)" "" \
      provider harness model permission_policy agent_lines tweb_pct shell auto_float default_dir worktree_root) \
      || { echo "settings: closed"; return 0; }
    [[ -n "$key" ]] || { echo "settings: closed"; return 0; }
    spec_scope=$(settings_field "$key" scope)
    spec_apply=$(settings_field "$key" apply)
    current=$("$SETTINGS_BIN" --config "$CONFIG" status "$dir" --json 2>/dev/null \
      | python3 -c 'import json,sys
try:
    rows = json.load(sys.stdin)["settings"]
    print(next(r["desired"] for r in rows if r["key"] == sys.argv[1]))
except (ValueError, KeyError, StopIteration):
    print("")' "$key") || current=""
    choice=$(settings_field "$key" choices)
    if [[ -n "$choice" ]]; then
      value=$(pick "$key" "$current" $choice) || continue
    else
      value=$(cancellable_input "$key" "$current") || continue
    fi
    if [[ "$key" == permission_policy && "$value" == unrestricted ]]; then
      printf 'WARNING: unrestricted agents can access tmux and read or modify files outside %s.\n' "$dir" >&2
      confirm=$(cancellable_input "Type UNRESTRICTED to confirm" "") || continue
      [[ "$confirm" == UNRESTRICTED ]] || { echo "settings: unrestricted not enabled" >&2; continue; }
    fi
    # global+workspace keys are per-workspace here; global-only keys stay global.
    if [[ "$spec_scope" == "global+workspace" ]]; then scope=workspace; else scope=global; fi
    if ! "$SETTINGS_BIN" --config "$CONFIG" set --scope "$scope" "$dir" "$key=$value"; then
      echo "settings: could not save '$key=$value'" >&2
      continue
    fi
    case "$spec_apply" in
      immediate)
        local window
        window=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
        [[ -z "$window" ]] || "$0" refresh-window "$window" >/dev/null 2>&1 || true
        echo "settings: applied $key=$value to the active layout"
        ;;
      next-turn)
        apply_agent_settings "$dir" || echo "settings: $key saved; apply will retry at next start" >&2
        ;;
      *)
        echo "settings: $key=$value saved; $spec_apply"
        ;;
    esac
  done
}

cmd_settings() {
  local sub="${2:-status}" dir confirm
  case "$sub" in
    schema) shift 2; exec "$SETTINGS_BIN" --config "$CONFIG" schema "$@" ;;
    status) dir="${3:-$(pwd)}"; exec "$SETTINGS_BIN" --config "$CONFIG" status "$dir" "${@:4}" ;;
    set)
      shift 2
      exec "$SETTINGS_BIN" --config "$CONFIG" set "$@"
      ;;
    edit)
      dir="${3:-$(pwd)}"; settings_edit "$dir"
      ;;
    apply)
      dir="${3:-$(pwd)}"; dir=$(realpath -m "$dir")
      unset provider harness agent model permission_policy
      load_config_file "$CONFIG"; load_config_file "$dir/$WS_AGENT_FILE"
      harness="${harness:-${agent:-}}"; permission_policy="${permission_policy:-workspace}"
      if [[ "$permission_policy" == unrestricted ]]; then
        confirm="${RTIDE_CONFIRM_UNRESTRICTED:-}"
        [[ "$confirm" == UNRESTRICTED ]] || { echo "settings: apply requires RTIDE_CONFIRM_UNRESTRICTED=UNRESTRICTED" >&2; exit 2; }
      fi
      apply_agent_settings "$dir"
      local pane window
      pane=$(find_agent_pane "$dir" 2>/dev/null || true)
      window=$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)
      # Layout refresh is best-effort here; agent verification remains authoritative.
      [[ -z "$window" ]] || "$0" refresh-window "$window" >/dev/null 2>&1 || true
      ;;
    *) echo "usage: rtide settings [status [dir]|schema|edit [dir]|set [--scope SCOPE] dir key=value...|apply [dir]]" >&2; exit 2 ;;
  esac
  exit 0
}

cmd_auth() {
  load_config_file "$CONFIG"
  local p="${2:-${provider:-}}"
  [[ -n "$p" ]] || { echo "no provider configured — run 'rtide setup' or 'rtide agent'"; exit 1; }
  local rc=0
  "$PROVIDER_BIN" check "$p" || rc=$?
  exit $rc
}

# --- config & refresh -------------------------------------------------------

CONFIG_KEYS="provider harness model permission_policy default_dir agent_lines tweb_pct shell auto_float worktree_root"

# Rewrite ~/.rtide/config from the current shell vars (only known keys).
write_global_config() {
  local key args=()
  worktree_root="${worktree_root:-}"
  for key in $CONFIG_KEYS; do args+=("$key=${!key:-}"); done
  "$SETTINGS_BIN" --config "$CONFIG" set --scope global "$(pwd)" "${args[@]}" >/dev/null
}

# View / edit / reset the global config (source of truth for layout; the combo
# is per-workspace in .rtide/agent and managed by `rtide agent`).
#   rtide config                        → show settings
#   rtide config set k=v [k=v…]         → update keys
#   rtide config reset [layout|agent|all] → restore built-in defaults (default: layout)
cmd_config() {
  local sub="${2:-}" key val scope def
  load_config_file "$CONFIG"
  # A partial config file (or a hand-edited one) must never abort the display
  # with an unbound variable. Missing keys fall back to their schema defaults.
  provider="${provider:-}"; harness="${harness:-${agent:-}}"; model="${model:-}"
  permission_policy="${permission_policy:-workspace}"
  agent_lines="${agent_lines:-3}"
  tweb_pct="${tweb_pct:-${nvim_pct:-60}}"
  shell="${shell:-$(command -v fish >/dev/null 2>&1 && echo fish || echo bash)}"
  auto_float="${auto_float:-false}"
  default_dir="${default_dir:-}"
  worktree_root="${worktree_root:-}"
  case "$sub" in
    "")
      printf 'agent  %-12s %s\n' provider "$provider"
      printf 'agent  %-12s %s\n' harness "$harness"
      printf 'agent  %-12s %s\n' model "$model"
      printf 'agent  %-12s %s\n' permission_policy "$permission_policy"
      printf 'layout %-12s %s\n' agent_lines "$agent_lines"
      printf 'layout %-12s %s\n' tweb_pct "$tweb_pct"
      printf 'layout %-12s %s\n' shell "$shell"
      printf 'layout %-12s %s\n' auto_float "$auto_float"
      printf 'misc   %-12s %s\n' default_dir "$default_dir"
      printf 'misc   %-12s %s\n' worktree_root "${worktree_root:-${XDG_DATA_HOME:-$HOME/.local/share}/rtide/worktrees}"
      ;;
    set)
      shift 2
      [[ $# -gt 0 ]] || { echo "usage: rtide config set key=value [key=value…]"; exit 1; }
      for kv in "$@"; do
        key="${kv%%=*}"; val="${kv#*=}"
        [[ "$key" == "$kv" || -z "$key" ]] && { echo "config error: bad assignment '$kv' (want key=value)" >&2; exit 1; }
        case "$key" in
          provider|harness|model|default_dir|shell|worktree_root) ;;
          permission_policy)
            [[ "$val" =~ ^(workspace|observe|native|unrestricted)$ ]] \
              || { echo "config error: permission_policy must be workspace, observe, native, or unrestricted" >&2; exit 1; } ;;
          agent_lines)
            [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1 )) \
              || { echo "config error: agent_lines must be a positive integer" >&2; exit 1; } ;;
          tweb_pct)
            [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1 && val <= 99 )) \
              || { echo "config error: tweb_pct must be an integer 1-99" >&2; exit 1; } ;;
          auto_float)
            [[ "$val" =~ ^(true|false)$ ]] \
              || { echo "config error: auto_float must be true or false" >&2; exit 1; } ;;
          *) echo "config error: unknown key '$key' (known: $CONFIG_KEYS)" >&2; exit 1 ;;
        esac
        printf -v "$key" '%s' "$val"
      done
      write_global_config
      echo "config: updated $CONFIG"
      ;;
    reset)
      scope="${3:-layout}"
      def=fish
      command -v fish >/dev/null 2>&1 || def=zsh
      case "$scope" in
        layout) agent_lines=3; tweb_pct=60; auto_float=false; shell="$def" ;;
        agent)  provider=""; harness=""; model=""; permission_policy=workspace ;;
        all)    provider=""; harness=""; model=""; permission_policy=workspace; agent_lines=3; tweb_pct=60; auto_float=false; shell="$def"; default_dir=""; worktree_root="" ;;
        *) echo "usage: rtide config reset [layout|agent|all]" >&2; exit 1 ;;
      esac
      write_global_config
      echo "config: reset $scope — run 'rtide refresh <workspace>' to apply"
      ;;
    *)
      echo "usage: rtide config [set key=value… | reset [layout|agent|all]]" >&2
      exit 1
      ;;
  esac
  exit 0
}

# Apply one named mode without replacing panes or their processes.
apply_window_layout() {
  local target="$1" requested="${2:-}" agent nvim tweb workspace width height geometry mode agent_h nvim_w tweb_w
  [[ -n "$target" ]] && tmux display-message -p -t "$target" '#{window_id}' >/dev/null 2>&1 \
    || { echo "layout: no RTIDE window" >&2; return 1; }
  load_config_file "$CONFIG"
  agent_lines="${agent_lines:-3}"; tweb_pct="${tweb_pct:-60}"
  agent=$(tmux list-panes -t "$target" -F '#{pane_id} #{@rtide-role}' | awk '$2=="agent"{print $1; exit}')
  nvim=$(tmux list-panes -t "$target" -F '#{pane_id} #{@rtide-role}' | awk '$2=="nvim"{print $1; exit}')
  tweb=$(tmux list-panes -t "$target" -F '#{pane_id} #{@rtide-role}' | awk '$2=="tweb"{print $1; exit}')
  [[ -n "$agent" && -n "$nvim" && -n "$tweb" ]] \
    || { echo "layout: incomplete RTIDE layout" >&2; return 1; }
  tmux set-option -w -t "$target" window-size latest 2>/dev/null || true
  if [[ "$(tmux display-message -p -t "$target" '#{window_zoomed_flag}')" == 1 ]]; then
    tmux resize-pane -Z -t "$agent" 2>/dev/null || true
  fi
  [[ -n "$requested" ]] || requested=$(tmux show-options -w -v -t "$target" @rtide-layout-request 2>/dev/null || true)
  requested="${requested:-auto}"
  width=$(tmux display-message -p -t "$target" '#{window_width}')
  height=$(tmux display-message -p -t "$target" '#{window_height}')
  geometry=$(rtide_layout_geometry "$width" "$height" "$tweb_pct" "$agent_lines" "$requested") \
    || { echo "layout: unknown mode '$requested'" >&2; return 2; }
  IFS=$'\t' read -r mode agent_h nvim_w tweb_w <<< "$geometry"
  tmux resize-pane -t "$agent" -y "$agent_h"
  if [[ "$mode" == output ]]; then
    tmux resize-pane -t "$nvim" -x 1
  elif [[ "$mode" == edit ]]; then
    tmux resize-pane -t "$tweb" -x 1
  else
    tmux resize-pane -t "$tweb" -x "$tweb_w"
  fi
  tmux set-option -w -t "$target" @rtide-layout-request "$requested"
  tmux set-option -w -t "$target" @rtide-layout-mode "$mode"
  [[ "$mode" == output ]] \
    && tmux set-option -w -t "$target" @rtide-nvim-hidden 1 \
    || tmux set-option -w -u -t "$target" @rtide-nvim-hidden 2>/dev/null || true
  workspace=$(tmux display-message -p -t "$tweb" '#{pane_current_path}')
  [[ -d "$workspace/.rtide" ]] && printf '%s\n' "$tweb" > "$workspace/.rtide/tweb-pane"
  rtide_tweb_controls "$tweb"
  printf '%s\t%s\t%s\t%s\n' "$mode" "$agent_h" "$nvim_w" "$tweb_w"
}

cmd_refresh_window() {
  local target="${2:-$(tmux display-message -p '#{window_id}' 2>/dev/null || true)}" geometry
  geometry=$(apply_window_layout "$target") || exit $?
  echo "refresh-window: $target — $(printf '%s' "$geometry" | tr '\t' ' ')"
  exit 0
}

#   rtide refresh [session|dir]   (no arg → current session; prefix+R passes #{session_name})
cmd_refresh() {
  local arg="${2:-}" sess geometry
  if [[ -n "$arg" ]]; then
    # A session name wins; anything else is a directory (basename may itself be rtide-*).
    if tmux has-session -t "$arg" 2>/dev/null; then
      sess="$arg"
    else
      sess="rtide-$(basename "$arg")"
    fi
  else
    sess=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  fi
  [[ -n "$sess" ]] || { echo "refresh: not in a tmux session — pass a session: rtide refresh <dir|session>" >&2; exit 1; }
  tmux has-session -t "$sess" 2>/dev/null || { echo "refresh: no workspace: $sess" >&2; exit 1; }
  tmux list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | grep -qx work \
    || { echo "refresh: not an rtide workspace: $sess" >&2; exit 1; }

  geometry=$(apply_window_layout "$sess:work") || exit $?
  echo "refresh: $sess — $(printf '%s' "$geometry" | tr '\t' ' ')"
  exit 0
}

cmd_layout() {
  local mode="${2:-}" target="${3:-}" current next geometry
  [[ -n "$target" ]] || target=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
  [[ -n "$target" ]] || { echo "layout: no workspace window" >&2; exit 1; }
  if [[ "$mode" == cycle ]]; then
    current=$(tmux show-options -w -v -t "$target" @rtide-layout-mode 2>/dev/null || true)
    case "$current" in balanced) next=output ;; output) next=edit ;; edit) next=compose ;; *) next=balanced ;; esac
    mode="$next"
  fi
  [[ "$mode" =~ ^(auto|balanced|output|edit|compose)$ ]] \
    || { echo "usage: rtide layout auto|balanced|output|edit|compose|cycle [window]" >&2; exit 2; }
  geometry=$(apply_window_layout "$target" "$mode") || exit $?
  echo "layout: $target — $(printf '%s' "$geometry" | tr '\t' ' ')"
  exit 0
}

# Hide/show nvim without zooming away the prompt strip. tmux panes cannot have
# zero width, so hidden mode collapses the editor to its one-column minimum.
cmd_nvim() {
  local action="${2:-toggle}" target="${3:-}" hidden
  [[ -n "$target" ]] || target=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
  target=$(tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)
  [[ -n "$target" ]] || { echo "nvim: no workspace window" >&2; exit 1; }
  hidden=$(tmux show-options -w -v -t "$target" @rtide-nvim-hidden 2>/dev/null || true)
  case "$action" in
    toggle) [[ "$hidden" == 1 ]] && hidden=0 || hidden=1 ;;
    hide) hidden=1 ;;
    show) hidden=0 ;;
    *) echo "usage: rtide nvim [toggle|hide|show] [session]" >&2; exit 1 ;;
  esac
  tmux set-option -w -t "$target" @rtide-nvim-hidden "$hidden"
  [[ "$hidden" == 1 ]] && apply_window_layout "$target" output >/dev/null \
    || apply_window_layout "$target" balanced >/dev/null
  echo "nvim: $target — $([[ "$hidden" == 1 ]] && echo hidden || echo visible)"
  exit 0
}

cmd_layout_reset() {
  local target="${2:-}" agent tweb
  [[ -n "$target" ]] || target=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
  target=$(tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true)
  [[ -n "$target" ]] || { echo "layout-reset: no workspace window" >&2; exit 1; }
  # Reset the complete presentation state while preserving shell, agent
  # selection, and unrelated preferences.
  tmux set-option -w -t "$target" @rtide-layout-request auto
  tmux set-option -w -u -t "$target" @rtide-nvim-hidden 2>/dev/null || true
  tmux set-option -g mouse on
  apply_window_layout "$target" auto >/dev/null
  agent=$(tmux list-panes -t "$target" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
    | awk '$2=="agent"{print $1; exit}')
  tweb=$(tmux list-panes -t "$target" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
    | awk '$2=="tweb"{print $1; exit}')
  if [[ -n "$tweb" ]]; then
    tweb pin --pane "$tweb" >/dev/null 2>&1 || true
    rtide_tweb_controls "$tweb"
  fi
  tmux select-window -t "$target"
  [[ -n "$agent" ]] && tmux select-pane -t "$agent"
  echo "layout: $target — responsive auto mode, output pinned"
  exit 0
}

# Open the workspace quick-switcher menu (prefix+A). Interactive items run in a
# display-popup so fzf pickers get a tty; the rest run directly via run-shell.
#   rtide menu [session] [window] [client]
cmd_menu() {
  local sess="${2:-$(tmux display-message -p '#{session_name}' 2>/dev/null || true)}" window="${3:-$(tmux display-message -p '#{window_id}' 2>/dev/null || true)}" client="${4:-}"
  local hidden nvim tweb width tweb_w workspace menu_expanded=0
  local -a client_args=()
  [[ -n "$sess" ]] || { echo "menu: not in a tmux session — pass a session: rtide menu <session>" >&2; exit 1; }
  [[ -z "$client" ]] || client_args=(-c "$client")
  workspace=$(tmux show-options -w -v -t "$window" @rtide-workspace 2>/dev/null || true)
  if [[ -z "$workspace" ]]; then
    # Migrate sessions created before @rtide-workspace existed. Their editor
    # pane was created in the launch directory and normally remains there.
    nvim=$(tmux list-panes -t "$window" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
      | awk '$2=="nvim"{print $1; exit}')
    [[ -z "$nvim" ]] || workspace=$(tmux display-message -p -t "$nvim" '#{pane_current_path}' 2>/dev/null || true)
    [[ -n "$workspace" ]] && tmux set-option -w -t "$window" @rtide-workspace "$workspace"
  fi
  hidden=$(tmux show-options -w -v -t "$window" @rtide-nvim-hidden 2>/dev/null || true)
  if [[ "$hidden" == 1 ]]; then
    nvim=$(tmux list-panes -t "$window" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
      | awk '$2=="nvim"{print $1; exit}')
    tweb=$(tmux list-panes -t "$window" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
      | awk '$2=="tweb"{print $1; exit}')
    if [[ -n "$nvim" && -n "$tweb" ]]; then
      width=$(tmux display-message -p -t "$window" '#{window_width}')
      # Reserve 40% for terminal-drawn menus while preserving the hidden flag.
      # The EXIT cleanup collapses it again unless the chosen action explicitly
      # showed the editor or reset the layout.
      tweb_w=$(( width * 60 / 100 )); (( tweb_w < 10 )) && tweb_w=10
      tmux resize-pane -t "$tweb" -x "$tweb_w"
      menu_expanded=1
      sleep 0.08
      trap 'if [[ "$menu_expanded" == 1 ]] && [[ "$(tmux show-options -w -v -t "$window" @rtide-nvim-hidden 2>/dev/null || true)" == 1 ]]; then tmux resize-pane -t "$nvim" -x 1 2>/dev/null || true; fi' EXIT
    fi
  fi
  # Keep the menu inside the terminal-rendered left side. Centering it across
  # the full window can place half of it beneath tweb's graphical pane layer,
  # which visually clips the right side of the menu.
  # Pin workspace pickers to the directory recorded when this RTIDE window was
  # launched. tmux popups can otherwise inherit the server cwd (commonly
  # $HOME), so `rtide new` may open and scan the wrong repository.
  tmux display-menu "${client_args[@]}" -t "$window" \
    -s "$RTIDE_TMUX_MENU_STYLE" -S "$RTIDE_TMUX_MENU_BORDER" \
    -H "$RTIDE_TMUX_MENU_ACTIVE" \
    -T "#[align=centre,fg=${RTIDE_UI_FOCUS},bold] RTIDE · actions" -x 2 -y C -- \
    "- WORKSPACES"      "" "" \
    "Switch workspace" r "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -d '#{@rtide-workspace}' -x 2 -w 80% -h 70% '$RTIDE_CMD switch'" \
    "Change agent…"    m "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -x 2 -w 80% -h 70% '$RTIDE_CMD agent'" \
    "New workspace…"   n "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -d '#{@rtide-workspace}' -x 2 -w 80% -h 70% '$RTIDE_CMD new'" \
    "Fork Manager…"     f "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -d '#{@rtide-workspace}' -x 2 -w 58% -h 72% '$RTIDE_CMD fork-menu #{pane_id}'" \
    "" \
    "- LAYOUT & VIEW"   "" "" \
    "Cycle layout mode" l "run-shell '$RTIDE_CMD layout cycle ${window}'" \
    "Balanced mode"    b "run-shell '$RTIDE_CMD layout balanced ${window}'" \
    "Output mode"      o "run-shell '$RTIDE_CMD layout output ${window}'" \
    "Edit mode"        i "run-shell '$RTIDE_CMD layout edit ${window}'" \
    "Compose mode"     C "run-shell '$RTIDE_CMD layout compose ${window}'" \
    "Refresh layout"   R "run-shell '$RTIDE_CMD refresh-window ${window}'" \
    "Reset pane layout" 0 "run-shell '$RTIDE_CMD layout-reset ${window}'" \
    "Hide/show editor" e "run-shell '$RTIDE_CMD nvim toggle ${window}'" \
    "Zoom tweb"        t "run-shell '$RTIDE_CMD zoom tweb'" \
    "Zoom agent"       a "run-shell '$RTIDE_CMD zoom agent'" \
    "Config…"          c "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -x 2 -w 70% -h 50% 'sh -c \"$RTIDE_CMD config; echo; read -p done\"'" \
    "Settings…"        S "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -d '#{@rtide-workspace}' -x 2 -w 72% -h 70% '$RTIDE_CMD settings edit #{@rtide-workspace}'" \
    "" \
    "- OUTPUTS"         "" "" \
    "Output history"   h "run-shell '$RTIDE_CMD history ${window}'" \
    "Export output PDF" p "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -x 2 -w 72% -h 20% 'sh -c \"$RTIDE_CMD pdf ${window}; echo; read -p done\"'" \
    "" \
    "- INPUT & MEMORY"  "" "" \
    "Dictate prompt…"  v "display-popup -E -b sharp -s '$RTIDE_TMUX_MENU_STYLE' -S '$RTIDE_TMUX_MENU_BORDER' -x 2 -w 38% -h 25% 'sh -c \"$RTIDE_LIBEXEC_DIR/dictate #{pane_id}; rc=\$?; [ \$rc -eq 0 ] || read -p \\\"press Enter to close\\\"; exit \$rc\"'" \
    "Sweep memories"   s "run-shell '$RTIDE_CMD sweep'" \
    "" \
    "- SESSION"         "" "" \
    "Detach"           d "detach-client" \
    "Quit workspace"   q "confirm-before -p 'quit workspace? (y/n) ' \"run-shell '$RTIDE_CMD quit ${sess}'\""
  exit 0
}

cmd_history() {
  local target="${2:-$(tmux display-message -p '#{window_id}' 2>/dev/null || true)}"
  local nvim tweb dir page
  [[ -n "$target" ]] && tmux display-message -p -t "$target" '#{window_id}' >/dev/null 2>&1 \
    || { echo "history: no workspace window" >&2; exit 1; }
  nvim=$(tmux list-panes -t "$target" -F '#{pane_id} #{@rtide-role}' | awk '$2=="nvim"{print $1; exit}')
  tweb=$(tmux list-panes -t "$target" -F '#{pane_id} #{@rtide-role}' | awk '$2=="tweb"{print $1; exit}')
  [[ -n "$nvim" && -n "$tweb" ]] || { echo "history: incomplete RTIDE layout in $target" >&2; exit 1; }
  # A popup (most notably the workspace switcher) can remain layered over the
  # editor while the graphical tweb pane is still clickable. Dismiss it before
  # changing the output view so the editor is revealed rather than appearing
  # to have been replaced by popup content.
  tmux display-popup -C -t "$nvim" 2>/dev/null || true
  dir=$(tmux display-message -p -t "$nvim" '#{pane_current_path}')
  page="$dir/.tweb/history.html"
  [[ -f "$page" ]] || { echo "history: no completed outputs yet" >&2; exit 1; }
  tweb navigate --pane "$tweb" "file://$(realpath "$page")"
  rtide_tweb_controls "$tweb"
  exit 0
}

cmd_pdf() {
  local selector="${2:-}" requested="${3:-}" window tweb nvim dir status current target name out capture_dir height last_height stable
  [[ -n "$selector" ]] || selector=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
  [[ -n "$selector" ]] || { echo "pdf: no workspace window" >&2; exit 1; }
  window=$(tmux display-message -p -t "$selector" '#{window_id}' 2>/dev/null || true)
  [[ -n "$window" ]] || { echo "pdf: no workspace window" >&2; exit 1; }
  tweb=$(tmux list-panes -t "$window" -F '#{pane_id} #{@rtide-role}' | awk '$2=="tweb"{print $1; exit}')
  nvim=$(tmux list-panes -t "$window" -F '#{pane_id} #{@rtide-role}' | awk '$2=="nvim"{print $1; exit}')
  [[ -n "$tweb" ]] || { echo "pdf: no tweb pane" >&2; exit 1; }
  dir=$(tmux display-message -p -t "${nvim:-$tweb}" '#{pane_current_path}')
  status=$(tweb status --pane "$tweb")
  current=$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(next(x["url"] for x in d["tabs"]["tabs"] if x.get("active")))' <<<"$status")
  target=$(python3 -c 'import sys,urllib.parse as u; x=sys.argv[1]; print(u.parse_qs(u.urlparse(x).query).get("src",[x])[0])' "$current")
  name=$(python3 -c 'import sys,urllib.parse as u,pathlib,re; p=pathlib.PurePosixPath(u.urlparse(sys.argv[1]).path).stem; print(re.sub(r"[^A-Za-z0-9._-]+","-",p).strip("-") or "output")' "$target")
  if [[ -n "$requested" ]]; then
    out=$(realpath -m "$requested")
    mkdir -p "$(dirname "$out")"
  else
    mkdir -p "$dir/exports"
    out="$dir/exports/${name}-$(date +%Y%m%d-%H%M%S).pdf"
  fi
  tmux set-option -p -t "$tweb" @rtide-output-export 1
  trap 'tmux set-option -pu -t "$tweb" @rtide-output-export 2>/dev/null || true' EXIT
  tweb navigate --pane "$tweb" "$target" >/dev/null
  tweb eval --pane "$tweb" 'window.__rtideExporting=true; document.getElementById("rtide-output-nav")?.remove(); true' >/dev/null 2>&1 || true
  # Wait for navigation, web fonts, and responsive layout to settle. Capturing
  # on the first paint can produce a shorter page than the final artifact.
  tweb wait --pane "$tweb" --load >/dev/null 2>&1 || true
  tweb eval --pane "$tweb" 'document.fonts?.ready || true' >/dev/null 2>&1 || true
  last_height=""; stable=0
  for _ in 1 2 3 4 5 6 7 8; do
    height=$(tweb eval --pane "$tweb" \
      'Math.max(document.body.scrollHeight,document.documentElement.scrollHeight)' \
      2>/dev/null || true)
    if [[ "$height" =~ ^[0-9]+$ && "$height" == "$last_height" ]]; then
      stable=$((stable + 1))
      (( stable >= 2 )) && break
    else
      stable=0
    fi
    last_height="$height"
    tweb wait --pane "$tweb" --ms 150 >/dev/null 2>&1 || true
  done
  # Chromium print-to-PDF can drop backgrounds and clip tall local artifacts.
  # Capture the complete rendered document and wrap that exact visual in one
  # continuous PDF page instead. This preserves every color and every pixel.
  # tweb's N / tab-count badges live in a preload-injected host rather than in
  # the artifact DOM; omit that browsing chrome from the exported document.
  tweb eval --pane "$tweb" \
    'document.getElementById("__tweb_mode__")?.remove(); true' \
    >/dev/null 2>&1 || true
  tweb wait --pane "$tweb" --ms 50 >/dev/null 2>&1 || true
  capture_dir=$(mktemp -d "${TMPDIR:-/tmp}/rtide-pdf.XXXXXX")
  if command -v magick >/dev/null 2>&1 \
      && tweb full-screenshot --pane "$tweb" "$capture_dir/output.png" >/dev/null \
      && magick "$capture_dir/output.png" -units PixelsPerInch -density 144 "$out"; then
    :
  else
    find "$capture_dir" -type f -delete 2>/dev/null || true
    rmdir "$capture_dir" 2>/dev/null || true
    if [[ "$current" == "$target" ]]; then
      tweb reload --pane "$tweb" >/dev/null 2>&1 || true
    else
      tweb navigate --pane "$tweb" "$current" >/dev/null
    fi
    echo "pdf: exact export requires tweb full-screenshot and ImageMagick" >&2
    exit 1
  fi
  find "$capture_dir" -type f -delete
  rmdir "$capture_dir"
  if [[ "$current" == "$target" ]]; then
    tweb reload --pane "$tweb" >/dev/null 2>&1 || true
  else
    tweb navigate --pane "$tweb" "$current" >/dev/null
  fi
  echo "pdf: $out"
  if [[ "${RTIDE_PDF_REVEAL:-1}" != 0 ]]; then
    if command -v nautilus >/dev/null 2>&1; then
      setsid -f nautilus --select "$out" >/dev/null 2>&1 || true
    elif command -v dolphin >/dev/null 2>&1; then
      setsid -f dolphin --select "$out" >/dev/null 2>&1 || true
    elif command -v nemo >/dev/null 2>&1; then
      setsid -f nemo "$out" >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1; then
      setsid -f xdg-open "$(dirname "$out")" >/dev/null 2>&1 || true
    fi
  fi
  exit 0
}

cmd_slash_menu() {
  local pane="${2:-${TMUX_PANE:-}}" role line
  [[ -n "$pane" ]] || exit 1
  role=$(tmux display-message -p -t "$pane" '#{@rtide-role}' 2>/dev/null || true)
  line=$(tmux capture-pane -p -t "$pane" -S -1 2>/dev/null | tail -1)
  if [[ "$role" != agent || ! "$line" =~ ^(\>|╰─❯)\ *$ ]]; then
    tmux send-keys -t "$pane" -l '/'
    exit 0
  fi
  tmux display-menu -t "$pane" -s "$RTIDE_TMUX_MENU_STYLE" \
    -S "$RTIDE_TMUX_MENU_BORDER" -H "$RTIDE_TMUX_MENU_ACTIVE" \
    -T "#[align=centre,fg=${RTIDE_UI_FOCUS},bold] RTIDE · prompt commands" -x 2 -y C \
    "Fork Manager…" f "run-shell '$RTIDE_CMD fork-menu $pane'" \
    "Steer current turn…" s "send-keys -t '$pane' -l '/steer '" \
    "Interrupt current turn" i "send-keys -t '$pane' -l '/interrupt'; send-keys -t '$pane' Enter" \
    "Queue count" q "send-keys -t '$pane' -l '/queue'; send-keys -t '$pane' Enter" \
    "Resend last message" r "send-keys -t '$pane' -l '/resend'; send-keys -t '$pane' Enter" \
    "Show command help" h "send-keys -t '$pane' -l '/help'; send-keys -t '$pane' Enter"
  exit 0
}

cmd_voice_popup() {
  local pane="${2:-}" client="${3:-}"
  [[ -n "$pane" && -n "$client" ]] || exit 1
  # A popup created inside the MouseUp event can inherit that event and close
  # immediately. Let the click finish before attaching the popup to its client.
  sleep 0.15
  tmux display-popup -t "$client" -E -b sharp \
    -s "$RTIDE_TMUX_MENU_STYLE" -S "$RTIDE_TMUX_MENU_BORDER" \
    -x 2 -w 38% -h 25% \
    "sh -c '$RTIDE_LIBEXEC_DIR/dictate \"$pane\"; rc=\$?; [ \$rc -eq 0 ] || read -p \"press Enter to close\"; exit \$rc'"
  exit 0
}

cmd_pane_popup() {
  local client="${2:-}" helper="$RTIDE_LIBEXEC_DIR/pane-popup"
  local active pane role window line
  [[ -x "$helper" ]] || { echo "pane-popup: helper not found: $helper" >&2; exit 1; }

  # A second prefix+z is issued from the nested popup client. Let the original
  # helper restore immediately; the first wrapper invocation will perform the
  # RTIDE layout repair after display-popup returns.
  active=$(tmux show-options -gqv @floating_pane_popup_active 2>/dev/null || true)
  if [[ "$active" == 1 || "$active" == restoring ]]; then
    exec "$helper" request-restore "$client"
  fi

  [[ -n "$client" ]] \
    && pane=$(tmux display-message -p -c "$client" '#{pane_id}' 2>/dev/null || true)
  [[ -n "${pane:-}" ]] || pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)
  [[ -n "$pane" ]] || { echo "pane-popup: no active pane" >&2; exit 1; }
  role=$(tmux display-message -p -t "$pane" '#{@rtide-role}' 2>/dev/null || true)
  window=$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)

  # Once the pane has moved into the popup session, refresh surfaces whose UI
  # depends on pane geometry. nvim and the pane-bound tweb process follow the
  # stable pane ID naturally; an idle readline prompt needs an explicit redraw.
  # Do not call `tweb pin` here: it operates on global floating-browser state
  # and can import an unrelated page into this workspace's tweb pane.
  case "$role" in
    agent)
      (sleep 0.2
       line=$(tmux capture-pane -p -t "$pane" -S -2 2>/dev/null | tail -1)
       [[ "$line" =~ ^(\>|╰─❯) ]] && tmux send-keys -t "$pane" C-l) &
      ;;
  esac

  "$helper" client-toggle "$client"

  # The pane has returned. Restore RTIDE's configured proportions and refresh
  # geometry-dependent surfaces without changing the selected pane.
  if [[ "$role" =~ ^(nvim|tweb|agent)$ ]] \
      && tmux display-message -p -t "$window" '#{window_id}' >/dev/null 2>&1; then
    "$0" refresh-window "$window" >/dev/null 2>&1 || true
    if [[ "$role" == agent ]]; then
      line=$(tmux capture-pane -p -t "$pane" -S -2 2>/dev/null | tail -1)
      [[ "$line" =~ ^(\>|╰─❯) ]] && tmux send-keys -t "$pane" C-l
    fi
  fi
  exit 0
}

# Bind a key in the prefix table only if it's not already bound (don't clobber)
bind_if_free() {
  local key="$1" cmd="$2"
  if ! tmux list-keys -T prefix 2>/dev/null \
    | awk -v k="$key" '$1=="bind-key" && $4==k {found=1} END {exit !found}'; then
    tmux bind-key "$key" "$cmd"
  fi
}

bind_pane_popup() {
  # Preserve the user's floating prefix+z interaction while adding RTIDE's
  # geometry repair around it. Non-RTIDE panes pass through the wrapper.
  tmux bind-key z run-shell "$RTIDE_CMD pane-popup '#{client_name}'"
}

bind_slash_menu() {
  if ! tmux list-keys -T root 2>/dev/null | awk '$1=="bind-key" && $4=="/"{found=1} END{exit !found}'; then
    tmux bind-key -n / if-shell -F '#{==:#{@rtide-role},agent}' \
      "run-shell '$RTIDE_CMD slash-menu #{pane_id}'" "send-keys /"
  fi
}

bind_dictation() {
  tmux set-option -s extended-keys on 2>/dev/null || true
  tmux set-option -s extended-keys-format csi-u 2>/dev/null || true
  tmux bind-key v display-popup -E -b sharp \
    -s "$RTIDE_TMUX_MENU_STYLE" -S "$RTIDE_TMUX_MENU_BORDER" \
    -x 2 -w 38% -h 25% \
    "sh -c '$RTIDE_LIBEXEC_DIR/dictate \"#{pane_id}\"; rc=\$?; [ \$rc -eq 0 ] || read -p \"press Enter to close\"; exit \$rc'"
}

bind_voice_click() {
  # Keep ordinary click-to-focus behavior everywhere except the visible voice
  # control in the prompt pane's rightmost columns. Open on mouse-up so the
  # release belonging to the click cannot immediately dismiss the popup.
  tmux bind-key -n MouseDown1Pane "select-pane -t = ; send-keys -M"
  tmux bind-key -n MouseUp1Pane if-shell \
    "test '#{@rtide-role}' = agent && test '#{mouse_x}' -ge \$((#{pane_left}+#{pane_width}-12))" \
    "run-shell -b '$RTIDE_CMD voice-popup #{pane_id} #{client_name}'" \
    'send-keys -M'
}

# Inspect and recover the workspace output connection.
#   rtide tweb status [dir]      → connected/disconnected/missing/multiple
#   rtide tweb recover [dir]     → reconnect a live pane or repair registration
#   rtide tweb recreate [dir]    → explicit safe creation of the one role pane
cmd_tweb() {
  local sub="${2:-status}" dir="${3:-${RTIDE_WORKSPACE:-$PWD}}" window
  dir=$(realpath -m "$dir")
  RTIDE_WORKSPACE="$dir"
  case "$sub" in
    status)
      rtide_tweb_report
      ;;
    recover)
      rtide_tweb_state
      case "$RTIDE_TWEB_STATE" in
        connected)
          printf 'tweb recover: already connected (%s)\n' "$RTIDE_TWEB_PANE"
          ;;
        disconnected)
          rtide_tweb_reconnect "$RTIDE_TWEB_PANE" "$dir" \
            || { printf 'tweb recover: could not reconnect %s\n' "$RTIDE_TWEB_PANE" >&2; exit 1; }
          printf 'tweb recover: reconnected pane %s\n' "$RTIDE_TWEB_PANE"
          ;;
        missing)
          # Reuse an existing window registration rather than creating a pane.
          window=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
          printf 'tweb recover: pane is missing; run "rtide tweb recreate" to create one\n' >&2
          exit 2
          ;;
        multiple)
          printf 'tweb recover: multiple role=tweb panes; resolve manually\n' >&2
          exit 2
          ;;
        *)
          printf 'tweb recover: no RTIDE workspace context for %s\n' "$dir" >&2
          exit 2
          ;;
      esac
      ;;
    recreate)
      window=$(tmux display-message -p '#{window_id}' 2>/dev/null || true)
      if [[ -z "$window" ]]; then
        # Allow targeting the workspace's own window when run outside tmux.
        window=$(tmux list-windows -a -F '#{window_id} #{@rtide-workspace}' 2>/dev/null \
          | awk -v d="$dir" '$2==d{print $1; exit}')
      fi
      rtide_tweb_recreate "$window" "$dir"
      ;;
    *)
      echo "usage: rtide tweb [status|recover|recreate] [dir]" >&2
      exit 2
      ;;
  esac
  exit 0
}

cmd_workspace_rail() {
  local client="${2:-}" dimensions width height mode x y command
  [[ -n "$client" ]] || client=$(tmux display-message -p '#{client_name}' 2>/dev/null || true)
  [[ -n "$client" ]] || { echo "workspace rail: no invoking tmux client" >&2; return 1; }
  dimensions=$(tmux display-message -p -c "$client" '#{client_width} #{client_height}' 2>/dev/null) \
    || { echo "workspace rail: invoking client is no longer attached" >&2; return 1; }
  read -r width height <<< "$dimensions"
  read -r mode width height x y \
    < <("$RTIDE_LIBEXEC_DIR/workspace-status" geometry "$width" "$height" --shell)
  mode=${mode#mode=}; width=${width#width=}; height=${height#height=}
  x=${x#x=}; y=${y#y=}
  printf -v command '%q rail --client %q' "$RTIDE_LIBEXEC_DIR/workspace-status" "$client"
  tmux display-popup -E -t "$client" -b rounded -x "$x" -y "$y" \
    -w "$width" -h "$height" "$command"
}

case "${1:-}" in
  --version|-V) cmd_version; exit 0 ;;
  --help|-h|help) cmd_help; exit 0 ;;
  version) cmd_version "${2:-}"; exit 0 ;;
  open) shift; run_helper open "$@" ;;
  progress) shift; run_helper progress "$@" ;;
  workspace-status) shift; run_helper workspace-status "$@" ;;
  tweb) cmd_tweb "$@" ;;
  memory) shift; run_helper memory "$@" ;;
  mcp)
    shift
    [[ "${1:-install}" == install ]] || { echo 'usage: rtide mcp [install]' >&2; exit 2; }
    [[ $# -eq 0 ]] || shift
    run_helper mcp "$@"
    ;;
  uninstall) shift; run_helper uninstall "$@" ;;
  render) shift; run_helper render "$@" ;;
  run)
    shift
    [[ "${1:-}" == -- ]] && shift
    run_helper run "$@"
    ;;
  setup)  cmd_setup; exit 0 ;;
  doctor) cmd_doctor; exit 0 ;;
  new)    cmd_new ;;
  fork)
    case "${2:-}" in list|resume|stop|status|finish|memories|remove|repair|migrate) cmd_fork_manager "$@" ;; *) cmd_fork "$@" ;; esac
    exit 0 ;;
  fork-menu) cmd_fork_menu "$@"; exit 0 ;;
  fork-menu-action) cmd_fork_menu_action "$@"; exit 0 ;;
  fork-new-popup) cmd_fork_new_popup "$@"; exit 0 ;;
  switch) cmd_pick ;;
  rail) cmd_workspace_rail "$@" ;;
  zoom)   cmd_zoom "$@" ;;
  ls)     cmd_ls ;;
  sweep)  cmd_sweep ;;
  quit)   cmd_quit "$@" ;;
  kill)   cmd_quit "$@" ;;
  agent)  cmd_agent "$@" ;;
  permissions) cmd_permissions "$@" ;;
  settings) cmd_settings "$@" ;;
  auth)   cmd_auth "$@" ;;
  config) cmd_config "$@" ;;
  refresh) cmd_refresh "$@" ;;
  refresh-window) cmd_refresh_window "$@" ;;
  layout-reset) cmd_layout_reset "$@" ;;
  layout) cmd_layout "$@" ;;
  nvim)   cmd_nvim "$@" ;;
  menu)   cmd_menu "$@" ;;
  history) cmd_history "$@" ;;
  pdf)    cmd_pdf "$@" ;;
  voice-popup) cmd_voice_popup "$@" ;;
  pane-popup) cmd_pane_popup "$@" ;;
  slash-menu) cmd_slash_menu "$@" ;;
  matrix) "$PROVIDER_BIN" matrix; exit 0 ;;
esac

# Load config (run wizard on first run)
[[ -f "$CONFIG" ]] || cmd_setup
load_config_file "$CONFIG"

# Development launchers intentionally default to host access so RTIDE itself
# can exercise tmux. Normal installed workspaces retain the workspace default.
if [[ "$DEV_MODE" == 1 && -n "${RTIDE_DEV_PERMISSION_POLICY:-}" ]]; then
  permission_policy="$RTIDE_DEV_PERMISSION_POLICY"
fi

# legacy: agent= → harness=
harness="${harness:-${agent:-}}"
agent_lines="${agent_lines:-3}"   # agent strip height in lines — minimal input box (status + prompt)
tweb_pct="${tweb_pct:-${nvim_pct:-60}}" # legacy nvim_pct actually controlled tweb width
# A hand-edited or partial config must not abort a launch on unset names.
shell="${shell:-bash}"
auto_float="${auto_float:-false}"
default_dir="${default_dir:-}"
worktree_root="${worktree_root:-}"
permission_policy="${permission_policy:-workspace}"

# Bare `rtide` → pick an active workspace to resume, or start a new one.
if [[ -z "${1:-}" ]]; then
  cmd_pick
fi

DIR="${1:-${default_dir:-$(pwd)}}"
DIR="${DIR/#\~/$HOME}"       # expand a leading ~ (rtide new passes the dir as typed)
DIR="$(realpath -m "$DIR")"  # absolute — relative dirs otherwise break nvim --listen, session path, welcome page

mkdir -p "$DIR"   # create the workspace dir if it doesn't exist yet

# Seed the per-project convention file (never clobber).
[[ -f "$DIR/AGENTS.md" ]] || cp "$TWEB_DIR/AGENTS.md" "$DIR/AGENTS.md"
mkdir -p "$DIR/.tweb"
[[ -f "$DIR/.tweb/template.html" ]] || cp "$TWEB_DIR/template.html" "$DIR/.tweb/template.html"
[[ -f "$DIR/.tweb/DESIGN_PLAYBOOK.md" ]] || cp "$TWEB_DIR/DESIGN_PLAYBOOK.md" "$DIR/.tweb/DESIGN_PLAYBOOK.md"
mkdir -p "$DIR/.tweb/assets"
if [[ ! -f "$DIR/.tweb/assets/rtide-mark.png" ]]; then
  [[ -f "$RTIDE_MARK" ]] || { echo "RTIDE asset missing: rtide-mark.png" >&2; exit 1; }
  cp "$RTIDE_MARK" "$DIR/.tweb/assets/rtide-mark.png"
fi
grep -q '^\.tweb/$' "$DIR/.gitignore" 2>/dev/null || echo '.tweb/' >> "$DIR/.gitignore"
grep -q '^exports/$' "$DIR/.gitignore" 2>/dev/null || echo 'exports/' >> "$DIR/.gitignore"
grep -q '^\.rtide/\*$' "$DIR/.gitignore" 2>/dev/null || {
  printf '.rtide/*\n!.rtide/memory/\n!.rtide/memory/**\n' >> "$DIR/.gitignore"
}
# Seed project memory (committed, like AGENTS.md)
mkdir -p "$DIR/.rtide/memory"
[[ -f "$DIR/.rtide/memory/MEMORY.md" ]] || echo "# Memory index" > "$DIR/.rtide/memory/MEMORY.md"

# Worktree-backed conversation forks require a repository with a real HEAD.
# Initialize only standalone directories; never alter the history/config of an
# existing repository (including a workspace opened from one of its subdirs).
if ! git -C "$DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
  git -C "$DIR" init -b main >/dev/null
  git -C "$DIR" add -A
  git -C "$DIR" -c user.name=RTIDE -c user.email=rtide@local \
    commit --allow-empty -m "Initialize RTIDE workspace" >/dev/null
fi

RUNNING_TARGET=$("$RTIDE_LIBEXEC_DIR/workspace-status" list --tsv 2>/dev/null \
  | awk -F '\t' -v workspace="$DIR" '$2==workspace{print $1; exit}' || true)
if [[ -n "$RUNNING_TARGET" ]]; then
  S=${RUNNING_TARGET%%:*}
  resume_session "$S" "$RUNNING_TARGET" \
    || echo "could not open $S — attach with: tmux attach -t $S" >&2
  exit 0
fi
WORKSPACE_KEY=$(printf '%s' "$DIR" | sha256sum | cut -c1-8)
S="${SESSION_PREFIX}$(basename "$DIR")-$WORKSPACE_KEY"

# Per-workspace override + always-ask selection (new workspace)
WS_AGENT="$DIR/$WS_AGENT_FILE"
load_config_file "$WS_AGENT"
harness="${harness:-${agent:-}}"
if [[ "${RTIDE_ASK:-1}" != "0" ]]; then
  prompt_selection "${provider:-}" "${harness:-}" "${model:-}" "${permission_policy:-workspace}"
  provider="$PROVIDER"; harness="$HARNESS"; model="$MODEL"; permission_policy="$PERMISSION_POLICY"
  "$SETTINGS_BIN" --config "$CONFIG" set --scope workspace "$DIR" \
    "provider=$provider" "harness=$harness" "model=$model" \
    "permission_policy=$permission_policy" >/dev/null
fi

# Validate the combo before launching. A stale config (e.g. agent=claude +
# provider=openai from the original defaults) is auto-corrected rather than
# refusing to start.
if ! "$PROVIDER_BIN" compat "$provider" 2>/dev/null | grep -qw "$harness"; then
  fixed=$("$PROVIDER_BIN" compat_h "$harness" 2>/dev/null | awk '{print $1}')
  if [[ -n "$fixed" ]]; then
    echo "note: $harness is not compatible with $provider — using $fixed"
    provider="$fixed"
  else
    echo "error: $harness is not compatible with $provider (see 'rtide matrix')" >&2
    exit 1
  fi
fi

# The agent pane runs the minimal input-box wrapper (rtide-agent), which
# invokes the harness non-interactively per request and renders to tweb.
permission_policy="${permission_policy:-${RTIDE_DEV_PERMISSION_POLICY:-workspace}}"
AGENT_CMD="$RTIDE_AGENT_CMD $harness $provider $model $DIR $permission_policy"

# Record startup-effective non-agent settings before surfaces launch. The agent
# process adds its identity, policy, and PID only after it is actually running.
"$SETTINGS_BIN" publish "$DIR" "agent_lines=$agent_lines" "tweb_pct=$tweb_pct" \
  "shell=$shell" "auto_float=${auto_float:-false}" "default_dir=${default_dir:-}" \
  "worktree_root=${worktree_root:-}" >/dev/null

# Build the layout with pane IDs (index-agnostic — respects base-index settings).
# Each pane gets a pane-scoped @rtide-role option (survives title changes by apps).
# Build at the receiving client's real size. Otherwise tmux creates the
# detached window at 80x24 and proportionally inflates a 3-line agent strip
# when a larger client attaches.
START_W=""
START_H=""
if [[ -n "${TMUX:-}" ]]; then
  START_W=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
  START_H=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)
fi
[[ "$START_W" =~ ^[0-9]+$ ]] || START_W=$(tput cols 2>/dev/null || echo 80)
[[ "$START_H" =~ ^[0-9]+$ ]] || START_H=$(tput lines 2>/dev/null || echo 24)
[[ "$START_W" =~ ^[0-9]+$ ]] || START_W=80
[[ "$START_H" =~ ^[0-9]+$ ]] || START_H=24
# A detached `make dev` may be the first RTIDE command in this tmux server.
# Create the server before applying global options so first-run launches work
# outside an existing tmux session too.
tmux new-session -d -x "$START_W" -y "$START_H" -s "$S" -n work -c "$DIR"
tmux set-option -t "$S" allow-passthrough all
tmux set-option -g mouse on
tmux set-option -w -t "$S:work" @rtide-workspace "$DIR"
tmux set-option -w -t "$S:work" @rtide-window-name work
tmux set-option -w -t "$S:work" automatic-rename off
tmux set-environment -t "$S" RTIDE_DEV_MODE "$DEV_MODE"
tmux set-environment -t "$S" RTIDE_DEV_LABEL "$DEV_LABEL"
rtide_tmux_chrome "$S" "$S:work" "$DEV_MODE" \
  "$(tr -d '[:space:]' < "$RTIDE_ROOT/VERSION")" "$DEV_LABEL"
NVIM_PANE=$(tmux list-panes -t "$S:work" -F '#{pane_id}' | head -1)
tmux set-option -p -t "$NVIM_PANE" @rtide-role nvim
tmux select-pane -t "$NVIM_PANE" -T editor
tmux send-keys -t "$NVIM_PANE" "$(rtide_nvim_command "$DIR" "$shell")" Enter
tmux split-window -v -t "$NVIM_PANE" -l "$agent_lines" -c "$DIR"
AGENT_PANE=$(tmux display-message -p -t "$S:work" '#{pane_id}')   # new pane is active after split
tmux set-option -p -t "$AGENT_PANE" @rtide-role agent
tmux select-pane -t "$AGENT_PANE" -T composer
tmux split-window -h -t "$NVIM_PANE" -p "$tweb_pct" -c "$DIR"
TWEB_PANE=$(tmux display-message -p -t "$S:work" '#{pane_id}')
tmux set-option -p -t "$TWEB_PANE" @rtide-role tweb
tmux select-pane -t "$TWEB_PANE" -T output
# Stable routing for harness command runners that do not inherit TMUX_PANE.
printf '%s\n' "$TWEB_PANE" > "$DIR/.rtide/tweb-pane"
# generate the per-workspace welcome page, then open it in tweb
python3 - "$TWEB_DIR/welcome.html" "$DIR/.tweb/welcome.html" "$S" "$DIR" "$provider" "$harness" "$model" "$DEV_MODE" "$DEV_LABEL" <<'PY'
import sys, datetime
tpl, out, ws, path, prov, harness, model, dev_mode, dev_label = sys.argv[1:10]
html = open(tpl).read()
for k, v in [("{{WORKSPACE}}", ws), ("{{PATH}}", path), ("{{PROVIDER}}", prov),
             ("{{HARNESS}}", harness), ("{{MODEL}}", model),
             ("{{DEV_CLASS}}", "dev" if dev_mode == "1" else ""),
             ("{{DEV_LABEL}}", dev_label),
             ("{{DATE}}", datetime.date.today().isoformat())]:
    html = html.replace(k, v)
open(out, "w").write(html)
PY
tmux send-keys -t "$TWEB_PANE" "tweb open file://$DIR/.tweb/welcome.html" Enter
find "$DIR/.rtide/agent-ready" -maxdepth 0 -type f -delete 2>/dev/null || true

# TWeb must be connected before the agent accepts a request. Otherwise the
# first response can finish while the browser is still registering with twebd,
# leaving the user with a successful-looking turn and no visible output.
printf 'starting %s…\n' "$S"
READY_NVIM=0 READY_TWEB=0
READY_DEADLINE=$((SECONDS + 15))
while (( SECONDS < READY_DEADLINE )); do
  [[ -n "$(rtide_locate_nvim_socket "$DIR" 2>/dev/null || true)" ]] && READY_NVIM=1
  tweb status --pane "$TWEB_PANE" 2>/dev/null \
    | grep -Fq "file://$DIR/.tweb/welcome.html" && READY_TWEB=1 || true
  (( READY_NVIM && READY_TWEB )) && break
  sleep 0.1
done

# Finish the pane geometry before exposing the agent prompt. Resizing after the
# prompt becomes usable can leave Electron holding a stale paint buffer, which
# TWeb correctly refuses to display at the new dimensions.
tmux resize-window -t "$S:work" -x "$START_W" -y "$START_H" 2>/dev/null || true
apply_window_layout "$S:work" auto >/dev/null
# A reload requests a fresh paint at the final pane dimensions after the
# launch-time resize, avoiding a stale frame-size race in the Electron engine.
tweb reload --pane "$TWEB_PANE" >/dev/null 2>&1 || true
tweb wait --pane "$TWEB_PANE" --load >/dev/null 2>&1 || true
rtide_tweb_controls "$TWEB_PANE"

# Only now start the agent prompt. It may still take a moment to initialize,
# but any submitted request has a connected TWeb destination by construction.
tmux send-keys -t "$AGENT_PANE" "$AGENT_CMD" Enter
READY_AGENT=0
READY_DEADLINE=$((SECONDS + 15))
while (( SECONDS < READY_DEADLINE )); do
  if [[ -f "$DIR/.rtide/agent-ready" ]]; then
    READY_AGENT=1
  else
    tmux capture-pane -p -t "$AGENT_PANE" -S -10 2>/dev/null \
      | grep -Fq '● ready' && READY_AGENT=1 || true
  fi
  (( READY_AGENT )) && break
  sleep 0.1
done

if ! (( READY_NVIM && READY_TWEB && READY_AGENT )); then
  printf 'warning: workspace opened before all surfaces became ready (nvim=%s tweb=%s agent=%s)\n' \
    "$READY_NVIM" "$READY_TWEB" "$READY_AGENT" >&2
fi
# Global bindings that resolve panes by title in the current session at press-time
bind_if_free t "run-shell '$RTIDE_CMD zoom tweb'"
bind_if_free a "run-shell '$RTIDE_CMD zoom agent'"
bind_pane_popup
bind_dictation
bind_voice_click
bind_if_free r "run-shell '$RTIDE_CMD switch'"
bind_if_free w "run-shell '$RTIDE_CMD rail #{client_name}'"
bind_if_free Q "confirm-before -p 'quit workspace? (y/n) ' \"run-shell '$RTIDE_CMD quit #{session_name}'\""
bind_if_free R "run-shell '$RTIDE_CMD refresh-window #{window_id}'"
  tmux bind-key A run-shell "$RTIDE_CMD menu '#{session_name}' '#{window_id}' '#{client_name}'"
bind_if_free e "run-shell '$RTIDE_CMD nvim toggle #{window_id}'"
bind_slash_menu
install_session_hooks "$S"
tmux select-window -t "$S:work"
# A new workspace opens ready for the user's first request. Existing workspace
# resumes still return to the editor via resume_session().
tmux select-pane -t "$AGENT_PANE"
if [[ -z "${TMUX:-}" ]]; then
  tmux attach -t "$S" 2>/dev/null || echo "workspace $S created — attach with: tmux attach -t $S"
else
  tmux switch-client -t "$S" 2>/dev/null || echo "workspace $S created — attach with: tmux attach -t $S"
fi
