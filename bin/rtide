#!/usr/bin/env bash
# rtide — Rich Terminal IDE workspace launcher.
#   rtide            → pick an active workspace to resume, or start a new one
#   rtide <dir>      → launch/attach the workspace for <dir>
#   rtide new        → guided new workspace
#   rtide switch     → same picker as bare rtide (resume / new)
#   rtide ls         → list workspaces
#   rtide sweep      → capture pending MEM: memories from every live session
#   rtide quit [dir] → sweep that session's memories, then kill it (from inside or out)
#   rtide kill [dir] → alias for quit
#   rtide agent      → re-pick provider/harness/model for the current workspace
#   rtide config     → view/edit/reset the global config (set key=value, reset [layout|agent|all])
#   rtide refresh    → apply the global config's layout to a running workspace (prefix+R)
#   rtide nvim       → hide/show the editor pane while keeping tweb + prompt visible
#   rtide menu       → quick-switcher menu (prefix+A)
#   rtide history    → open the current workspace's output history
#   rtide auth       → check auth for the configured provider
#   rtide matrix     → print the provider×harness compatibility matrix
#   rtide setup      → re-run the wizard
#   rtide doctor     → verify deps
#   rtide --no-ask   → skip the provider/harness prompt (use stored config)
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PROVIDER_BIN="$SELF_DIR/rtide-provider"
TWEB_DIR="$HOME/rtide/share"
CONFIG_DIR="$HOME/.rtide"
CONFIG="$CONFIG_DIR/config"
WS_AGENT_FILE=".rtide/agent"   # per-workspace override, relative to the workspace dir

if [[ "${1:-}" == "--no-ask" ]]; then RTIDE_ASK=0; shift; fi

# --- provider/harness selection -------------------------------------------

installed_harnesses() {
  local out=()
  for a in claude codex hermes opencode; do
    command -v "$a" >/dev/null 2>&1 && out+=("$a")
  done
  echo "${out[*]}"
}

# providers that have at least one installed compatible harness
providers_for_installed() {
  local installed out
  installed=$(installed_harnesses)
  out=()
  for p in anthropic openai ollama; do
    for h in $("$PROVIDER_BIN" compat "$p"); do
      [[ " $installed " == *" $h "* ]] && { out+=("$p"); break; }
    done
  done
  echo "${out[*]}"
}

# pick <prompt> <default> <choices...> — fzf picker when available, else numbered list.
# Free text is allowed: with fzf, a query that matches nothing is used as the answer.
pick() {
  local prompt="$1" def="$2"; shift 2
  local choices=("$@")
  if [[ ${#choices[@]} -eq 0 ]]; then
    local ans
    read -rp "$prompt [$def]: " ans
    echo "${ans:-$def}"
    return
  fi
  if [[ ${#choices[@]} -eq 1 ]]; then
    echo "${choices[0]}"
    return
  fi
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    local out sel qry
    local items=("${choices[@]}")
    # put the default first so it's highlighted — Enter accepts it, typing filters normally
    if printf '%s\n' "${choices[@]}" | grep -Fxq "$def"; then
      items=("$def")
      for c in "${choices[@]}"; do [[ "$c" != "$def" ]] && items+=("$c"); done
    fi
    out=$(printf '%s\n' "${items[@]}" | fzf --prompt="$prompt: " --height=40% --border --print-query)
    sel=$(printf '%s\n' "$out" | tail -1)
    if printf '%s\n' "${choices[@]}" | grep -Fxq "$sel"; then
      echo "$sel"
    else
      qry=$(printf '%s\n' "$out" | head -1)
      echo "${qry:-$def}"
    fi
    return
  fi
  # fallback: numbered list, type number/name/Enter
  local i=0
  for c in "${choices[@]}"; do
    i=$((i+1))
    echo "  $i) $c" >&2
  done
  local ans
  read -rp "$prompt [$def]: " ans
  ans="${ans:-$def}"
  if [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#choices[@]} )); then
    ans="${choices[$((ans-1))]}"
  fi
  echo "$ans"
}

# prompt_selection <cur_provider> <cur_harness> <cur_model> — sets PROVIDER/HARNESS/MODEL
PROVIDER=""; HARNESS=""; MODEL=""
prompt_selection() {
  local installed providers avail models
  installed=$(installed_harnesses)
  providers=$(providers_for_installed)
  [[ -n "$providers" ]] || { echo "no agents found — install one first"; exit 1; }
  # provider — default to the current one if it's still available
  [[ " $providers " == *" $1 "* ]] && PROVIDER="$1" || PROVIDER=""
  PROVIDER=$(pick "AI provider" "${PROVIDER:-$(echo "$providers" | awk '{print $1}')}" $providers)
  # harness (installed + compatible with the chosen provider)
  avail=()
  for h in $("$PROVIDER_BIN" compat "$PROVIDER"); do
    [[ " $installed " == *" $h "* ]] && avail+=("$h")
  done
  [[ " ${avail[*]} " == *" $2 "* ]] && HARNESS="$2" || HARNESS=""
  HARNESS=$(pick "Harness" "${HARNESS:-${avail[0]}}" "${avail[@]}")
  # model — default to the current one (free text allowed, so no availability check)
  models=$("$PROVIDER_BIN" models "$PROVIDER")
  MODEL=$(pick "Model" "${3:-$(echo "$models" | awk '{print $1}')}" $models)
}

# --- commands --------------------------------------------------------------

setup_wizard() {
  echo "==> RTIDE setup"
  local installed; installed=$(installed_harnesses)
  [[ -n "$installed" ]] || { echo "no agents found — install one first"; exit 1; }
  echo "Installed agents: $installed"
  prompt_selection "${provider:-}" "${harness:-${agent:-}}" "${model:-}"
  read -rp "Default directory (empty = current dir): " default_dir
  read -rp "Agent strip lines [3]: " agent_lines
  agent_lines="${agent_lines:-3}"
  read -rp "tweb width % [60]: " tweb_pct
  tweb_pct="${tweb_pct:-60}"
  local shells=()
  for s in fish zsh nushell bash; do
    command -v "$s" >/dev/null 2>&1 && shells+=("$s")
  done
  local def_shell=fish
  command -v fish >/dev/null 2>&1 || def_shell=zsh
  read -rp "Shell for running programs [$def_shell]: " shell
  shell="${shell:-$def_shell}"
  command -v "$shell" >/dev/null 2>&1 || echo "note: $shell not on PATH — install it (e.g. sudo apt install $shell)"
  read -rp "Auto-float dense content? [y/N]: " af
  local auto_float=false
  [[ "$af" =~ ^[yY] ]] && auto_float=true
  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG" <<EOF
# RTIDE config
provider=$PROVIDER
harness=$HARNESS
model=$MODEL
default_dir=$default_dir
agent_lines=$agent_lines
tweb_pct=$tweb_pct
shell=$shell
auto_float=$auto_float
EOF
  echo "Saved to $CONFIG"
}

cmd_doctor() {
  local ok=1
  for c in tweb tmux nvim; do
    command -v "$c" >/dev/null 2>&1 || { echo "MISSING: $c"; ok=0; }
  done
  if command -v tweb >/dev/null 2>&1; then
    tweb doctor || ok=0
  fi
  command -v kitty >/dev/null 2>&1 || command -v ghostty >/dev/null 2>&1 \
    || { echo "MISSING: kitty or ghostty (terminal)"; ok=0; }
  tmux -V 2>/dev/null | grep -qE '3\.[3-9]' || echo "WARN: tmux < 3.3 (tweb requires 3.3+)"
  local found=0
  for a in claude codex hermes opencode; do
    command -v "$a" >/dev/null 2>&1 && { echo "agent: $a"; found=1; }
  done
  [[ $found -eq 0 ]] && { echo "MISSING: no agent (claude/codex/hermes/opencode)"; ok=0; }
  for s in fish zsh nushell bash; do
    command -v "$s" >/dev/null 2>&1 && echo "shell: $s"
  done
  if [[ -f "$CONFIG" ]]; then
    source "$CONFIG"
    local p="${provider:-}"
    if [[ -n "$p" ]]; then
      echo "provider: $p"
      "$PROVIDER_BIN" check "$p" || ok=0
    fi
  fi
  if [[ $ok -eq 1 ]]; then echo "doctor: all good"; fi
  return $((1 - ok))
}

cmd_new() {
  read -rp "Directory for new workspace (empty = current): " ndir
  ndir="${ndir:-$(pwd)}"
  exec "$0" "$ndir"
}

install_session_hooks() {
  local sess="$1" quoted tweb workspace
  printf -v quoted '%q' "$sess"
  # Creating the detached workspace at an explicit startup size leaves tmux in
  # `window-size manual`. Return it to client-driven sizing before attach so a
  # maximize, restore, or terminal resize changes the actual window canvas.
  tmux set-option -w -t "$sess:work" window-size latest 2>/dev/null || true
  tweb=$(tmux list-panes -t "$sess:work" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
    | awk '$2=="tweb"{print $1; exit}')
  if [[ -n "$tweb" ]]; then
    workspace=$(tmux display-message -p -t "$tweb" '#{pane_current_path}' 2>/dev/null || true)
    if [[ -d "$workspace/.rtide" ]]; then
      printf '%s\n' "$tweb" > "$workspace/.rtide/tweb-pane"
    fi
  fi
  # Terminal maximize/restore changes the tmux window size proportionally.
  # Reapply RTIDE's exact strip height and column split after each client resize.
  tmux set-hook -t "$sess" client-resized \
    "run-shell 'rtide refresh $quoted >/dev/null 2>&1'" 2>/dev/null || true
  # after-resize-window is the authoritative geometry event on tmux 3.6 and
  # also covers programmatic/terminal-driven window changes.
  tmux set-hook -t "$sess" after-resize-window \
    "run-shell 'rtide refresh $quoted >/dev/null 2>&1'" 2>/dev/null || true
}

# Resume a workspace on its editor pane. tmux remembers the last active pane
# per session, which is often the agent input strip; selecting the workspace
# should consistently return the user to the main editing surface instead.
resume_session() {
  local sess="$1" pane
  # RTIDE relies on mouse events for pane focus, border resizing, and tweb.
  # Re-enable it in case the global prefix+m toggle disabled it at runtime.
  tmux set-option -g mouse on 2>/dev/null || true
  install_session_hooks "$sess"
  pane=$(tmux list-panes -s -t "$sess" -F '#{pane_id}' -f '#{==:#{@rtide-role},nvim}' 2>/dev/null | head -1)
  if [[ -n "$pane" ]]; then
    # The editor may live in a non-current window if the user added windows.
    tmux select-window -t "$pane" 2>/dev/null || true
    tmux select-pane -t "$pane" 2>/dev/null || true
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$sess"
  else
    tmux attach-session -t "$sess"
  fi
}

# Pick a workspace to resume (or start a new one). Used by bare `rtide` and
# `rtide switch`. Sessions are listed with their directory (`#{session_path}` —
# every workspace is created with `-c "$DIR"`); the one matching the current
# working directory is sorted first and marked, so Enter resumes it directly.
# Typing a name that matches nothing only searches — creation happens via the
# `+ new workspace` row (or typing `new`), never by typing an unknown name.
cmd_pick() {
  local sessions cur s dir sdir disp
  local -a items=()
  sessions=$(tmux list-sessions -F "#{session_name}"$'\t'"#{session_path}" 2>/dev/null | grep '^rtide-' || true)
  if [[ -z "$sessions" ]]; then
    echo "no workspaces — start a new one"
    exec "$0" new
  fi
  cur=$(realpath -m "$PWD")
  local DIM=$'\033[2m' YEL=$'\033[33m' CYAN=$'\033[36m' RESET=$'\033[0m'
  while IFS=$'\t' read -r s dir; do
    # Prefer the first pane's real path — session_path can be stale/relative
    # (workspaces created before paths were normalized) and would otherwise
    # resolve against the picker's own cwd, not the workspace's.
    pdir=$(tmux list-panes -t "$s" -F '#{pane_current_path}' 2>/dev/null | head -1)
    sdir=$(realpath -m "${pdir:-$dir}")
    disp="${DIM}${sdir/#$HOME/~}${RESET}"
    if [[ "$sdir" == "$cur" ]]; then
      # current dir first (fzf preselects line 1 → Enter resumes it)
      items=("$s"$'\t'"$disp"$'\t'"${YEL}◀ you are here${RESET}" "${items[@]}")
    else
      items+=("$s"$'\t'"$disp")
    fi
  done <<< "$sessions"
  items+=("${CYAN}+${RESET} new workspace")

  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    local out qry sel sess rc
    while true; do
      # `if` so `set -e` doesn't kill us on fzf's non-zero exits; rc tells
      # abort (130 = Esc/Ctrl-C) apart from no-match (1 = Enter on a query
      # that filtered everything out).
      if out=$(printf '%s\n' "${items[@]}" | fzf --ansi --print-query \
            --no-sort --layout=reverse --header-first \
            --header=$'RTIDE — resume a workspace\nEnter = open   type "new" + Enter = start one   Esc = quit' \
            --prompt='❯ ' --height=60% --border \
            --preview-window=right:40% \
            --preview 's={1}; if tmux has-session -t "$s" 2>/dev/null; then d=$(tmux list-panes -t "$s" -F "#{pane_current_path}" 2>/dev/null | head -1); [ -z "$d" ] && d=$(tmux display-message -p -t "$s" "#{session_path}"); echo "dir: $d"; [ -f "$d/.rtide/agent" ] && { echo; echo "agent:"; sed "s/^/    /" "$d/.rtide/agent"; }; act=$(tmux display-message -p -t "$s" "#{session_activity}"); [ -n "$act" ] && act=$(date -d "@$act" "+%H:%M  %a %d %b"); echo; echo "last: ${act:-?}   ·   $(tmux display-message -p -t "$s" "#{session_windows}")w  $(tmux display-message -p -t "$s" "#{session_attached}")attached"; tmux list-panes -t "$s" -F "    #{@rtide-role}   #{pane_width}x#{pane_height}"; else echo "start a new workspace (Enter)"; fi' ); then
        rc=0
      else
        rc=$?
      fi
      (( rc == 130 )) && exit 0      # Esc / Ctrl-C → quit
      qry=$(printf '%s\n' "$out" | head -1)
      sel=$(printf '%s\n' "$out" | tail -1)
      [[ -z "$sel" ]] && exit 0      # empty selection
      if [[ "$sel" == *"new workspace"* ]]; then
        # The create row itself is fuzzy-searchable: e.g. "nope" matches
        # n→o→p→e in "new workspace". Only an empty query (the user moved
        # onto the row) or an explicit "new…" query expresses create intent.
        if [[ -z "$qry" || "$qry" == new* ]]; then
          exec "$0" new
        fi
      else
        sess=$(printf '%s' "$sel" | cut -f1)
        if tmux has-session -t "$sess" 2>/dev/null; then
          resume_session "$sess" \
            || echo "could not open $sess — attach with: tmux attach -t $sess" >&2
          exit 0
        fi
      fi
      # No match, including accidental fuzzy matches against the create row:
      # unknown names search only and never create.
      printf "no workspace matches '%s' — type 'new' to create one\n" "$qry" >&2
      sleep 1
    done
  elif [[ -t 0 ]]; then
    # fallback: numbered list (accept number or session name), Enter = first
    local i=0 line ans
    for line in "${items[@]}"; do
      i=$((i+1))
      printf '  %d) %s\n' "$i" "$(printf '%s' "$line" | sed -e 's/\x1b\[[0-9;]*m//g' | tr '\t' '  ')"
    done
    read -rp "Pick a workspace [1]: " ans
    ans="${ans:-1}"
    if [[ "$ans" == "new" ]]; then
      exec "$0" new
    elif [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#items[@]} )); then
      sel="${items[$((ans-1))]}"
    else
      sel=$(printf '%s\n' "${items[@]}" | awk -F '\t' -v n="$ans" '$1==n{print; exit}')
    fi
    if [[ "$sel" == *"new workspace"* ]]; then
      exec "$0" new
    fi
    if [[ -n "$sel" ]]; then
      sess=$(printf '%s' "$sel" | cut -f1)
      resume_session "$sess" \
        || echo "could not open $sess — attach with: tmux attach -t $sess" >&2
    else
      printf "no workspace matches '%s' — type 'new' to create one\n" "$ans" >&2
      exit 1
    fi
    exit 0
  else
    # non-interactive (e.g. `prefix+r` → run-shell): show the list, take no action
    local line
    for line in "${items[@]}"; do
      printf '%s\n' "$(printf '%s' "$line" | sed -e 's/\x1b\[[0-9;]*m//g' | tr '\t' '  ')"
    done
    exit 0
  fi
}

cmd_ls() {
  tmux list-sessions -F '#{session_name}  #{session_windows}w  #{session_attached}attached' 2>/dev/null \
    | grep '^rtide-' || echo "no workspaces"
  exit 0
}

cmd_sweep() {
  local s
  for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^rtide-'); do
    rtide-mem sweep "$s"
  done
  exit 0
}

# quit [dir|session] — sweep the workspace's memories, then kill it.
# No arg: the current tmux session (or the dir we're in). Only kills rtide workspaces.
cmd_quit() {
  local arg="${2:-}" target
  if [[ -n "$arg" ]]; then
    # A session name wins; anything else is a directory (whose basename may
    # itself start with "rtide-", e.g. a project called rtide-proj).
    if tmux has-session -t "$arg" 2>/dev/null; then
      target="$arg"
    else
      target="rtide-$(basename "$arg")"
    fi
  else
    target=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    [[ "$target" == rtide-* ]] || target="rtide-$(basename "$(pwd)")"
  fi
  if ! tmux has-session -t "$target" 2>/dev/null; then
    echo "no workspace: $target" >&2
    exit 1
  fi
  if ! tmux list-windows -t "$target" -F '#{window_name}' 2>/dev/null | grep -qx work; then
    echo "not an rtide workspace: $target" >&2
    exit 1
  fi
  rtide-mem sweep "$target" 2>/dev/null || true   # capture pending memories first
  tmux kill-session -t "$target"
  echo "quit: $target"
  exit 0
}

cmd_zoom() {
  local role="${2:?usage: rtide zoom <nvim|agent|tweb>}"
  local sess pane active
  sess=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  [[ -n "$sess" ]] || { echo "not in a tmux session"; exit 1; }
  pane=$(tmux list-panes -t "$sess:work" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
    | awk -v r="$role" '$2==r{print $1; exit}')
  [[ -n "$pane" ]] || { echo "no '$role' pane in $sess"; exit 1; }
  active=$(tmux display-message -p -t "$sess:work" '#{pane_id}')
  # resize-pane -Z toggles: if another pane is zoomed, unzoom it first, then zoom the target
  if [[ "$(tmux display-message -p -t "$sess:work" '#{window_zoomed_flag}')" == "1" ]]; then
    tmux resize-pane -Z -t "$active"
    [[ "$active" == "$pane" ]] && exit 0   # was toggling the target off
  fi
  tmux resize-pane -Z -t "$pane"
  exit 0
}

# Re-pick provider/harness/model for a workspace and restart its agent pane.
cmd_agent() {
  local dir="${2:-$(pwd)}"
  [[ -f "$CONFIG" ]] && source "$CONFIG"
  local ws="$dir/$WS_AGENT_FILE"
  [[ -f "$ws" ]] && source "$ws"
  prompt_selection "${provider:-}" "${harness:-${agent:-}}" "${model:-}"
  provider="$PROVIDER"; harness="$HARNESS"; model="$MODEL"
  mkdir -p "$(dirname "$ws")"
  cat > "$ws" <<EOF
provider=$provider
harness=$harness
model=$model
EOF
  echo "agent: $harness + $provider ($model) for $dir"
  local sess="rtide-$(basename "$dir")"
  if tmux has-session -t "$sess" 2>/dev/null; then
    local pane
    pane=$(tmux list-panes -t "$sess:work" -F '#{pane_id} #{@rtide-role}' 2>/dev/null \
      | awk '$2=="agent"{print $1; exit}')
    if [[ -n "$pane" ]]; then
      tmux send-keys -t "$pane" C-c
      tmux send-keys -t "$pane" "rtide-agent $harness $provider $model $dir" Enter
      echo "restarted agent pane in $sess"
    fi
  fi
  exit 0
}

cmd_auth() {
  [[ -f "$CONFIG" ]] && source "$CONFIG"
  local p="${2:-${provider:-}}"
  [[ -n "$p" ]] || { echo "no provider configured — run 'rtide setup' or 'rtide agent'"; exit 1; }
  local rc=0
  "$PROVIDER_BIN" check "$p" || rc=$?
  exit $rc
}

# --- config & refresh -------------------------------------------------------

CONFIG_KEYS="provider harness model default_dir agent_lines tweb_pct shell auto_float"

# Rewrite ~/.rtide/config from the current shell vars (only known keys).
write_global_config() {
  local key
  {
    echo "# RTIDE config"
    for key in $CONFIG_KEYS; do
      echo "$key=${!key}"
    done
  } > "$CONFIG"
}

# View / edit / reset the global config (source of truth for layout; the combo
# is per-workspace in .rtide/agent and managed by `rtide agent`).
#   rtide config                        → show settings
#   rtide config set k=v [k=v…]         → update keys
#   rtide config reset [layout|agent|all] → restore built-in defaults (default: layout)
cmd_config() {
  local sub="${2:-}" key val scope def
  [[ -f "$CONFIG" ]] && source "$CONFIG"
  tweb_pct="${tweb_pct:-${nvim_pct:-60}}"
  case "$sub" in
    "")
      printf 'agent  %-12s %s\n' provider "$provider"
      printf 'agent  %-12s %s\n' harness "$harness"
      printf 'agent  %-12s %s\n' model "$model"
      printf 'layout %-12s %s\n' agent_lines "${agent_lines:-3}"
      printf 'layout %-12s %s\n' tweb_pct "$tweb_pct"
      printf 'layout %-12s %s\n' shell "$shell"
      printf 'layout %-12s %s\n' auto_float "$auto_float"
      printf 'misc   %-12s %s\n' default_dir "$default_dir"
      ;;
    set)
      shift 2
      [[ $# -gt 0 ]] || { echo "usage: rtide config set key=value [key=value…]"; exit 1; }
      for kv in "$@"; do
        key="${kv%%=*}"; val="${kv#*=}"
        [[ "$key" == "$kv" || -z "$key" ]] && { echo "config error: bad assignment '$kv' (want key=value)" >&2; exit 1; }
        case "$key" in
          provider|harness|model|default_dir|shell) ;;
          agent_lines)
            [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1 )) \
              || { echo "config error: agent_lines must be a positive integer" >&2; exit 1; } ;;
          tweb_pct)
            [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1 && val <= 99 )) \
              || { echo "config error: tweb_pct must be an integer 1-99" >&2; exit 1; } ;;
          auto_float)
            [[ "$val" =~ ^(true|false)$ ]] \
              || { echo "config error: auto_float must be true or false" >&2; exit 1; } ;;
          *) echo "config error: unknown key '$key' (known: $CONFIG_KEYS)" >&2; exit 1 ;;
        esac
        printf -v "$key" '%s' "$val"
      done
      write_global_config
      echo "config: updated $CONFIG"
      ;;
    reset)
      scope="${3:-layout}"
      def=fish
      command -v fish >/dev/null 2>&1 || def=zsh
      case "$scope" in
        layout) agent_lines=3; tweb_pct=60; auto_float=false; shell="$def" ;;
        agent)  provider=""; harness=""; model="" ;;
        all)    provider=""; harness=""; model=""; agent_lines=3; tweb_pct=60; auto_float=false; shell="$def" ;;
        *) echo "usage: rtide config reset [layout|agent|all]" >&2; exit 1 ;;
      esac
      write_global_config
      echo "config: reset $scope — run 'rtide refresh <workspace>' to apply"
      ;;
    *)
      echo "usage: rtide config [set key=value… | reset [layout|agent|all]]" >&2
      exit 1
      ;;
  esac
  exit 0
}

# Apply the current global config's layout to a running workspace's panes.
#   rtide refresh [session|dir]   (no arg → current session; prefix+R passes #{session_name})
cmd_refresh() {
  local arg="${2:-}" sess agent nvim tweb workspace w tw hidden changed=""
  if [[ -n "$arg" ]]; then
    # A session name wins; anything else is a directory (basename may itself be rtide-*).
    if tmux has-session -t "$arg" 2>/dev/null; then
      sess="$arg"
    else
      sess="rtide-$(basename "$arg")"
    fi
  else
    sess=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  fi
  [[ -n "$sess" ]] || { echo "refresh: not in a tmux session — pass a session: rtide refresh <dir|session>" >&2; exit 1; }
  tmux has-session -t "$sess" 2>/dev/null || { echo "refresh: no workspace: $sess" >&2; exit 1; }
  tmux list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | grep -qx work \
    || { echo "refresh: not an rtide workspace: $sess" >&2; exit 1; }

  [[ -f "$CONFIG" ]] && source "$CONFIG"
  agent_lines="${agent_lines:-3}"
  tweb_pct="${tweb_pct:-${nvim_pct:-60}}"

  # Refresh always restores client-relative sizing. This also repairs older
  # sessions created while RTIDE left their tmux window in manual-size mode.
  tmux set-option -w -t "$sess:work" window-size latest 2>/dev/null || true

  # unzoom first if a pane is zoomed, so the resize targets the real layout
  if [[ "$(tmux display-message -p -t "$sess:work" '#{window_zoomed_flag}')" == "1" ]]; then
    tmux resize-pane -Z -t "$(tmux display-message -p -t "$sess:work" '#{pane_id}')"
  fi

  agent=$(tmux list-panes -t "$sess:work" -F '#{pane_id} #{@rtide-role}' 2>/dev/null | awk '$2=="agent"{print $1; exit}')
  nvim=$(tmux list-panes -t "$sess:work" -F '#{pane_id} #{@rtide-role}' 2>/dev/null | awk '$2=="nvim"{print $1; exit}')
  tweb=$(tmux list-panes -t "$sess:work" -F '#{pane_id} #{@rtide-role}' 2>/dev/null | awk '$2=="tweb"{print $1; exit}')
  if [[ -n "$tweb" ]]; then
    workspace=$(tmux display-message -p -t "$tweb" '#{pane_current_path}' 2>/dev/null || true)
    if [[ -d "$workspace/.rtide" ]]; then
      printf '%s\n' "$tweb" > "$workspace/.rtide/tweb-pane"
    fi
  fi
  w=$(tmux display-message -p -t "$sess:work" '#{window_width}' 2>/dev/null || echo 80)
  tw=$(( w * tweb_pct / 100 )); (( tw < 10 )) && tw=10
  hidden=$(tmux show-options -v -t "$sess" @rtide-nvim-hidden 2>/dev/null || true)

  if [[ -n "$agent" ]]; then
    tmux resize-pane -t "$agent" -y "$agent_lines"
    changed="strip→${agent_lines}L"
  fi
  if [[ "$hidden" == 1 && -n "$nvim" ]]; then
    tmux resize-pane -t "$nvim" -x 1
    changed="${changed:+$changed, }nvim→hidden"
  elif [[ -n "$tweb" ]]; then
    tmux resize-pane -t "$tweb" -x "$tw"
    changed="${changed:+$changed, }tweb→${tweb_pct}%"
  fi
  [[ -n "$changed" ]] || { echo "refresh: no panes to resize in $sess" >&2; exit 1; }
  echo "refresh: $sess — $changed"
  exit 0
}

# Hide/show nvim without zooming away the prompt strip. tmux panes cannot have
# zero width, so hidden mode collapses the editor to its one-column minimum.
cmd_nvim() {
  local action="${2:-toggle}" sess="${3:-}" hidden
  [[ -n "$sess" ]] || sess=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  [[ -n "$sess" ]] && tmux has-session -t "$sess" 2>/dev/null \
    || { echo "nvim: no workspace session" >&2; exit 1; }
  hidden=$(tmux show-options -v -t "$sess" @rtide-nvim-hidden 2>/dev/null || true)
  case "$action" in
    toggle) [[ "$hidden" == 1 ]] && hidden=0 || hidden=1 ;;
    hide) hidden=1 ;;
    show) hidden=0 ;;
    *) echo "usage: rtide nvim [toggle|hide|show] [session]" >&2; exit 1 ;;
  esac
  tmux set-option -t "$sess" @rtide-nvim-hidden "$hidden"
  cmd_refresh refresh "$sess"
}

# Open the workspace quick-switcher menu (prefix+A). Interactive items run in a
# display-popup so fzf pickers get a tty; the rest run directly via run-shell.
#   rtide menu [session]   (no arg → current session)
cmd_menu() {
  local sess="${2:-$(tmux display-message -p '#{session_name}' 2>/dev/null || true)}"
  [[ -n "$sess" ]] || { echo "menu: not in a tmux session — pass a session: rtide menu <session>" >&2; exit 1; }
  # Keep the menu inside the terminal-rendered left side. Centering it across
  # the full window can place half of it beneath tweb's graphical pane layer,
  # which visually clips the right side of the menu.
  tmux display-menu -T "#[align=centre] RTIDE actions" -x 2 -y C \
    "Switch workspace" r "display-popup -E -w 80% -h 70% 'rtide switch'" \
    "Change agent…"    m "display-popup -E -w 80% -h 70% 'rtide agent'" \
    "New workspace…"   n "display-popup -E -w 80% -h 70% 'rtide new'" \
    "" \
    "Refresh layout"   R "run-shell 'rtide refresh ${sess}'" \
    "Hide/show editor" e "run-shell 'rtide nvim toggle ${sess}'" \
    "Zoom tweb"        t "run-shell 'rtide zoom tweb'" \
    "Zoom agent"       a "run-shell 'rtide zoom agent'" \
    "Config…"          c "display-popup -E -w 70% -h 50% 'sh -c \"rtide config; echo; read -p done\"'" \
    "Output history"   h "run-shell 'rtide history ${sess}'" \
    "Sweep memories"   s "run-shell 'rtide sweep'" \
    "" \
    "Detach"           d "detach-client" \
    "Quit workspace"   q "confirm-before -p 'quit workspace? (y/n) ' \"run-shell 'rtide quit ${sess}'\""
  exit 0
}

cmd_history() {
  local sess="${2:-$(tmux display-message -p '#{session_name}' 2>/dev/null || true)}"
  local nvim tweb dir page
  [[ -n "$sess" ]] && tmux has-session -t "$sess" 2>/dev/null \
    || { echo "history: no workspace session" >&2; exit 1; }
  nvim=$(tmux list-panes -s -t "$sess" -F '#{pane_id} #{@rtide-role}' | awk '$2=="nvim"{print $1; exit}')
  tweb=$(tmux list-panes -s -t "$sess" -F '#{pane_id} #{@rtide-role}' | awk '$2=="tweb"{print $1; exit}')
  [[ -n "$nvim" && -n "$tweb" ]] || { echo "history: incomplete RTIDE layout in $sess" >&2; exit 1; }
  dir=$(tmux display-message -p -t "$nvim" '#{pane_current_path}')
  page="$dir/.tweb/history.html"
  [[ -f "$page" ]] || { echo "history: no completed outputs yet" >&2; exit 1; }
  tweb navigate --pane "$tweb" "file://$(realpath "$page")"
  tweb eval --pane "$tweb" "document.documentElement.style.zoom='${RTIDE_TWEB_ZOOM:-0.9}'; true" >/dev/null 2>&1 || true
  exit 0
}

# Bind a key in the prefix table only if it's not already bound (don't clobber)
bind_if_free() {
  local key="$1" cmd="$2"
  if ! tmux list-keys -T prefix 2>/dev/null \
    | awk -v k="$key" '$1=="bind-key" && $4==k {found=1} END {exit !found}'; then
    tmux bind-key "$key" "$cmd"
  fi
}

case "${1:-}" in
  setup)  setup_wizard; exit 0 ;;
  doctor) cmd_doctor; exit 0 ;;
  new)    cmd_new ;;
  switch) cmd_pick ;;
  zoom)   cmd_zoom "$@" ;;
  ls)     cmd_ls ;;
  sweep)  cmd_sweep ;;
  quit)   cmd_quit "$@" ;;
  kill)   cmd_quit "$@" ;;
  agent)  cmd_agent "$@" ;;
  auth)   cmd_auth "$@" ;;
  config) cmd_config "$@" ;;
  refresh) cmd_refresh "$@" ;;
  nvim)   cmd_nvim "$@" ;;
  menu)   cmd_menu "$@" ;;
  history) cmd_history "$@" ;;
  matrix) "$PROVIDER_BIN" matrix; exit 0 ;;
esac

# Load config (run wizard on first run)
[[ -f "$CONFIG" ]] || setup_wizard
source "$CONFIG"

# legacy: agent= → harness=
harness="${harness:-${agent:-}}"
agent_lines="${agent_lines:-3}"   # agent strip height in lines — minimal input box (status + prompt)
tweb_pct="${tweb_pct:-${nvim_pct:-60}}" # legacy nvim_pct actually controlled tweb width

# Bare `rtide` → pick an active workspace to resume, or start a new one.
if [[ -z "${1:-}" ]]; then
  cmd_pick
fi

DIR="${1:-${default_dir:-$(pwd)}}"
DIR="${DIR/#\~/$HOME}"       # expand a leading ~ (rtide new passes the dir as typed)
DIR="$(realpath -m "$DIR")"  # absolute — relative dirs otherwise break nvim --listen, session path, welcome page

mkdir -p "$DIR"   # create the workspace dir if it doesn't exist yet

# Seed per-project convention files (never clobber)
for f in AGENTS.md CLAUDE.md; do
  [[ -f "$DIR/$f" ]] || cp "$TWEB_DIR/AGENTS.md" "$DIR/$f"
done
mkdir -p "$DIR/.tweb"
[[ -f "$DIR/.tweb/template.html" ]] || cp "$TWEB_DIR/template.html" "$DIR/.tweb/template.html"
grep -q '^\.tweb/$' "$DIR/.gitignore" 2>/dev/null || echo '.tweb/' >> "$DIR/.gitignore"
# Seed project memory (committed, like AGENTS.md)
mkdir -p "$DIR/.rtide/memory"
[[ -f "$DIR/.rtide/memory/MEMORY.md" ]] || echo "# Memory index" > "$DIR/.rtide/memory/MEMORY.md"

S="rtide-$(basename "$DIR")"
if tmux has-session -t "$S" 2>/dev/null; then
  resume_session "$S" \
    || echo "could not open $S — attach with: tmux attach -t $S" >&2
  exit 0
fi

# Per-workspace override + always-ask selection (new workspace)
WS_AGENT="$DIR/$WS_AGENT_FILE"
[[ -f "$WS_AGENT" ]] && source "$WS_AGENT"
harness="${harness:-${agent:-}}"
if [[ "${RTIDE_ASK:-1}" != "0" ]]; then
  prompt_selection "${provider:-}" "${harness:-}" "${model:-}"
  provider="$PROVIDER"; harness="$HARNESS"; model="$MODEL"
  mkdir -p "$(dirname "$WS_AGENT")"
  cat > "$WS_AGENT" <<EOF
provider=$provider
harness=$harness
model=$model
EOF
fi

# Validate the combo before launching. A stale config (e.g. agent=claude +
# provider=openai from the original defaults) is auto-corrected rather than
# refusing to start.
if ! "$PROVIDER_BIN" compat "$provider" 2>/dev/null | grep -qw "$harness"; then
  fixed=$("$PROVIDER_BIN" compat_h "$harness" 2>/dev/null | awk '{print $1}')
  if [[ -n "$fixed" ]]; then
    echo "note: $harness is not compatible with $provider — using $fixed"
    provider="$fixed"
  else
    echo "error: $harness is not compatible with $provider (see 'rtide matrix')" >&2
    exit 1
  fi
fi

# The agent pane runs the minimal input-box wrapper (rtide-agent), which
# invokes the harness non-interactively per request and renders to tweb.
AGENT_CMD="rtide-agent $harness $provider $model $DIR"

# Build the layout with pane IDs (index-agnostic — respects base-index settings).
# Each pane gets a pane-scoped @rtide-role option (survives title changes by apps).
# Build at the receiving client's real size. Otherwise tmux creates the
# detached window at 80x24 and proportionally inflates a 3-line agent strip
# when a larger client attaches.
START_W=""
START_H=""
if [[ -n "${TMUX:-}" ]]; then
  START_W=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
  START_H=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)
fi
[[ "$START_W" =~ ^[0-9]+$ ]] || START_W=$(tput cols 2>/dev/null || echo 80)
[[ "$START_H" =~ ^[0-9]+$ ]] || START_H=$(tput lines 2>/dev/null || echo 24)
[[ "$START_W" =~ ^[0-9]+$ ]] || START_W=80
[[ "$START_H" =~ ^[0-9]+$ ]] || START_H=24
tmux set-option -g mouse on
tmux new-session -d -x "$START_W" -y "$START_H" -s "$S" -n work -c "$DIR"
NVIM_PANE=$(tmux list-panes -t "$S:work" -F '#{pane_id}' | head -1)
tmux set-option -p -t "$NVIM_PANE" @rtide-role nvim
tmux select-pane -t "$NVIM_PANE" -T nvim
tmux send-keys -t "$NVIM_PANE" "SHELL=$shell nvim --listen '$DIR/.rtide/nvim.sock'" Enter
tmux split-window -v -t "$NVIM_PANE" -l "$agent_lines" -c "$DIR"
AGENT_PANE=$(tmux display-message -p -t "$S:work" '#{pane_id}')   # new pane is active after split
tmux set-option -p -t "$AGENT_PANE" @rtide-role agent
tmux select-pane -t "$AGENT_PANE" -T agent
tmux split-window -h -t "$NVIM_PANE" -p "$tweb_pct" -c "$DIR"
TWEB_PANE=$(tmux display-message -p -t "$S:work" '#{pane_id}')
tmux set-option -p -t "$TWEB_PANE" @rtide-role tweb
tmux select-pane -t "$TWEB_PANE" -T tweb
# Stable routing for harness command runners that do not inherit TMUX_PANE.
printf '%s\n' "$TWEB_PANE" > "$DIR/.rtide/tweb-pane"
# generate the per-workspace welcome page, then open it in tweb
python3 - "$TWEB_DIR/welcome.html" "$DIR/.tweb/welcome.html" "$S" "$DIR" "$provider" "$harness" "$model" <<'PY'
import sys, datetime
tpl, out, ws, path, prov, harness, model = sys.argv[1:8]
html = open(tpl).read()
for k, v in [("{{WORKSPACE}}", ws), ("{{PATH}}", path), ("{{PROVIDER}}", prov),
             ("{{HARNESS}}", harness), ("{{MODEL}}", model),
             ("{{DATE}}", datetime.date.today().isoformat())]:
    html = html.replace(k, v)
open(out, "w").write(html)
PY
tmux send-keys -t "$TWEB_PANE" "tweb open file://$DIR/.tweb/welcome.html" Enter
tmux send-keys -t "$AGENT_PANE" "$AGENT_CMD" Enter

# Readiness barrier: wait for concrete signals from all three surfaces, then
# make one final geometry/focus pass after asynchronous startup has settled.
printf 'starting %s…\n' "$S"
READY_NVIM=0 READY_TWEB=0 READY_AGENT=0
READY_DEADLINE=$((SECONDS + 15))
while (( SECONDS < READY_DEADLINE )); do
  [[ -S "$DIR/.rtide/nvim.sock" ]] && READY_NVIM=1
  tweb status --pane "$TWEB_PANE" 2>/dev/null \
    | grep -Fq "file://$DIR/.tweb/welcome.html" && READY_TWEB=1 || true
  tmux capture-pane -p -t "$AGENT_PANE" -S -10 2>/dev/null \
    | grep -Fq '● idle' && READY_AGENT=1 || true
  (( READY_NVIM && READY_TWEB && READY_AGENT )) && break
  sleep 0.1
done

# Match subsequent tweb-render navigations: one content-size notch below the
# browser default while leaving tweb's device/pixel scaling untouched.
tweb eval --pane "$TWEB_PANE" \
  "document.documentElement.style.zoom='${RTIDE_TWEB_ZOOM:-0.9}'; true" >/dev/null 2>&1 || true

# Reassert the exact configured layout at the real client dimensions.
tmux resize-window -t "$S:work" -x "$START_W" -y "$START_H" 2>/dev/null || true
tmux resize-pane -t "$AGENT_PANE" -y "$agent_lines"
TWEB_W=$(( START_W * tweb_pct / 100 ))
(( TWEB_W < 10 )) && TWEB_W=10
tmux resize-pane -t "$TWEB_PANE" -x "$TWEB_W"
if ! (( READY_NVIM && READY_TWEB && READY_AGENT )); then
  printf 'warning: workspace opened before all surfaces became ready (nvim=%s tweb=%s agent=%s)\n' \
    "$READY_NVIM" "$READY_TWEB" "$READY_AGENT" >&2
fi
# Global bindings that resolve panes by title in the current session at press-time
bind_if_free t "run-shell 'rtide zoom tweb'"
bind_if_free a "run-shell 'rtide zoom agent'"
bind_if_free r "run-shell 'rtide switch'"
bind_if_free Q "confirm-before -p 'quit workspace? (y/n) ' \"run-shell 'rtide quit #{session_name}'\""
bind_if_free R "run-shell 'rtide refresh #{session_name}'"
bind_if_free A "run-shell 'rtide menu #{session_name}'"
bind_if_free e "run-shell 'rtide nvim toggle #{session_name}'"
install_session_hooks "$S"
tmux select-window -t "$S:work"
# A new workspace opens ready for the user's first request. Existing workspace
# resumes still return to the editor via resume_session().
tmux select-pane -t "$AGENT_PANE"
if [[ -z "${TMUX:-}" ]]; then
  tmux attach -t "$S" 2>/dev/null || echo "workspace $S created — attach with: tmux attach -t $S"
else
  tmux switch-client -t "$S" 2>/dev/null || echo "workspace $S created — attach with: tmux attach -t $S"
fi
