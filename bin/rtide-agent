</style></head><body><div class="shell"><nav class="topnav"><a href="../history.html">Browse output history</a></nav><header><div class="eyebrow">RTIDE · designed result</div><h1>{title}</h1><div class="meta"><span class="chip">{workspace}</span><span class="chip">{elapsed}s</span><span class="chip">{date}</span></div><details class="request"><summary>Request context</summary><div>{request}</div></details></header><main>{body}</main><footer>Generated in RTIDE · standalone result</footer></div></body></html>"""


def result_title(text, request=""):
    for line in text.splitlines():
        match = re.match(r"^#{1,3}\s+(.+)$", line.strip())
        if match:
            return match.group(1).strip("*` ")[:72]
    candidate = " ".join(request.split()).strip().rstrip("?.!")
    if candidate:
        return candidate[:56] + ("…" if len(candidate) > 56 else "")
    return "Result"


def build_result_html(request, response, workspace, elapsed):
    title = result_title(response, request)
    # If an explicit heading supplied the title, do not repeat it at the top
    # of the body immediately below the compact header.
    body_source = re.sub(r"^\s*#{1,3}\s+.+(?:\n|$)", "", response, count=1)
    return RESULT_PAGE.format(
        title=H.escape(title), workspace=H.escape(workspace),
        elapsed=f"{elapsed:.0f}", date=datetime.datetime.now().strftime("%b %d, %Y · %H:%M"),
        request=H.escape(request), body=md_to_html(body_source),
    )


HISTORY_PAGE = """<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Output history — {workspace}</title><style>
:root{{color-scheme:dark;--bg:#090d14;--panel:#121a27;--line:#29364b;--text:#edf3ff;--muted:#8ea0b8;--cyan:#5eead4;--blue:#6db5ff}}*{{box-sizing:border-box}}body{{margin:0;background:radial-gradient(circle at 10% 0,#152844,transparent 34rem),var(--bg);color:var(--text);font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}}main{{max-width:980px;margin:auto;padding:48px 24px 80px}}.eyebrow{{color:var(--cyan);font-size:.75rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}}h1{{font-size:clamp(2.2rem,5vw,4rem);letter-spacing:-.04em;margin:.35rem 0}}.intro{{color:var(--muted);max-width:650px;margin-bottom:30px}}.grid{{display:grid;gap:14px}}.card{{display:block;text-decoration:none;color:inherit;background:linear-gradient(135deg,#151f2e,#101722);border:1px solid var(--line);border-radius:16px;padding:20px;transition:.15s transform,.15s border-color}}.card:hover{{transform:translateY(-2px);border-color:#5274a0}}.meta{{display:flex;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:.76rem}}.kind{{color:var(--cyan)}}h2{{font-size:1.15rem;margin:.5rem 0 .3rem;color:#fff}}p{{color:#b8c5d7;margin:.3rem 0 0}}.empty{{padding:30px;border:1px dashed var(--line);border-radius:16px;color:var(--muted)}}
</style></head><body><main><div class="eyebrow">RTIDE · output archive</div><h1>Result history</h1><p class="intro">Each request opens as its own designed result. Use this index to revisit earlier responses and custom artifacts.</p><div class="grid">{cards}</div></main></body></html>"""


def load_history(path):
    try:
        with open(path) as f:
            value = json.load(f)
        return value if isinstance(value, list) else []
    except (OSError, ValueError):
        return []


def save_history(path, entries):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entries[-100:], f, indent=2)
    os.replace(tmp, path)


def build_history_html(entries, workspace):
    cards = []
    for entry in reversed(entries):
        summary = " ".join(entry.get("request", "").split())[:180]
        cards.append(
            f'<a class="card" href="{H.escape(entry.get("url", ""), quote=True)}">'
            f'<div class="meta"><span>{H.escape(entry.get("created", ""))}</span>'
            f'<span>·</span><span>{entry.get("elapsed", 0):.0f}s</span><span>·</span>'
            f'<span class="kind">{H.escape(entry.get("kind", "result"))}</span></div>'
            f'<h2>{H.escape(entry.get("title", "Result"))}</h2><p>{H.escape(summary)}</p></a>'
        )
    if not cards:
        cards.append('<div class="empty">No completed outputs yet.</div>')
    return HISTORY_PAGE.format(workspace=H.escape(workspace), cards="".join(cards))


def main():
    if len(sys.argv) < 5:
        print("usage: rtide-agent <harness> <provider> <model> <dir>", file=sys.stderr)
        sys.exit(1)
    harness, provider, model, wdir = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
    wdir = os.path.realpath(wdir)
    os.chdir(wdir)

    tweb_dir = os.path.join(wdir, ".tweb")
    os.makedirs(tweb_dir, exist_ok=True)
    results_dir = os.path.join(tweb_dir, "results")
    os.makedirs(results_dir, exist_ok=True)
    history_path = os.path.join(tweb_dir, "history.html")
    legacy_history_path = os.path.join(tweb_dir, "agent.html")
    session_file = os.path.join(wdir, ".rtide", "agent-session")
    history_data_path = os.path.join(wdir, ".rtide", "output-history.json")

    # resume a previous session for this harness, if any
    session_id = None
    if os.path.exists(session_file):
        saved = open(session_file).read().strip()
        if saved.startswith(harness + ":"):
            session_id = saved.split(":", 1)[1]

    workspace = os.path.basename(wdir)
    history = refresh_artifact_titles(load_history(history_data_path))
    # One-time migration from the former chat transcript. Preserve it as a
    # browsable historical artifact before agent.html becomes the new index.
    if not history and os.path.exists(legacy_history_path):
        try:
            with open(legacy_history_path) as f:
                legacy_html = f.read()
            if 'class="msg ' in legacy_html:
                legacy_copy = os.path.join(results_dir, "legacy-conversation.html")
                shutil.copy2(legacy_history_path, legacy_copy)
                history.append({
                    "request": "Browse responses created before standalone result pages",
                    "title": "Earlier conversation archive",
                    "url": "file://" + os.path.realpath(legacy_copy),
                    "elapsed": 0,
                    "created": datetime.datetime.now().strftime("%b %d, %Y · %H:%M"),
                    "kind": "legacy conversation",
                })
        except OSError:
            pass
    save_history(history_data_path, history)
    initial_history = build_history_html(history, workspace)
    for path in (history_path, legacy_history_path):
        with open(path, "w") as f:
            f.write(initial_history)

    clear()
    status(f"rtide-agent: {harness} + {provider} ({model})")
    idle_status()

    while True:
        try:
            req = input("> ")
        except (EOFError, KeyboardInterrupt):
            clear()
            status("bye")
            break
        req = req.strip()
        if not req:
            continue

        clear()
        working_status(elapsed=0)
        t0 = time.time()
        marker = render_marker_path()
        render_before = marker_version(marker)
        try:
            cmd = get_run_cmd(harness, provider, model, req, session_id)
            text, sid, rc = run_harness(cmd, harness, working_status)
        except Exception as e:
            clear()
            error_status(str(e))
            continue
        if sid:
            session_id = sid
            with open(session_file, "w") as f:
                f.write(f"{harness}:{sid}")
        dt = time.time() - t0

        response = text or f"(no output — exit {rc})"
        custom = artifact_rendered(marker, render_before)
        target = marker_target(marker) if custom else None
        result_path = None
        if not target:
            custom = False
            stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
            result_path = os.path.join(results_dir, f"result-{stamp}.html")
            with open(result_path, "w") as f:
                f.write(build_result_html(req, response, workspace, dt))
            target = "file://" + os.path.realpath(result_path)

        entry = {
            "request": req,
            "title": (artifact_title(target) if custom else None)
                     or result_title(response, req),
            "url": target,
            "elapsed": dt,
            "created": datetime.datetime.now().strftime("%b %d, %Y · %H:%M"),
            "kind": "custom artifact" if custom else "designed result",
        }
        history.append(entry)
        save_history(history_data_path, history)
        history_html = build_history_html(history, workspace)
        for path in (history_path, legacy_history_path):
            with open(path, "w") as f:
                f.write(history_html)

        loaded = show_and_verify(target, result_path)
        clear()
        if rc != 0:
            error_status(f"exit {rc}")
        elif not loaded:
            error_status("tweb could not verify the result page")
        else:
            done_status(dt)


if __name__ == "__main__":
    main()
