#!/usr/bin/env python3
"""rtide-agent — minimal agent input box for RTIDE.

Runs the configured harness non-interactively for each request, shows a
one-line status in the agent pane, and renders each response as a standalone
designed result with a separate history index in tweb. Files the agent creates/edits open in nvim via
`rtide-open` (see AGENTS.md).

Usage: rtide-agent <harness> <provider> <model> <dir>
"""
import html as H
import datetime
import json
import os
import re
import selectors
import shutil
import subprocess
import sys
import time
import urllib.parse

SELF_DIR = os.path.dirname(os.path.realpath(__file__))
PROVIDER_BIN = os.path.join(SELF_DIR, "rtide-provider")
TWEB_RENDER = os.path.join(SELF_DIR, "tweb-render")

GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
CYAN = "\033[36m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
DIM = "\033[2m"
RESET = "\033[0m"


def clear():
    # Erase the visible pane and its tmux scrollback so a submitted request
    # does not remain above the fresh prompt after the turn completes.
    pane = os.environ.get("TMUX_PANE", "")
    if pane:
        subprocess.run(
            ["tmux", "clear-history", "-t", pane],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    sys.stdout.write("\033[3J\033[2J\033[H")
    sys.stdout.flush()


def render_marker_path():
    """Return the workspace session's successful-render marker path."""
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return None
    result = subprocess.run(
        ["tmux", "display-message", "-p", "-t", pane, "#{session_name}"],
        capture_output=True, text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    key = re.sub(r"[^a-zA-Z0-9_.-]", "_", result.stdout.strip())
    return os.path.join(os.path.expanduser("~"), ".cache", "rtide", key, "last-render")


def marker_version(path):
    try:
        return os.stat(path).st_mtime_ns
    except (OSError, TypeError):
        return None


def artifact_rendered(path, before):
    """Whether a successful tweb render occurred since the turn began."""
    return marker_version(path) != before


def marker_target(path):
    try:
        with open(path) as f:
            return f.read().strip() or None
    except (OSError, TypeError):
        return None


def artifact_title(target):
    """Read a local custom artifact's authored document title."""
    try:
        parsed = urllib.parse.urlparse(target)
        if parsed.scheme != "file":
            return None
        path = urllib.parse.unquote(parsed.path)
        with open(path, encoding="utf-8") as f:
            head = f.read(262144)
        match = re.search(r"<title[^>]*>(.*?)</title>", head,
                          flags=re.IGNORECASE | re.DOTALL)
        if not match:
            return None
        title = re.sub(r"<[^>]+>", "", H.unescape(match.group(1)))
        return " ".join(title.split())[:120] or None
    except (OSError, UnicodeError, ValueError):
        return None


def refresh_artifact_titles(entries):
    """Repair legacy custom-history labels from each artifact's own title."""
    for entry in entries:
        if entry.get("kind") == "custom artifact":
            title = artifact_title(entry.get("url", ""))
            if title:
                entry["title"] = title
    return entries


def managed_tweb_pane():
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return None
    session = subprocess.run(
        ["tmux", "display-message", "-p", "-t", pane, "#{session_name}"],
        capture_output=True, text=True,
    )
    if session.returncode != 0:
        return None
    panes = subprocess.run(
        ["tmux", "list-panes", "-t", f"{session.stdout.strip()}:work",
         "-F", "#{pane_id} #{@rtide-role}"], capture_output=True, text=True,
    )
    matches = [line.split()[0] for line in panes.stdout.splitlines()
               if line.split()[1:] == ["tweb"]]
    return matches[0] if len(matches) == 1 else None


def current_tweb_url(pane):
    if not pane:
        return None
    result = subprocess.run(
        ["tweb", "status", "--pane", pane], capture_output=True, text=True,
    )
    try:
        data = json.loads(result.stdout)
        tabs = data["tabs"]["tabs"]
        return next(tab["url"] for tab in tabs if tab.get("active"))
    except (KeyError, TypeError, ValueError, StopIteration):
        return None


def show_and_verify(target, source_path=None):
    """Load target and verify tweb actually reports it, retrying if needed."""
    pane = managed_tweb_pane()
    for _ in range(3):
        if source_path:
            subprocess.run([TWEB_RENDER, source_path], capture_output=True)
        else:
            # Route every artifact through the shared renderer so page zoom and
            # persistent output navigation are applied to custom pages too.
            subprocess.run([TWEB_RENDER, "--url", target], capture_output=True)
        if current_tweb_url(pane) == target:
            return True
        time.sleep(0.15)
    return False


def status(msg):
    sys.stdout.write(msg + "\n")
    sys.stdout.flush()


def idle_status():
    status(f"{GREEN}●{RESET} idle — type a request (Ctrl-d to quit)")


def activity(event=None):
    """Return the agent-emitted activity text and a presentation color."""
    if not event:
        return "", CYAN
    raw = " ".join(str(event).split())
    if raw.startswith("@note "):
        return raw[6:], CYAN
    name = raw.partition(" ")[0].lower()
    if any(k in name for k in ("read", "grep", "glob", "find", "search", "fetch")):
        return raw, BLUE
    if any(k in name for k in ("edit", "write", "patch", "file_change", "notebook")):
        return raw, MAGENTA
    if any(k in name for k in ("bash", "exec", "command", "shell", "run")):
        return raw, YELLOW
    if any(k in name for k in ("render", "tweb", "browser", "screenshot")):
        return raw, MAGENTA
    return raw, CYAN


def working_status(tool=None, elapsed=0):
    detail, color = activity(tool)
    timer = f"{int(elapsed)}s"
    # ANSI sequences do not consume columns. Budget using only visible text,
    # and collapse tool arguments so a status can never wrap the 3-line pane.
    prefix = f"● working {timer}"
    width = shutil.get_terminal_size((80, 24)).columns
    room = max(0, width - len(prefix) - (3 if detail else 0))
    detail = detail[:room].rstrip()
    suffix = f" {DIM}·{RESET} {color}{detail}{RESET}" if detail else ""
    # Timer ticks and activity events replace the same physical line.
    sys.stdout.write(
        f"\r\033[2K{YELLOW}●{RESET} working {CYAN}{timer}{RESET}{suffix}"
    )
    sys.stdout.flush()


def done_status(secs):
    status(f"{GREEN}●{RESET} done ({secs:.0f}s)")


def error_status(msg):
    status(f"{RED}●{RESET} error: {msg[:100]}")


def get_run_cmd(harness, provider, model, prompt, session):
    """Ask rtide-provider for the non-interactive command for one request."""
    args = [PROVIDER_BIN, "run", harness, provider, model, prompt]
    if session:
        args.append(session)
    out = subprocess.run(args, capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip() or "rtide-provider run failed")
    return out.stdout.strip()


def parse_line(harness, line):
    """Return (text, session_id, tool) from one JSON event line."""
    try:
        obj = json.loads(line)
    except Exception:
        return None, None, None
    if harness == "claude":
        typ = obj.get("type")
        if typ == "system" and obj.get("subtype") == "init":
            return None, obj.get("session_id"), None
        if typ == "assistant":
            texts = []
            tool = None
            for c in obj.get("message", {}).get("content", []):
                if c.get("type") == "text":
                    texts.append(c.get("text", ""))
                if c.get("type") == "tool_use":
                    inp = c.get("input", {})
                    f = inp.get("file_path") or inp.get("path") or ""
                    if not f:
                        f = inp.get("command") or inp.get("query") or ""
                    tool = f"{c.get('name', '')} {f}".strip()
            return "".join(texts) or None, None, tool
        if typ == "result":
            return obj.get("result", ""), None, None
    elif harness == "codex":
        typ = obj.get("type")
        if typ == "thread.started":
            return None, obj.get("thread_id"), None
        if typ in ("item.started", "item.completed"):
            item = obj.get("item", {})
            itype = item.get("type")
            if itype == "agent_message":
                if typ == "item.completed":
                    return item.get("text", ""), None, None
                return None, None, None
            if itype == "function_call":
                name = item.get("name", "")
                args = item.get("arguments", "")
                return None, None, f"{name} {args[:40]}".strip()
            if itype == "command_execution":
                return None, None, f"command {item.get('command', '')}".strip()
            if itype == "file_change":
                changes = item.get("changes", [])
                paths = [c.get("path", "") for c in changes if isinstance(c, dict)]
                return None, None, f"file_change {' '.join(filter(None, paths))}".strip()
            if itype == "mcp_tool_call":
                name = item.get("tool") or item.get("name") or "tool"
                return None, None, str(name)
            if itype == "web_search":
                return None, None, f"web_search {item.get('query', '')}".strip()
            if itype == "reasoning":
                note = item.get("text") or item.get("summary") or ""
                if note:
                    return None, None, f"@note {note}"
        if typ == "turn.failed":
            err = obj.get("error", {})
            msg = err.get("message", "") if isinstance(err, dict) else str(err)
            return f"(error: {msg})", None, None
    return None, None, None


def run_harness(cmd, harness, on_tool):
    """Run the harness command, streaming events. Returns (text, session_id, rc)."""
    text_parts = []
    raw_parts = []
    session_id = None
    proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True,
                            stdin=subprocess.DEVNULL)
    stream = selectors.DefaultSelector()
    stream.register(proc.stdout, selectors.EVENT_READ)
    started = time.monotonic()
    current_activity = None
    while True:
        events = stream.select(timeout=0.2)
        if events:
            line = proc.stdout.readline()
            if line == "":
                break
            line = line.strip()
            if not line:
                continue
            raw_parts.append(line)
            t, sid, tool = parse_line(harness, line)
            if t:
                text_parts.append(t)
                # Agent narration is the best dynamic description available.
                summary = " ".join(t.splitlines()[0].split()).strip("#*` ")
                if summary:
                    current_activity = f"@note {summary}"
            if sid:
                session_id = sid
            if tool:
                current_activity = tool
        on_tool(current_activity, time.monotonic() - started)
        if proc.poll() is not None and not events:
            break
    stream.close()
    proc.wait()
    rc = proc.returncode
    text = "".join(text_parts).strip()
    if not text:
        # plain-text harness (hermes/opencode) or parse gap: use raw output
        text = "\n".join(raw_parts).strip()
    return text, session_id, rc


def inline_md(text):
    text = H.escape(text)
    def image(match):
        alt, url = match.group(1), match.group(2).strip()
        raw = H.unescape(url).lower()
        if re.match(r"^[a-z][a-z0-9+.-]*:", raw) and not raw.startswith(("http://", "https://", "file://", "data:image/")):
            return f"<em>[image: {alt}]</em>"
        return f'<img src="{url}" alt="{alt}" loading="lazy">'

    def link(match):
        label, url = match.group(1), match.group(2).strip()
        raw = H.unescape(url).lower()
        if re.match(r"^[a-z][a-z0-9+.-]*:", raw) and not raw.startswith(("http://", "https://", "file://")):
            return label
        return f'<a href="{url}">{label}</a>'

    text = re.sub(r'!\[([^]]*)\]\(([^)]+)\)', image, text)
    text = re.sub(r'\[([^]]+)\]\(([^)]+)\)', link, text)
    text = re.sub(r'`([^`]+)`', r'<code>\1</code>', text)
    text = re.sub(r'\*\*([^*]+)\*\*', r'<strong>\1</strong>', text)
    text = re.sub(r'\*([^*]+)\*', r'<em>\1</em>', text)
    return text


def md_to_html(text):
    """Small dependency-free Markdown renderer for designed result pages."""
    out, lines = [], text.splitlines()
    in_code = False
    list_kind = None

    def close_list():
        nonlocal list_kind
        if list_kind:
            out.append(f"</{list_kind}>")
            list_kind = None

    i = 0
    while i < len(lines):
        line, stripped = lines[i], lines[i].strip()
        if stripped.startswith("```"):
            close_list()
            out.append("</code></pre>" if in_code else "<pre><code>")
            in_code = not in_code
            i += 1
            continue
        if in_code:
            out.append(H.escape(line))
            i += 1
            continue
        # GitHub-style pipe tables.
        if ("|" in line and i + 1 < len(lines)
                and re.match(r"^\s*\|?\s*:?-{3,}", lines[i + 1])):
            close_list()
            headers = [inline_md(x.strip()) for x in line.strip().strip("|").split("|")]
            i += 2
            rows = []
            while i < len(lines) and "|" in lines[i] and lines[i].strip():
                rows.append([inline_md(x.strip()) for x in lines[i].strip().strip("|").split("|")])
                i += 1
            out.append("<div class=table-wrap><table><thead><tr>" + "".join(f"<th>{x}</th>" for x in headers) + "</tr></thead><tbody>")
            for row in rows:
                out.append("<tr>" + "".join(f"<td>{x}</td>" for x in row) + "</tr>")
            out.append("</tbody></table></div>")
            continue
        s = inline_md(line)
        if stripped.startswith("### "):
            close_list(); out.append(f"<h3>{inline_md(stripped[4:])}</h3>")
        elif stripped.startswith("## "):
            close_list(); out.append(f"<h2>{inline_md(stripped[3:])}</h2>")
        elif stripped.startswith("# "):
            close_list(); out.append(f"<h2>{inline_md(stripped[2:])}</h2>")
        elif re.match(r"^[-*] ", stripped):
            if list_kind != "ul": close_list(); list_kind = "ul"; out.append("<ul>")
            out.append(f"<li>{inline_md(stripped[2:])}</li>")
        elif re.match(r"^\d+\. ", stripped):
            if list_kind != "ol": close_list(); list_kind = "ol"; out.append("<ol>")
            out.append(f"<li>{inline_md(re.sub(r'^\d+\. ', '', stripped))}</li>")
        elif stripped.startswith("> "):
            close_list(); out.append(f"<blockquote>{inline_md(stripped[2:])}</blockquote>")
        elif not stripped:
            close_list()
        else:
            close_list(); out.append(f"<p>{s}</p>")
        i += 1
    close_list()
    if in_code:
        out.append("</code></pre>")
    return "\n".join(out)


RESULT_PAGE = """<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} — {workspace}</title>
