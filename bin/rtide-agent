</style></head><body><main><header><div><div class="eyebrow">RTIDE · output archive</div><h1>Output history</h1></div><div class="tools"><div class="filters"><button class="active" data-filter="all">All</button><button data-filter="artifact">Artifacts</button><button data-filter="response">Responses</button></div><div class="counts" id="counts">{count} outputs · {artifact_count} artifacts</div></div></header><div class="list">{cards}</div></main><script>const cards=[...document.querySelectorAll('.card')];const buttons=[...document.querySelectorAll('[data-filter]')];buttons.forEach(b=>b.onclick=()=>{{buttons.forEach(x=>x.classList.toggle('active',x===b));cards.forEach(c=>c.hidden=b.dataset.filter!=='all'&&c.dataset.kind!==b.dataset.filter);const shown=cards.filter(c=>!c.hidden).length;document.getElementById('counts').textContent=shown+' shown · '+cards.length+' total}});</script></body></html>"""

