def build_viewer_html(entries):
    items = [{"url": e.get("url", ""), "title": e.get("title", "Output"),
              "kind": "artifact" if e.get("kind") == "custom artifact" else "response"}
             for e in entries if e.get("url")]
    payload = json.dumps(items, ensure_ascii=False).replace("<", "\\u003c")
    page = VIEWER_PAGE.format(items=payload)
    print_css = ("<style>@media print{*{-webkit-print-color-adjust:exact!important;"
                 "print-color-adjust:exact!important}nav{display:none!important}"
                 "body{display:block!important;background:#090d14!important}"
                 "iframe{position:fixed;inset:0;width:100%;height:100%;border:0}}"
                 "</style>")
    return page.replace("</head>", print_css + "</head>")


def load_history(path):
    try:
        with open(path) as f:
            value = json.load(f)
        return value if isinstance(value, list) else []
    except (OSError, ValueError):
        return []


def save_history(path, entries):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entries[-100:], f, indent=2)
    os.replace(tmp, path)


def build_history_html(entries, workspace, mode="all"):
    cards = []
    visible = [entry for entry in entries if mode == "all" or
               (mode == "artifact") == (entry.get("kind") == "custom artifact")]
    for entry in reversed(visible):
        summary = " ".join(entry.get("request", "").split())[:110]
        kind = entry.get("kind", "result")
        is_artifact = kind == "custom artifact"
        card_class = "card artifact" if is_artifact else "card"
        icon = "◆" if is_artifact else "↗"
        target = entry.get("url", "")
        parsed = urllib.parse.urlparse(target)
        if parsed.scheme == "file" and "/.tweb/" in parsed.path:
            root = target.split("/.tweb/", 1)[0]
            href = root + "/.tweb/viewer.html?src=" + urllib.parse.quote(target, safe="")
        else:
            href = target
        cards.append(
            f'<a class="{card_class}" data-kind="{"artifact" if is_artifact else "response"}" href="{H.escape(href, quote=True)}">'
            f'<span class="icon" aria-hidden="true">{icon}</span><div class="copy">'
            f'<h2>{H.escape(entry.get("title", "Result"))}</h2>'
            f'<p>{H.escape(summary)}</p></div><div class="side">'
            f'<div class="meta">{H.escape(entry.get("created", ""))} · '
            f'{entry.get("elapsed", 0):.0f}s</div>'
            f'<span class="kind">{H.escape(kind)}</span></div></a>'
        )
    if not cards:
        cards.append('<div class="empty">No completed outputs yet.</div>')
    artifact_count = sum(e.get("kind") == "custom artifact" for e in entries)
    return HISTORY_PAGE.format(
        workspace=H.escape(workspace), cards="".join(cards),
        count=len(entries), artifact_count=artifact_count,
        shown_count=len(visible),
        all_active="active" if mode == "all" else "",
        artifact_active="active" if mode == "artifact" else "",
        response_active="active" if mode == "response" else "",
    )


def write_history_pages(tweb_dir, entries, workspace):
    for name, mode in (("history.html", "all"),
                       ("history-artifacts.html", "artifact"),
                       ("history-responses.html", "response"),
                       ("agent.html", "all")):
        with open(os.path.join(tweb_dir, name), "w") as f:
            f.write(build_history_html(entries, workspace, mode))


def main():
    if len(sys.argv) < 5:
        print("usage: rtide-agent <harness> <provider> <model> <dir>", file=sys.stderr)
        sys.exit(1)
    harness, provider, model, wdir = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
    wdir = os.path.realpath(wdir)
    os.chdir(wdir)

    tweb_dir = os.path.join(wdir, ".tweb")
    os.makedirs(tweb_dir, exist_ok=True)
    results_dir = os.path.join(tweb_dir, "results")
    os.makedirs(results_dir, exist_ok=True)
    history_path = os.path.join(tweb_dir, "history.html")
    viewer_path = os.path.join(tweb_dir, "viewer.html")
    legacy_history_path = os.path.join(tweb_dir, "agent.html")
    session_file = os.path.join(wdir, ".rtide", "agent-session")
    history_data_path = os.path.join(wdir, ".rtide", "output-history.json")

    # resume a previous session for this harness, if any
    session_id = None
    if os.path.exists(session_file):
        saved = open(session_file).read().strip()
        if saved.startswith(harness + ":"):
            session_id = saved.split(":", 1)[1]

    workspace = os.path.basename(wdir)
    history = refresh_artifact_titles(load_history(history_data_path))
    # One-time migration from the former chat transcript. Preserve it as a
    # browsable historical artifact before agent.html becomes the new index.
    if not history and os.path.exists(legacy_history_path):
        try:
            with open(legacy_history_path) as f:
                legacy_html = f.read()
            if 'class="msg ' in legacy_html:
                legacy_copy = os.path.join(results_dir, "legacy-conversation.html")
                shutil.copy2(legacy_history_path, legacy_copy)
                history.append({
                    "request": "Browse responses created before standalone result pages",
                    "title": "Earlier conversation archive",
                    "url": "file://" + os.path.realpath(legacy_copy),
                    "elapsed": 0,
                    "created": datetime.datetime.now().strftime("%b %d, %Y · %H:%M"),
                    "kind": "legacy conversation",
                })
        except OSError:
            pass
    save_history(history_data_path, history)
    with open(viewer_path, "w") as f:
        f.write(build_viewer_html(history))
    write_history_pages(tweb_dir, history, workspace)

    clear()
    status(f"rtide-agent: {harness} + {provider} ({model})")
    idle_status()

    pending = []
    last_request = ""
    while True:
        if pending:
            req = pending.pop(0)
        else:
            try:
                req = input(PROMPT)
            except (EOFError, KeyboardInterrupt):
                clear()
                status("bye")
                break
        req = req.strip()
        if not req:
            continue
        if req == "/help":
            status("plain text queues while working · /steer TEXT · /interrupt · /resend · /queue")
            continue
        if req == "/queue":
            status(f"queue: {len(pending)}")
            continue
        if req == "/interrupt":
            status("interrupt: no active turn")
            continue
        if req == "/resend":
            if not last_request:
                status("resend: no previous message")
                continue
            req = last_request
        elif req.startswith("/steer "):
            req = req[7:].strip()
            if not req:
                continue

        clear()
        working_status(elapsed=0, queued=len(pending), reset_prompt=True)
        t0 = time.time()
        marker = render_marker_path()
        render_before = marker_version(marker)
        last_request = req
        try:
            cmd = get_run_cmd(harness, provider, model, req, session_id)
            text, sid, rc, newly_queued, steer, interrupted = run_harness(
                cmd, harness, working_status, last_request, len(pending)
            )
        except Exception as e:
            clear()
            error_status(str(e))
            continue
        if sid:
            session_id = sid
            with open(session_file, "w") as f:
                f.write(f"{harness}:{sid}")
        pending.extend(newly_queued)
        if steer:
            pending.insert(0, steer)
        if steer or interrupted:
            clear()
            if steer:
                status(f"{MAGENTA}●{RESET} steering · q{len(pending)}")
            else:
                status(f"{YELLOW}●{RESET} interrupted · q{len(pending)}")
            continue
        dt = time.time() - t0

        response = text or f"(no output — exit {rc})"
        custom = artifact_rendered(marker, render_before)
        target = marker_target(marker) if custom else None
        result_path = None
        if not target:
            custom = False
            stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
            result_path = os.path.join(results_dir, f"result-{stamp}.html")
            with open(result_path, "w") as f:
                f.write(build_result_html(req, response, workspace, dt))
            target = "file://" + os.path.realpath(result_path)

        entry = {
            "request": req,
            "title": (artifact_title(target) if custom else None)
                     or result_title(response, req),
            "url": target,
            "elapsed": dt,
            "created": datetime.datetime.now().strftime("%b %d, %Y · %H:%M"),
            "kind": "custom artifact" if custom else "designed result",
        }
        history.append(entry)
        save_history(history_data_path, history)
        write_history_pages(tweb_dir, history, workspace)
        with open(viewer_path, "w") as f:
            f.write(build_viewer_html(history))

        loaded = show_and_verify(target, result_path)
        clear()
        if rc != 0:
            error_status(f"exit {rc}")
        elif not loaded:
            error_status("tweb could not verify the result page")
        else:
            done_status(dt)


if __name__ == "__main__":
    main()
