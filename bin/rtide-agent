in:.4rem 0;padding-left:.25rem}}li::marker{{color:var(--cyan)}}code{{font: .9em ui-monospace,SFMono-Regular,Menlo,monospace;background:#080d14;border:1px solid #253247;border-radius:6px;padding:.12rem .38rem;color:#b9ddff}}pre{{background:#080d14;border:1px solid #26344a;border-radius:14px;padding:18px;overflow:auto;box-shadow:inset 0 1px #ffffff08}}pre code{{border:0;padding:0;background:none}}blockquote{{margin:1.2rem 0;padding:16px 18px;border-left:3px solid var(--blue);background:#111c2a;border-radius:0 12px 12px 0;color:#c9d6e8}}.table-wrap{{overflow:auto;border:1px solid var(--line);border-radius:14px;margin:1.3rem 0}}table{{border-collapse:collapse;width:100%;min-width:520px}}th{{text-align:left;background:#192538;color:var(--cyan);font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}}th,td{{padding:12px 14px;border-bottom:1px solid var(--line)}}tr:last-child td{{border-bottom:0}}tbody tr:nth-child(even){{background:#ffffff04}}footer{{text-align:center;color:#65758b;font-size:.78rem;margin-top:18px}}@media(max-width:600px){{body{{font-size:15px}}header,main{{border-radius:14px}}}}
</style></head><body><div class="shell"><nav class="topnav"><a href="../history.html">Browse output history</a></nav><header><div class="eyebrow">RTIDE · designed result</div>{title_block}<div class="meta"><span class="chip">{workspace}</span><span class="chip">{elapsed}s</span><span class="chip">{date}</span></div><details class="request"><summary>Request context</summary><div>{request}</div></details></header><main>{body}</main><footer>Generated in RTIDE · standalone result</footer></div></body></html>"""


def result_title(text, request=""):
    for line in text.splitlines():
        match = re.match(r"^#{1,3}\s+(.+)$", line.strip())
        if match:
            return match.group(1).strip("*` ")[:72]
    candidate = " ".join(request.split()).strip().rstrip("?.!")
    if candidate:
        return candidate[:56] + ("…" if len(candidate) > 56 else "")
    return "Result"


def build_result_html(request, response, workspace, elapsed):
    match = next((re.match(r"^#{1,3}\s+(.+)$", line.strip())
                  for line in response.splitlines()
                  if re.match(r"^#{1,3}\s+(.+)$", line.strip())), None)
    authored_title = match.group(1).strip("*` ")[:72] if match else ""
    # If an explicit heading supplied the title, do not repeat it at the top
    # of the body immediately below the compact header.
    body_source = re.sub(r"^\s*#{1,3}\s+.+(?:\n|$)", "", response, count=1)
    page = RESULT_PAGE.format(
        title=H.escape(authored_title or "Result"),
        title_block=(f"<h1>{H.escape(authored_title)}</h1>" if authored_title else ""),
        workspace=H.escape(workspace),
        elapsed=f"{elapsed:.0f}", date=datetime.datetime.now().strftime("%b %d, %Y · %H:%M"),
        request=H.escape(request), body=md_to_html(body_source),
    )
    print_css = ("<style>@media print{*{-webkit-print-color-adjust:exact!important;"
                 "print-color-adjust:exact!important}.topnav{display:none!important}"
                 "body{background:var(--bg)!important}.shell{max-width:none;padding:0}"
                 "header,main{box-shadow:none}}</style>")
    return page.replace("</head>", print_css + "</head>")


HISTORY_PAGE = """<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Output history — {workspace}</title><style>
