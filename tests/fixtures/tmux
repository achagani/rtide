#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  display-message)
    if [[ "${*: -1}" == '#{@rtide-role}' ]]; then
      printf '%s\n' "${FAKE_ROLE:-tweb}"
    elif [[ "${*: -1}" == '#{window_id}' ]]; then
      printf '%s\n' "${FAKE_WINDOW:-@1}"
    else
      printf '%s\n' "${FAKE_SESSION:-rtide-test}"
    fi
    ;;
  list-panes)
    printf '%b' "${FAKE_PANES:-%1 nvim\n%2 agent\n%3 tweb\n}"
    ;;
  list-windows)
    printf '%s\n' "${FAKE_WINDOWS:-@1 rtide-test}"
    ;;
  split-window)
    printf '%%99\n'
    ;;
  set-option|select-pane|run-shell|refresh-client|capture-pane|resize-pane|resize-window|send-keys|set-hook|set-environment|rename-window|switch-client)
    :
    ;;
  *)
    printf 'unexpected tmux call: %q' "$1" >&2
    exit 64
    ;;
esac
