#!/usr/bin/env python3
"""Increment RTIDE's source-controlled semantic version."""

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
VERSION_FILE = ROOT / "VERSION"
PART = sys.argv[1] if len(sys.argv) == 2 else "patch"

if PART not in {"major", "minor", "patch"}:
    raise SystemExit("usage: scripts/bump-version [major|minor|patch]")

current = VERSION_FILE.read_text(encoding="utf-8").strip()
match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)", current)
if not match:
    raise SystemExit(f"invalid VERSION: {current!r}")

major, minor, patch = map(int, match.groups())
if PART == "major":
    major, minor, patch = major + 1, 0, 0
elif PART == "minor":
    minor, patch = minor + 1, 0
else:
    patch += 1

updated = f"{major}.{minor}.{patch}"
VERSION_FILE.write_text(updated + "\n", encoding="utf-8")
print(f"{current} -> {updated}")
