#!/usr/bin/env bash
# Install the host packages RTIDE can provision portably.
set -euo pipefail

missing=()
for command in git tmux nvim fish fzf python3 cargo pkg-config; do
  command -v "$command" >/dev/null 2>&1 || missing+=("$command")
done
if ! command -v kitty >/dev/null 2>&1 && ! command -v ghostty >/dev/null 2>&1; then
  missing+=(kitty-or-ghostty)
fi
if ! command -v pw-record >/dev/null 2>&1 && ! command -v arecord >/dev/null 2>&1 && ! command -v rec >/dev/null 2>&1; then
  missing+=(audio-recorder)
fi

# TWeb's Linux build needs the development metadata, not just the pkg-config
# executable. A previous early exit treated pkg-config as sufficient and let
# the later Cargo build fail with missing pango/atk/GTK libraries.
if [[ "$(uname -s)" == Linux ]] && command -v pkg-config >/dev/null 2>&1; then
  for capability in atk gtk+-3.0 pango webkit2gtk-4.1; do
    pkg-config --exists "$capability" || missing+=("pkgconfig:$capability")
  done
fi
if [[ ${#missing[@]} -eq 0 ]]; then
  echo '   supported host dependencies already present'
  exit 0
fi

manager=''
for candidate in apt-get dnf brew pacman zypper; do
  if command -v "$candidate" >/dev/null 2>&1; then manager="$candidate"; break; fi
done
[[ -n "$manager" ]] || {
  echo "   no supported package manager found; missing: ${missing[*]}" >&2
  exit 1
}

packages=()
case "$manager" in
  apt-get) packages=(git tmux neovim fish fzf python3 python3-pip python3-venv cargo pkg-config pipewire pipewire-audio alsa-utils kitty sox libatk1.0-dev libgtk-3-dev libglib2.0-dev libgdk-pixbuf-2.0-dev libcairo2-dev libpango1.0-dev libwebkit2gtk-4.1-dev libxkbcommon-dev) ;;
  dnf) packages=(git tmux neovim fish fzf python3 python3-pip python3-virtualenv cargo pkgconf-pkg-config pipewire-utils alsa-utils kitty sox atk-devel gtk3-devel glib2-devel gdk-pixbuf2-devel cairo-devel pango-devel webkit2gtk4.1-devel libxkbcommon-devel) ;;
  brew) packages=(git tmux neovim fish fzf python rust pkg-config kitty sox gtk+3 webkitgtk cairo pango atk) ;;
  pacman) packages=(git tmux neovim fish fzf python python-pip rust pkgconf pipewire pipewire-audio alsa-utils kitty sox atk gtk3 glib2 gdk-pixbuf2 cairo pango webkit2gtk libxkbcommon) ;;
  zypper) packages=(git tmux neovim fish fzf python3 python3-pip python3-virtualenv cargo pkg-config pipewire alsa-utils kitty sox atk-devel gtk3-devel glib2-devel gdk-pixbuf-devel cairo-devel pango-devel webkit2gtk3-devel libxkbcommon-devel) ;;
esac
echo "   installing supported host dependencies with $manager: ${missing[*]}"
if [[ "$manager" == brew ]]; then
  brew install "${packages[@]}"
else
  runner=()
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    command -v sudo >/dev/null 2>&1 || { echo '   sudo is required to install host packages' >&2; exit 1; }
    runner=(sudo)
  fi
  "${runner[@]}" "$manager" install -y "${packages[@]}"
fi
