#!/usr/bin/env bash
# Install the host packages RTIDE can provision portably.
set -euo pipefail

missing=()
for command in git tmux nvim fish fzf python3 cargo; do
  command -v "$command" >/dev/null 2>&1 || missing+=("$command")
done
if ! command -v kitty >/dev/null 2>&1 && ! command -v ghostty >/dev/null 2>&1; then
  missing+=(kitty-or-ghostty)
fi
if ! command -v pw-record >/dev/null 2>&1 && ! command -v arecord >/dev/null 2>&1 && ! command -v rec >/dev/null 2>&1; then
  missing+=(audio-recorder)
fi
if [[ ${#missing[@]} -eq 0 ]]; then
  echo '   supported host dependencies already present'
  exit 0
fi

manager=''
for candidate in apt-get dnf brew pacman zypper; do
  if command -v "$candidate" >/dev/null 2>&1; then manager="$candidate"; break; fi
done
[[ -n "$manager" ]] || {
  echo "   no supported package manager found; missing: ${missing[*]}" >&2
  exit 1
}

packages=()
case "$manager" in
  apt-get) packages=(git tmux neovim fish fzf python3 python3-pip python3-venv cargo pipewire pipewire-audio alsa-utils kitty sox) ;;
  dnf) packages=(git tmux neovim fish fzf python3 python3-pip python3-virtualenv cargo pipewire-utils alsa-utils kitty sox) ;;
  brew) packages=(git tmux neovim fish fzf python rust kitty sox) ;;
  pacman) packages=(git tmux neovim fish fzf python python-pip rust pipewire pipewire-audio alsa-utils kitty sox) ;;
  zypper) packages=(git tmux neovim fish fzf python3 python3-pip python3-virtualenv cargo pipewire alsa-utils kitty sox) ;;
esac
echo "   installing supported host dependencies with $manager: ${missing[*]}"
if [[ "$manager" == brew ]]; then
  brew install "${packages[@]}"
else
  runner=()
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    command -v sudo >/dev/null 2>&1 || { echo '   sudo is required to install host packages' >&2; exit 1; }
    runner=(sudo)
  fi
  "${runner[@]}" "$manager" install -y "${packages[@]}"
fi
