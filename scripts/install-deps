#!/usr/bin/env bash
# Install the host packages RTIDE can provision portably.
#
# Package selection comes from the one canonical dependency matrix in
# libexec/rtide/deps, so installation and `rtide doctor` cannot disagree about
# what is required, build-time, or optional.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
DEPS="$ROOT/libexec/rtide/deps"

manager=$("$DEPS" manager)
missing=$("$DEPS" check 2>/dev/null | awk -F '\t' '$1=="MISSING"{print $4}' || true)
if [[ -z "$missing" ]]; then
  echo '   supported host dependencies already present'
  exit 0
fi
[[ -n "$manager" ]] || {
  echo "   no supported package manager found; missing: $(tr '\n' ' ' <<< "$missing")" >&2
  exit 1
}

mapfile -t packages < <("$DEPS" missing-packages "$manager")
[[ ${#packages[@]} -gt 0 ]] || {
  echo "   no installable host packages for: $(tr '\n' ' ' <<< "$missing")" >&2
  exit 1
}
echo "   installing supported host dependencies with $manager: $(tr '\n' ' ' <<< "$missing")"
if [[ "$manager" == brew ]]; then
  brew install "${packages[@]}"
else
  runner=()
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    command -v sudo >/dev/null 2>&1 || { echo '   sudo is required to install host packages' >&2; exit 1; }
    runner=(sudo)
  fi
  "${runner[@]}" "$manager" install -y "${packages[@]}"
fi
